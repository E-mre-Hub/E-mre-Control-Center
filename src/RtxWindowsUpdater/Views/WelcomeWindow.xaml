<Window x:Class="RtxWindowsUpdater.Views.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:RtxWindowsUpdater.Views"
        Title="E-mre Control Center"
        Icon="pack://application:,,,/Assets/E-mreLogo.ico"
        Width="680" Height="640"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="{DynamicResource B.Bg0}"
        FontFamily="{StaticResource F.Text}"
        Foreground="{DynamicResource B.Text}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <!-- İlk açılış (v2.0.0): dil ve görünüm seçimi. Dil henüz ayarlanmadığı için metinler WelcomeViewModel'den gelir (seçime göre
         anında değişir); tema seçimi canlı önizlenir. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SetupResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Seçim kartı (RadioButton): seçiliyken neon kenarlık + seçili zemin -->
            <Style x:Key="ChoiceCard" TargetType="RadioButton">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="bd" CornerRadius="14" BorderThickness="1.5" Padding="16,14"
                                    Background="{DynamicResource B.Control}" BorderBrush="{DynamicResource B.Border}">
                                <Grid>
                                    <ContentPresenter />
                                    <Border x:Name="check" Width="22" Height="22" CornerRadius="11" HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Background="{DynamicResource B.NeonGradient}" Visibility="Collapsed">
                                        <TextBlock Text="&#xE73E;" Style="{StaticResource T.Icon}" FontSize="11" Foreground="{DynamicResource B.OnAccent}" />
                                    </Border>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource B.CardBorderHover}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource B.Neon}" />
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource B.SelectedFill}" />
                                    <Setter TargetName="check" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource B.Neon}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ChoiceBadge" TargetType="Border">
                <Setter Property="Width" Value="44" />
                <Setter Property="Height" Value="44" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="{DynamicResource B.TileBorder}" />
                <Setter Property="Background" Value="{DynamicResource B.TileBg}" />
                <Setter Property="Margin" Value="0,0,14,0" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{DynamicResource B.WindowBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <views:WaveBackdrop Grid.RowSpan="2" LineBrush="{DynamicResource B.WaveLine}" LineCount="30" IsHitTestVisible="False">
            <views:WaveBackdrop.CacheMode>
                <BitmapCache />
            </views:WaveBackdrop.CacheMode>
        </views:WaveBackdrop>

        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <Button x:Name="CloseButton" Style="{StaticResource Btn.CaptionClose}" Content="&#xE8BB;" Click="Close_Click"
                        ToolTip="{Binding CloseTip}" AutomationProperties.Name="{Binding CloseTip}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                <Rectangle Width="18" Height="18" RadiusX="4" RadiusY="4" Fill="{StaticResource LogoBrush}" />
                <TextBlock Text="E-mre Control Center" FontSize="12.5" Foreground="{DynamicResource B.Text2}" Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </DockPanel>

        <StackPanel Grid.Row="1" Width="540" VerticalAlignment="Center" Margin="0,0,0,26">
            <ContentControl Template="{StaticResource LogoGlow}" Focusable="False" />
            <TextBlock x:Name="HeadingText" Text="{Binding Heading}" FontFamily="{StaticResource F.Display}" FontSize="28" HorizontalAlignment="Center"
                       Foreground="{DynamicResource B.Text}" Margin="0,4,0,4" />
            <TextBlock Text="{Binding Subheading}" FontSize="13.5" Foreground="{DynamicResource B.Text2}" HorizontalAlignment="Center" />

            <TextBlock Text="{Binding LanguageLabel}" Style="{StaticResource T.Label}" Margin="2,24,0,8" />
            <UniformGrid Columns="2">
                <RadioButton x:Name="TurkishChoice" Style="{StaticResource ChoiceCard}" GroupName="Language" Margin="0,0,6,0"
                             IsChecked="{Binding IsTurkish}" AutomationProperties.Name="Türkçe">
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource ChoiceBadge}">
                            <TextBlock Text="TR" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource B.Neon}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Türkçe" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding TurkishHint}" FontSize="12" Foreground="{DynamicResource B.Text3}" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="EnglishChoice" Style="{StaticResource ChoiceCard}" GroupName="Language" Margin="6,0,0,0"
                             IsChecked="{Binding IsEnglish}" AutomationProperties.Name="English">
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource ChoiceBadge}">
                            <TextBlock Text="EN" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource B.Neon}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="English" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding EnglishHint}" FontSize="12" Foreground="{DynamicResource B.Text3}" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>
                </RadioButton>
            </UniformGrid>

            <TextBlock Text="{Binding ThemeLabel}" Style="{StaticResource T.Label}" Margin="2,20,0,8" />
            <UniformGrid Columns="2">
                <RadioButton x:Name="DarkChoice" Style="{StaticResource ChoiceCard}" GroupName="Theme" Margin="0,0,6,0"
                             IsChecked="{Binding IsDark}" AutomationProperties.Name="{Binding DarkTitle}">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="44" Height="44" CornerRadius="12" Margin="0,0,14,0" BorderThickness="1" BorderBrush="#FF24365C">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FF0C1528" Offset="0" />
                                    <GradientStop Color="#FF020307" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="&#xE708;" Style="{StaticResource T.Icon}" FontSize="17" Foreground="#FF4CCBFF" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding DarkTitle}" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding DarkHint}" FontSize="12" Foreground="{DynamicResource B.Text3}" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="LightChoice" Style="{StaticResource ChoiceCard}" GroupName="Theme" Margin="6,0,0,0"
                             IsChecked="{Binding IsLight}" AutomationProperties.Name="{Binding LightTitle}">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="44" Height="44" CornerRadius="12" Margin="0,0,14,0" BorderThickness="1" BorderBrush="#FFC2CEDE">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FFFFFFFF" Offset="0" />
                                    <GradientStop Color="#FFE6ECF4" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="&#xE706;" Style="{StaticResource T.Icon}" FontSize="18" Foreground="#FFC86A00" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding LightTitle}" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding LightHint}" FontSize="12" Foreground="{DynamicResource B.Text3}" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>
                </RadioButton>
            </UniformGrid>

            <Button x:Name="ContinueButton" Style="{StaticResource Btn.Primary}" Margin="0,26,0,0" Command="{Binding ContinueCommand}" IsDefault="True"
                    AutomationProperties.Name="{Binding ContinueText}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding ContinueText}" />
                    <TextBlock Text="&#xE72A;" Style="{StaticResource T.Icon}" FontSize="14" Margin="12,1,0,0" />
                </StackPanel>
            </Button>
            <TextBlock Text="{Binding Note}" FontSize="11.5" Foreground="{DynamicResource B.Text3}" HorizontalAlignment="Center" Margin="0,12,0,0" />
        </StackPanel>
    </Grid>
</Window>
