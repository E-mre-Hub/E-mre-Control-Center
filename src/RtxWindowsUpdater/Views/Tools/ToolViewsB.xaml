    <!-- ================================================================== Batarya -->
    <DataTemplate DataType="{x:Type tools:BatteryViewModel}">
        <!-- Kart düzeni: içerik (başlık dahil) en fazla 1136 px, sola yaslı (mevcut bölmelerle aynı) -->
        <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MaxWidth="1136" />
        </Grid.ColumnDefinitions>
        <Grid Margin="8,0,8,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ToolHeader}" Focusable="False" />
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                <StackPanel>
                    <Grid Margin="0,0,0,14" Visibility="{Binding NoBattery, Converter={StaticResource Visible}}">
                        <Border Style="{StaticResource CardShadowLayer}" />
                        <Border Style="{StaticResource Card.Flat}" Padding="20,18">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE83F;" Style="{StaticResource T.Icon}" FontSize="22" Foreground="{StaticResource B.Text3}" Margin="0,0,14,0" />
                                <TextBlock Text="{Binding NoBatteryText}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <TextBlock Text="{Binding PowerText}" FontSize="13" Foreground="{StaticResource B.Text2}" Margin="2,0,0,12" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding Batteries}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type diag:BatteryInfo}">
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource IconTile}">
                                        <TextBlock Text="&#xE83F;" Style="{StaticResource T.TileIcon}" />
                                    </Border>
                                    <Grid Grid.Column="1">
                                        <Border Style="{StaticResource CardShadowLayer}" />
                                        <Border Style="{StaticResource Card.Flat}" Padding="20,16,20,6">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="Batarya" Style="{StaticResource T.H2}" FontSize="16" />
                                                        <TextBlock FontSize="12" Foreground="{StaticResource B.Text3}" Margin="0,3,0,0" TextWrapping="Wrap">
                                                            <Run Text="Windows adı:" />
                                                            <Run Text="{Binding Name, Mode=OneWay}" />
                                                            <Run Text="{Binding Manufacturer, Mode=OneWay}" />
                                                            <Run Text="{Binding Chemistry, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding ChargeText}" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource B.NeonBright}" />
                                                </Grid>
                                                <UniformGrid Columns="3">
                                                    <StackPanel Margin="0,0,12,0">
                                                        <TextBlock Text="Durum" Style="{StaticResource Tool.FieldLabel}" />
                                                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource Tool.FieldValue}" />
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,12,0">
                                                        <TextBlock Text="Kalan kapasite" Style="{StaticResource Tool.FieldLabel}" />
                                                        <TextBlock Text="{Binding RemainingText}" Style="{StaticResource Tool.FieldValue}" />
                                                    </StackPanel>
                                                    <StackPanel>
                                                        <TextBlock Text="Şarj / deşarj hızı" Style="{StaticResource Tool.FieldLabel}" />
                                                        <TextBlock Text="{Binding RateText}" Style="{StaticResource Tool.FieldValue}" />
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,12,0">
                                                        <TextBlock Text="Tam şarj kapasitesi" Style="{StaticResource Tool.FieldLabel}" />
                                                        <TextBlock Text="{Binding FullText}" Style="{StaticResource Tool.FieldValue}" />
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,12,0">
                                                        <TextBlock Text="Tasarım kapasitesi" Style="{StaticResource Tool.FieldLabel}" />
                                                        <TextBlock Text="{Binding DesignText}" Style="{StaticResource Tool.FieldValue}" />
                                                    </StackPanel>
                                                    <StackPanel>
                                                        <TextBlock Text="Döngü sayısı" Style="{StaticResource Tool.FieldLabel}" />
                                                        <TextBlock Text="{Binding CycleText}" Style="{StaticResource Tool.FieldValue}" />
                                                    </StackPanel>
                                                </UniformGrid>
                                                <TextBlock Text="Sağlık (tam şarj ÷ tasarım kapasitesi)" Style="{StaticResource Tool.FieldLabel}" />
                                                <TextBlock Text="{Binding HealthText}" Style="{StaticResource Tool.FieldValue}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding Note}" Style="{StaticResource T.SettingDesc}" Margin="2,0,0,0" Visibility="{Binding HasNote, Converter={StaticResource Visible}}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
        </Grid>
    </DataTemplate>

    <!-- ================================================================== Tek Tıkla Tanıla -->
    <DataTemplate DataType="{x:Type tools:DiagnoseViewModel}">
        <!-- Kart düzeni: içerik (başlık dahil) en fazla 1136 px, sola yaslı (mevcut bölmelerle aynı) -->
        <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MaxWidth="1136" />
        </Grid.ColumnDefinitions>
        <Grid Margin="8,0,8,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ToolHeader}" Focusable="False" />
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Border Style="{StaticResource CardShadowLayer}" />
                        <Border Style="{StaticResource Card.Flat}" Padding="20,16">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Tek Tıkla Tanıla" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource T.SettingDesc}" Margin="0,4,0,0"
                                                   Text="Sistem gereksinimleri, Windows sağlığı, sürücüler, ağ, DNS, depolama, güvenlik, olay günlüğü, çökme geçmişi ve anlık performans sırayla ve gerçekten kontrol edilir. Dosya silme, sürücü kurma, hizmet durdurma, kayıt / DNS değişikliği YAPILMAZ. İlerleme yüzde değil, adım durumu olarak gösterilir." />
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource Btn.Primary}" Height="44" Padding="18,0" Margin="16,0,0,0"
                                            Command="{Binding StartCommand}" VerticalAlignment="Center" AutomationProperties.Name="Tanılamayı başlat">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE9D9;" Style="{StaticResource T.Icon}" FontSize="15" Margin="0,0,10,0" />
                                            <TextBlock Text="Tanılamayı başlat" FontSize="14" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <WrapPanel Margin="0,14,0,0" Visibility="{Binding HasCounts, Converter={StaticResource Visible}}">
                                    <Border CornerRadius="11" Padding="12,4" Margin="0,0,8,0" Background="#14FFFFFF">
                                        <TextBlock FontSize="12.5"><Run Text="Toplam " Foreground="{StaticResource B.Text3}" /><Run Text="{Binding Total, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
                                    </Border>
                                    <Border CornerRadius="11" Padding="12,4" Margin="0,0,8,0" Background="#1A2BD67B">
                                        <TextBlock FontSize="12.5" Foreground="{StaticResource B.Green}"><Run Text="Başarılı " /><Run Text="{Binding Passed, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
                                    </Border>
                                    <Border CornerRadius="11" Padding="12,4" Margin="0,0,8,0" Background="#1AFFA63D">
                                        <TextBlock FontSize="12.5" Foreground="{StaticResource B.Orange}"><Run Text="Uyarı " /><Run Text="{Binding Warnings, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
                                    </Border>
                                    <Border CornerRadius="11" Padding="12,4" Margin="0,0,8,0" Background="#1AFF4D61">
                                        <TextBlock FontSize="12.5" Foreground="{StaticResource B.Red}"><Run Text="Hata " /><Run Text="{Binding Errors, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
                                    </Border>
                                    <Border CornerRadius="11" Padding="12,4" Margin="0,0,8,0" Background="#14FFFFFF">
                                        <TextBlock FontSize="12.5" Foreground="{StaticResource B.Text2}"><Run Text="Atlanan " /><Run Text="{Binding SkippedCount, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
                                    </Border>
                                    <Border CornerRadius="11" Padding="12,4" Background="#14FFFFFF" Visibility="{Binding Unknown, Converter={StaticResource Visible}}">
                                        <TextBlock FontSize="12.5" Foreground="{StaticResource B.Text2}"><Run Text="Kontrol edilemedi " /><Run Text="{Binding Unknown, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
                                    </Border>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Steps}" Focusable="False" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
        </Grid>
    </DataTemplate>

    <!-- ================================================================== Başlangıç Uygulamaları -->
    <DataTemplate DataType="{x:Type tools:StartupViewModel}">
        <Grid Margin="8,0,8,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ToolHeader}" Focusable="False" />
            <Grid Grid.Row="1">
                <Border Style="{StaticResource CardShadowLayer}" />
                <Border Style="{StaticResource Card.Flat}" Padding="10,12,10,8">
                    <DataGrid Style="{StaticResource Grid.Tool}" ItemsSource="{Binding Entries}" SelectedItem="{Binding Selected}" AutomationProperties.Name="Başlangıç kayıtları">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="AD" Width="2.5*" SortMemberPath="Name">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type diag:StartupEntry}">
                                        <DockPanel>
                                            <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{StaticResource B.Gray}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Enabled}" Value="True">
                                                                <Setter Property="Fill" Value="{StaticResource B.Green}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource T.Cell}" />
                                        </DockPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="DURUM" Binding="{Binding StateText}" Width="80" ElementStyle="{StaticResource T.Cell}" />
                            <DataGridTextColumn Header="YAYINCI" Binding="{Binding PublisherText}" Width="2*" ElementStyle="{StaticResource T.Cell}" />
                            <DataGridTextColumn Header="KAYNAK" Binding="{Binding SourceText}" Width="2.5*" ElementStyle="{StaticResource T.Cell}" />
                            <DataGridTextColumn Header="KONUM" Binding="{Binding LocationText}" Width="3*" ElementStyle="{StaticResource T.Cell}" />
