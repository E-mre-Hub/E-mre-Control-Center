<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:tools="clr-namespace:RtxWindowsUpdater.ViewModels.Tools"
                    xmlns:diag="clr-namespace:RtxWindowsUpdater.Services.Diagnostics"
                    xmlns:views="clr-namespace:RtxWindowsUpdater.Views">
    <!-- Araç ekranları (v1.8.0): Sürücüler, Uygulamalar, Depolama Analizi, Gizlilik, Batarya ve Sistem Araçları
         (Tek Tıkla Tanıla, Başlangıç, Servisler, İşlemler, Güvenlik, Sistem Raporu, Destek Paketi). Ortak parçalar ToolViewsA.xaml'da. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ToolViewsA.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <views:EqualsToVisibilityConverter x:Key="ToolViewVisible" />

    <!-- Tablo altındaki seçim / işlem şeridi -->
    <Style x:Key="Tool.ActionBar" TargetType="Border" BasedOn="{StaticResource Card.Flat}">
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="Margin" Value="0,10,0,0" />
    </Style>

    <!-- ================================================================== Sürücüler -->
    <DataTemplate DataType="{x:Type tools:DriversViewModel}">
        <Grid Margin="8,0,8,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ToolHeader}" Focusable="False" />
            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MaxWidth="340" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton Style="{StaticResource Chip}" GroupName="DrvFilter" Content="Önemli aygıtlar"
                                 IsChecked="{Binding Filter, Converter={StaticResource EqualsParam}, ConverterParameter=important}" />
                    <RadioButton Style="{StaticResource Chip}" GroupName="DrvFilter" Content="Sorunlu"
                                 IsChecked="{Binding Filter, Converter={StaticResource EqualsParam}, ConverterParameter=problems}" />
                    <RadioButton Style="{StaticResource Chip}" GroupName="DrvFilter" Content="Tümü" Margin="0,0,14,0"
                                 IsChecked="{Binding Filter, Converter={StaticResource EqualsParam}, ConverterParameter=all}" />
                </StackPanel>
                <TextBox Grid.Column="1" Style="{StaticResource Input.Search}" Tag="Aygıt, üretici veya kategori ara"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Sürücülerde ara" />
            </Grid>
            <Grid Grid.Row="2">
                <Border Style="{StaticResource CardShadowLayer}" />
                <Border Style="{StaticResource Card.Flat}" Padding="10,12,10,8">
                    <DataGrid Style="{StaticResource Grid.Tool}" ItemsSource="{Binding DriversView}" AutomationProperties.Name="Sürücüler">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="AYGIT" Width="3*" SortMemberPath="DeviceName">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type diag:DriverInfo}">
                                        <DockPanel>
                                            <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"
                                                     Fill="{Binding State, Converter={StaticResource StatusBrush}}" />
                                            <TextBlock Text="{Binding DeviceName}" Style="{StaticResource T.Cell}" />
                                        </DockPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="KATEGORİ" Binding="{Binding Category}" Width="1.4*" ElementStyle="{StaticResource T.Cell}" />
                            <DataGridTextColumn Header="ÜRETİCİ" Binding="{Binding Manufacturer}" Width="1.4*" ElementStyle="{StaticResource T.Cell}" />
                            <DataGridTextColumn Header="SÜRÜM" Binding="{Binding Version}" Width="1.3*" ElementStyle="{StaticResource T.Cell}" />
                            <DataGridTextColumn Header="TARİH" Binding="{Binding DateText}" Width="86" SortMemberPath="Date" ElementStyle="{StaticResource T.Cell}" />
                            <DataGridTextColumn Header="İMZA" Binding="{Binding SignedText}" Width="70" ElementStyle="{StaticResource T.Cell}" />
                            <DataGridTextColumn Header="DURUM" Binding="{Binding StatusText}" Width="2*" ElementStyle="{StaticResource T.Cell}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>
            <Border Grid.Row="3" Style="{StaticResource Tool.ActionBar}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding UpdateStatus}" FontSize="12.5" TextWrapping="Wrap" Foreground="{StaticResource B.Text2}" VerticalAlignment="Center" />
                        <WrapPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <Button Style="{StaticResource Btn.Secondary}" Height="34" Padding="12,0" Margin="0,0,8,0" Command="{Binding SearchUpdatesCommand}"
                                    ToolTip="Yalnızca arama yapılır: Windows Update'in resmî sürücü kataloğu (Microsoft). Hiçbir sürücü kurulmaz.">
                                <TextBlock Text="Windows Update'te sürücü ara" FontSize="12.5" />
                            </Button>
                            <Button Style="{StaticResource Btn.Ghost}" Height="34" Padding="12,0" Margin="0,0,8,0" Command="{Binding OpenOptionalUpdatesCommand}"
                                    ToolTip="Windows Ayarlar → Windows Update → Gelişmiş seçenekler → İsteğe bağlı güncellemeler">
                                <TextBlock Text="İsteğe bağlı güncellemeler" FontSize="12.5" />
                            </Button>
                            <Button Style="{StaticResource Btn.Ghost}" Height="34" Padding="12,0" Command="{Binding OpenNvidiaCommand}"
                                    ToolTip="NVIDIA ekran sürücüsü mevcut NVIDIA Driver kartıyla (NVIDIA'nın resmî servisi) denetlenir.">
                                <TextBlock Text="NVIDIA kartı" FontSize="12.5" />
                            </Button>
                        </WrapPanel>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Updates}" Margin="0,8,0,0" Visibility="{Binding HasUpdates, Converter={StaticResource Visible}}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type diag:DriverUpdate}">
                                <TextBlock FontSize="12.5" Margin="0,2" TextWrapping="Wrap">
                                    <Run Text="•" Foreground="{StaticResource B.Orange}" />
                                    <Run Text="{Binding Title, Mode=OneWay}" />
                                    <Run Text="{Binding Manufacturer, Mode=OneWay}" Foreground="{StaticResource B.Text3}" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </DataTemplate>

    <!-- ================================================================== Uygulamalar -->
    <DataTemplate DataType="{x:Type tools:AppsViewModel}">
        <Grid Margin="8,0,8,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ToolHeader}" Focusable="False" />
            <Border Grid.Row="1" Style="{StaticResource Card.Flat}" Padding="16,10" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding WingetStatus}" FontSize="12.5" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding WingetHint}" Style="{StaticResource T.SettingDesc}" Margin="0,2,0,0" />
                    </StackPanel>
                    <WrapPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <Button Style="{StaticResource Btn.Secondary}" Height="34" Padding="12,0" Margin="0,0,8,0" Command="{Binding CheckWingetCommand}">
                            <TextBlock Text="Winget ile güncelleme denetle" FontSize="12.5" />
                        </Button>
                        <Button Style="{StaticResource Btn.Ghost}" Height="34" Padding="12,0" Margin="0,0,8,0" Command="{Binding OpenUpdatesCommand}">
                            <TextBlock Text="Güncellemeler" FontSize="12.5" />
                        </Button>
                        <Button Style="{StaticResource Btn.Ghost}" Height="34" Padding="12,0" Command="{Binding UninstallCommand}"
                                ToolTip="Kaldırma Windows'un kendi Uygulamalar sayfasında yapılır; bu uygulama sessizce kaldırma yapmaz.">
                            <TextBlock Text="Kaldır…" FontSize="12.5" />
                        </Button>
                    </WrapPanel>
                </Grid>
            </Border>
            <Grid Grid.Row="2" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MaxWidth="340" />
                </Grid.ColumnDefinitions>
                <WrapPanel VerticalAlignment="Center">
                    <RadioButton Style="{StaticResource Chip}" GroupName="AppSrc" Content="Tümü"
                                 IsChecked="{Binding SourceFilter, Converter={StaticResource EqualsParam}, ConverterParameter=all}" />
                    <RadioButton Style="{StaticResource Chip}" GroupName="AppSrc" Content="Masaüstü"
                                 IsChecked="{Binding SourceFilter, Converter={StaticResource EqualsParam}, ConverterParameter=desktop}" />
                    <RadioButton Style="{StaticResource Chip}" GroupName="AppSrc" Content="Microsoft Store"
                                 IsChecked="{Binding SourceFilter, Converter={StaticResource EqualsParam}, ConverterParameter=store}" />
                    <RadioButton Style="{StaticResource Chip}" GroupName="AppSrc" Content="Güncellemesi olan" Margin="0,0,14,0"
                                 IsChecked="{Binding SourceFilter, Converter={StaticResource EqualsParam}, ConverterParameter=updates}" />
                </WrapPanel>
                <TextBox Grid.Column="1" Style="{StaticResource Input.Search}" Tag="Uygulama veya yayıncı ara"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Uygulamalarda ara" />
            </Grid>
            <Grid Grid.Row="3">
                <Border Style="{StaticResource CardShadowLayer}" />
                <Border Style="{StaticResource Card.Flat}" Padding="10,12,10,8">
                    <DataGrid Style="{StaticResource Grid.Tool}" ItemsSource="{Binding AppsView}" AutomationProperties.Name="Kurulu uygulamalar">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="UYGULAMA" Binding="{Binding Name}" Width="3*" ElementStyle="{StaticResource T.Cell}" />
                            <DataGridTextColumn Header="YAYINCI" Binding="{Binding Publisher}" Width="2*" ElementStyle="{StaticResource T.Cell}" />
                            <DataGridTextColumn Header="SÜRÜM" Binding="{Binding Version}" Width="1.3*" ElementStyle="{StaticResource T.Cell}" />
                            <DataGridTemplateColumn Header="GÜNCELLEME" Width="1.5*" SortMemberPath="UpdateText">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type tools:AppRowViewModel}">
                                        <TextBlock Text="{Binding UpdateText}" Style="{StaticResource T.Cell}" Foreground="{StaticResource B.Orange}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="KURULUM" Binding="{Binding InstallDate}" Width="86" ElementStyle="{StaticResource T.Cell}" />
                            <DataGridTextColumn Header="BOYUT" Binding="{Binding Size}" Width="80" ElementStyle="{StaticResource T.Cell}" />
                            <DataGridTextColumn Header="KAYNAK" Binding="{Binding Source}" Width="1.5*" ElementStyle="{StaticResource T.Cell}" />
                            <DataGridTemplateColumn Header="KONUM" Width="2*" SortMemberPath="Location">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type tools:AppRowViewModel}">
                                        <Button Style="{StaticResource Btn.Link}" FontSize="12" HorizontalAlignment="Left" Padding="0"
                                                Command="{Binding DataContext.OpenLocationCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" ToolTip="{Binding Location}">
                                            <TextBlock Text="{Binding Location}" TextTrimming="CharacterEllipsis" />
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>
        </Grid>
    </DataTemplate>

    <!-- ================================================================== Depolama Analizi -->
    <DataTemplate DataType="{x:Type tools:StorageAnalysisViewModel}">
        <Grid Margin="8,0,8,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ToolHeader}" Focusable="False" />
            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Border Style="{StaticResource CardShadowLayer}" />
                <Border Style="{StaticResource Card.Flat}" Padding="20,14">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <WrapPanel VerticalAlignment="Center">
                                <TextBlock Text="Konum:" FontSize="12" Foreground="{StaticResource B.Text3}" VerticalAlignment="Center" Margin="0,0,8,6" />
                                <ItemsControl ItemsSource="{Binding Roots}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type tools:RootOption}">
                                            <RadioButton Style="{StaticResource Chip}" GroupName="AnalysisRoot" Margin="0,0,6,6" Content="{Binding Path}"
                                                         IsChecked="{Binding IsSelected}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Style="{StaticResource Btn.Link}" FontSize="12.5" Margin="0,0,0,6" Command="{Binding PickFolderCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8DA;" Style="{StaticResource T.Icon}" FontSize="12" Margin="0,0,7,0" />
                                        <TextBlock Text="Klasör seç…" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                            <Button Grid.Column="1" Style="{StaticResource Btn.Primary}" Height="40" Padding="16,0" Margin="16,0,0,0"
                                    Command="{Binding ScanCommand}" VerticalAlignment="Center" AutomationProperties.Name="Taramayı başlat">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE721;" Style="{StaticResource T.Icon}" FontSize="14" Margin="0,0,9,0" />
                                    <TextBlock Text="Tara" FontSize="13" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <TextBlock Text="{Binding ProgressText}" FontSize="12" Foreground="{StaticResource B.Text2}" TextTrimming="CharacterEllipsis"
                                   Margin="0,6,0,0" Visibility="{Binding ProgressText, Converter={StaticResource Visible}}" />
                        <TextBlock Text="{Binding SummaryText}" FontSize="13.5" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Visibility="{Binding HasResult, Converter={StaticResource Visible}}" />
                        <TextBlock Text="{Binding VolumeText}" Style="{StaticResource T.SettingDesc}" Margin="0,4,0,0"
                                   Visibility="{Binding VolumeText, Converter={StaticResource Visible}}" />
                        <TextBlock Style="{StaticResource T.SettingDesc}" Margin="0,6,0,0"
                                   Text="Dosya sayısı ve boyutlar gerçek taramadan gelir (yüzde tahmini yok). Bağlantılar (junction) izlenmez, erişilemeyen klasörler sayılıp atlanır. Hiçbir dosya kendiliğinden silinmez." />
                    </StackPanel>
                </Border>
            </Grid>
            <WrapPanel Grid.Row="2" Margin="0,0,0,10" Visibility="{Binding HasResult, Converter={StaticResource Visible}}">
                <RadioButton Style="{StaticResource Chip}" GroupName="AnalysisView" Content="En büyük dosyalar"
                             IsChecked="{Binding View, Converter={StaticResource EqualsParam}, ConverterParameter=files}" />
                <RadioButton Style="{StaticResource Chip}" GroupName="AnalysisView" Content="En büyük klasörler"
                             IsChecked="{Binding View, Converter={StaticResource EqualsParam}, ConverterParameter=folders}" />
                <RadioButton Style="{StaticResource Chip}" GroupName="AnalysisView" Content="Dosya türleri"
                             IsChecked="{Binding View, Converter={StaticResource EqualsParam}, ConverterParameter=types}" />
            </WrapPanel>
            <Grid Grid.Row="3" Visibility="{Binding HasResult, Converter={StaticResource Visible}}">
                <Border Style="{StaticResource CardShadowLayer}" />
                <Border Style="{StaticResource Card.Flat}" Padding="10,12,10,8">
                    <Grid>
                        <DataGrid Style="{StaticResource Grid.Tool}" ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}"
                                  Visibility="{Binding View, Converter={StaticResource ToolViewVisible}, ConverterParameter=files}"
                                  AutomationProperties.Name="En büyük dosyalar">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="DOSYA" Binding="{Binding Name}" Width="2*" ElementStyle="{StaticResource T.Cell}" />
                                <DataGridTextColumn Header="BOYUT" Binding="{Binding SizeText}" Width="90" SortMemberPath="Size" ElementStyle="{StaticResource T.Cell}" />
                                <DataGridTextColumn Header="DEĞİŞTİRİLME" Binding="{Binding ModifiedText}" Width="100" SortMemberPath="Modified" ElementStyle="{StaticResource T.Cell}" />
                                <DataGridTextColumn Header="KONUM" Binding="{Binding Folder}" Width="3*" ElementStyle="{StaticResource T.Cell}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <DataGrid Style="{StaticResource Grid.Tool}" ItemsSource="{Binding Folders}"
                                  Visibility="{Binding View, Converter={StaticResource ToolViewVisible}, ConverterParameter=folders}"
                                  AutomationProperties.Name="En büyük klasörler">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="KLASÖR" Binding="{Binding Path}" Width="4*" ElementStyle="{StaticResource T.Cell}" />
                                <DataGridTextColumn Header="BOYUT" Binding="{Binding SizeText}" Width="90" SortMemberPath="Size" ElementStyle="{StaticResource T.Cell}" />
                                <DataGridTextColumn Header="DOSYA SAYISI" Binding="{Binding Files, StringFormat=N0}" Width="110" SortMemberPath="Files" ElementStyle="{StaticResource T.Cell}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <DataGrid Style="{StaticResource Grid.Tool}" ItemsSource="{Binding Types}"
                                  Visibility="{Binding View, Converter={StaticResource ToolViewVisible}, ConverterParameter=types}"
                                  AutomationProperties.Name="Dosya türleri">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="TÜR" Binding="{Binding Extension}" Width="2*" ElementStyle="{StaticResource T.Cell}" />
                                <DataGridTextColumn Header="BOYUT" Binding="{Binding SizeText}" Width="100" SortMemberPath="Size" ElementStyle="{StaticResource T.Cell}" />
                                <DataGridTextColumn Header="DOSYA" Binding="{Binding Count, StringFormat=N0}" Width="100" SortMemberPath="Count" ElementStyle="{StaticResource T.Cell}" />
                                <DataGridTemplateColumn Header="PAY" Width="3*" SortMemberPath="Percent">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type diag:TypeEntry}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="56" />
                                                </Grid.ColumnDefinitions>
                                                <ProgressBar Style="{StaticResource Progress.Neon}" Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding Percent, StringFormat='%{0:0.0}'}" HorizontalAlignment="Right" />
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
            <Border Grid.Row="4" Style="{StaticResource Tool.ActionBar}" Visibility="{Binding HasResult, Converter={StaticResource Visible}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock FontSize="12.5" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{StaticResource B.Text2}"
                               Text="Bir dosya seçin: konumunu Gezgin'de açabilir veya onayınızla Geri Dönüşüm Kutusu'na gönderebilirsiniz (Windows sistem / program klasörleri korunur)." />
                    <WrapPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <Button Style="{StaticResource Btn.Ghost}" Height="34" Padding="12,0" Margin="0,0,8,0" Command="{Binding ShowFileCommand}">
                            <TextBlock Text="Konumu aç" FontSize="12.5" />
                        </Button>
                        <Button Style="{StaticResource Btn.Secondary}" Height="34" Padding="12,0" Command="{Binding RecycleCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74D;" Style="{StaticResource T.Icon}" FontSize="12" Margin="0,0,8,0" Foreground="{StaticResource B.Orange}" />
                                <TextBlock Text="Geri Dönüşüm Kutusu'na gönder…" FontSize="12.5" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </Grid>
            </Border>
        </Grid>
    </DataTemplate>

    <!-- ================================================================== Gizlilik -->
    <DataTemplate DataType="{x:Type tools:PrivacyViewModel}">
        <!-- Kart düzeni: içerik (başlık dahil) en fazla 1136 px, sola yaslı (mevcut bölmelerle aynı) -->
        <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MaxWidth="1136" />
        </Grid.ColumnDefinitions>
        <Grid Margin="8,0,8,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ToolHeader}" Focusable="False" />
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Border Style="{StaticResource CardShadowLayer}" />
                        <Border Style="{StaticResource Card.Flat}" Padding="20,14,20,8">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="Uygulama izinleri ve Windows gizlilik ayarları" Style="{StaticResource Tool.Section}" Margin="0" VerticalAlignment="Center" />
                                    <Button Style="{StaticResource Btn.Link}" HorizontalAlignment="Right" FontSize="12.5" Command="{Binding OpenPrivacyCommand}">
                                        <TextBlock Text="Windows gizlilik ayarları" />
                                    </Button>
                                </Grid>
                                <TextBlock Style="{StaticResource T.SettingDesc}" Margin="0,0,0,10"
                                           Text="Değerler Windows'un kayıt defterindeki gerçek ayarlardır (Ayarlar → Gizlilik ve güvenlik ile aynı). Bu uygulama hiçbir gizlilik ayarını değiştirmez; değişiklik için ilgili Windows Ayarlar sayfası açılır." />
                                <ItemsControl ItemsSource="{Binding Settings}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type diag:PrivacySetting}">
                                            <Border BorderBrush="{StaticResource B.Border}" BorderThickness="0,0,0,1" Padding="0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="2*" />
                                                        <ColumnDefinition Width="3*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                                                        <TextBlock Text="{Binding Value}" FontSize="12.5" TextWrapping="Wrap">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{StaticResource B.Text2}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding State}" Value="Warning">
                                                                            <Setter Property="Foreground" Value="{StaticResource B.Orange}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource T.SettingDesc}" Visibility="{Binding Detail, Converter={StaticResource Visible}}" />
                                                    </StackPanel>
                                                    <Button Grid.Column="2" Style="{StaticResource Btn.Link}" FontSize="12" VerticalAlignment="Center"
                                                            Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" AutomationProperties.Name="{Binding Title}">
                                                        <TextBlock Text="Ayarı aç" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Grid>
                        <Border Style="{StaticResource CardShadowLayer}" />
                        <Border Style="{StaticResource Card.Flat}" Padding="20,14,20,10">
                            <StackPanel>
                                <TextBlock Text="Kamera, mikrofon ve konuma son erişen uygulamalar" Style="{StaticResource Tool.Section}" />
                                <TextBlock Text="Windows'un kendi kullanım kaydı (bu kullanıcı). Kayıt yoksa liste boştur." Style="{StaticResource T.SettingDesc}" Margin="0,0,0,8" />
                                <ItemsControl ItemsSource="{Binding RecentUses}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type diag:CapabilityUse}">
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Capability}" FontSize="12.5" Foreground="{StaticResource B.Text3}" />
                                                <TextBlock Grid.Column="1" Text="{Binding App}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="2" Text="{Binding LastText}" FontSize="12.5" Foreground="{StaticResource B.Text2}" Margin="10,0,0,0" />
                                            </Grid>
                                        </DataTemplate>
