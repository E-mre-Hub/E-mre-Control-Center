                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Kind}" FontSize="12.5" Foreground="{StaticResource B.Text3}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2" Text="{Binding StateText}" FontSize="12.5" Foreground="{StaticResource B.Text2}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        </Grid>
    </DataTemplate>

    <!-- ================================================================== Sistem Raporu -->
    <DataTemplate DataType="{x:Type tools:ReportViewModel}">
        <!-- Kart düzeni: içerik (başlık dahil) en fazla 1136 px, sola yaslı (mevcut bölmelerle aynı) -->
        <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MaxWidth="1136" />
        </Grid.ColumnDefinitions>
        <Grid Margin="8,0,8,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ToolHeader}" Focusable="False" />
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Border Style="{StaticResource CardShadowLayer}" />
                        <Border Style="{StaticResource Card.Flat}" Padding="20,16">
                            <StackPanel>
                                <TextBlock Text="Rapora girecek bölümler" Style="{StaticResource Tool.Section}" />
                                <ItemsControl ItemsSource="{Binding Parts}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type tools:ReportPartViewModel}">
                                            <CheckBox Content="{Binding Title}" IsChecked="{Binding IsChecked}" Margin="0,0,20,8" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Style="{StaticResource T.SettingDesc}" Margin="0,6,0,0">
                                    <Run Text="Gizlenen kişisel bilgiler:" Foreground="{StaticResource B.Text2}" />
                                    <Run Text="{Binding MaskedText, Mode=OneWay}" />
                                </TextBlock>
                                <WrapPanel Margin="0,14,0,0">
                                    <Button Style="{StaticResource Btn.Primary}" Height="40" Padding="16,0" Margin="0,0,10,8" Command="{Binding CreateCommand}"
                                            AutomationProperties.Name="Raporu oluştur">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE7C3;" Style="{StaticResource T.Icon}" FontSize="14" Margin="0,0,9,0" />
                                            <TextBlock Text="Raporu oluştur" FontSize="13" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource Btn.Secondary}" Height="40" Padding="14,0" Margin="0,0,8,8" Command="{Binding SaveTextCommand}">
                                        <TextBlock Text="TXT kaydet…" FontSize="12.5" />
                                    </Button>
                                    <Button Style="{StaticResource Btn.Secondary}" Height="40" Padding="14,0" Margin="0,0,8,8" Command="{Binding SaveHtmlCommand}">
                                        <TextBlock Text="HTML kaydet…" FontSize="12.5" />
                                    </Button>
                                    <Button Style="{StaticResource Btn.Secondary}" Height="40" Padding="14,0" Margin="0,0,8,8" Command="{Binding SaveJsonCommand}">
                                        <TextBlock Text="JSON kaydet…" FontSize="12.5" />
                                    </Button>
                                    <Button Style="{StaticResource Btn.Link}" Height="40" Margin="0,0,0,8" Command="{Binding ShowSavedCommand}"
                                            Visibility="{Binding HasSaved, Converter={StaticResource Visible}}">
                                        <TextBlock Text="Klasörde göster" />
                                    </Button>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <TextBox Style="{StaticResource Input.ReadOnly}" Height="380" FontFamily="{StaticResource F.Mono}" FontSize="11.5"
                             Text="{Binding Preview, Mode=OneWay}" Visibility="{Binding HasPreview, Converter={StaticResource Visible}}"
                             AutomationProperties.Name="Rapor önizlemesi" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
        </Grid>
    </DataTemplate>

    <!-- ================================================================== Destek Paketi -->
    <DataTemplate DataType="{x:Type tools:SupportPackageViewModel}">
        <!-- Kart düzeni: içerik (başlık dahil) en fazla 1136 px, sola yaslı (mevcut bölmelerle aynı) -->
        <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MaxWidth="1136" />
        </Grid.ColumnDefinitions>
        <Grid Margin="8,0,8,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ToolHeader}" Focusable="False" />
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Border Style="{StaticResource CardShadowLayer}" />
                        <Border Style="{StaticResource Card.Flat}" Padding="20,16">
                            <StackPanel>
                                <TextBlock Text="Pakete girecek bilgiler (oluşturmadan önce seçin)" Style="{StaticResource Tool.Section}" />
                                <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type tools:SupportItemViewModel}">
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Top" Margin="0,1,10,0" AutomationProperties.Name="{Binding Title}" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Description}" Style="{StaticResource T.SettingDesc}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Style="{StaticResource T.SettingDesc}" Margin="0,4,0,0">
                                    <Run Text="Gizlenen / eklenmeyen bilgiler:" Foreground="{StaticResource B.Text2}" />
                                    <Run Text="{Binding MaskedText, Mode=OneWay}" />
                                    <Run Text=". Belgeler, parolalar ve tarayıcı verileri eklenmez; paket otomatik olarak hiçbir yere gönderilmez." />
                                </TextBlock>
                                <Button Style="{StaticResource Btn.Primary}" Height="40" Padding="16,0" Margin="0,14,0,0" HorizontalAlignment="Left"
                                        Command="{Binding CreateCommand}" AutomationProperties.Name="Destek paketini oluştur">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7B8;" Style="{StaticResource T.Icon}" FontSize="14" Margin="0,0,9,0" />
                                        <TextBlock Text="Destek paketini oluştur…" FontSize="13" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Border Style="{StaticResource Card.Flat}" Padding="16,12" Visibility="{Binding HasResult, Converter={StaticResource Visible}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding ResultText}" FontSize="12.5" TextWrapping="Wrap" />
                            <Button Grid.Column="1" Style="{StaticResource Btn.Secondary}" Height="34" Padding="12,0" Margin="12,0,0,0" VerticalAlignment="Center"
                                    Command="{Binding ShowCommand}" Visibility="{Binding ResultOk, Converter={StaticResource Visible}}">
                                <TextBlock Text="Klasörde göster" FontSize="12.5" />
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        </Grid>
    </DataTemplate>

</ResourceDictionary>
