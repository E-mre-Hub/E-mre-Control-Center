            </Grid>
            <Border Grid.Row="2" Style="{StaticResource Tool.ActionBar}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectionNote}" FontSize="12.5" TextWrapping="Wrap" Foreground="{StaticResource B.Text2}" />
                        <TextBlock Style="{StaticResource T.SettingDesc}" Margin="0,2,0,0"
                                   Text="Devre dışı bırakma Görev Yöneticisi ile aynı yöntemle yapılır; başlangıç kaydı silinmez. Bilinmeyen yayıncı zararlı anlamına gelmez." />
                    </StackPanel>
                    <WrapPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <Button Style="{StaticResource Btn.Ghost}" Height="34" Padding="12,0" Margin="0,0,8,0" Command="{Binding ShowCommand}">
                            <TextBlock Text="Konumu aç" FontSize="12.5" />
                        </Button>
                        <Button Style="{StaticResource Btn.Ghost}" Height="34" Padding="12,0" Margin="0,0,8,0" Command="{Binding OpenStartupSettingsCommand}">
                            <TextBlock Text="Windows başlangıç ayarları" FontSize="12.5" />
                        </Button>
                        <Button Style="{StaticResource Btn.Secondary}" Height="34" Padding="12,0" Command="{Binding ToggleCommand}">
                            <TextBlock Text="{Binding ToggleText}" FontSize="12.5" />
                        </Button>
                    </WrapPanel>
                </Grid>
            </Border>
        </Grid>
    </DataTemplate>

    <!-- ================================================================== Windows Servisleri -->
    <DataTemplate DataType="{x:Type tools:ServicesViewModel}">
        <Grid Margin="8,0,8,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ToolHeader}" Focusable="False" />
            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MaxWidth="340" />
                </Grid.ColumnDefinitions>
                <WrapPanel VerticalAlignment="Center">
                    <RadioButton Style="{StaticResource Chip}" GroupName="SvcFilter" Content="Tümü"
                                 IsChecked="{Binding Filter, Converter={StaticResource EqualsParam}, ConverterParameter=all}" />
                    <RadioButton Style="{StaticResource Chip}" GroupName="SvcFilter" Content="Çalışan"
                                 IsChecked="{Binding Filter, Converter={StaticResource EqualsParam}, ConverterParameter=running}" />
                    <RadioButton Style="{StaticResource Chip}" GroupName="SvcFilter" Content="Durdurulmuş"
                                 IsChecked="{Binding Filter, Converter={StaticResource EqualsParam}, ConverterParameter=stopped}" />
                    <RadioButton Style="{StaticResource Chip}" GroupName="SvcFilter" Content="Microsoft dışı" Margin="0,0,14,0"
                                 IsChecked="{Binding Filter, Converter={StaticResource EqualsParam}, ConverterParameter=thirdparty}" />
                </WrapPanel>
                <TextBox Grid.Column="1" Style="{StaticResource Input.Search}" Tag="Hizmet, ad veya yayıncı ara"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Hizmetlerde ara" />
            </Grid>
            <Grid Grid.Row="2">
                <Border Style="{StaticResource CardShadowLayer}" />
                <Border Style="{StaticResource Card.Flat}" Padding="10,12,10,8">
                    <DataGrid Style="{StaticResource Grid.Tool}" ItemsSource="{Binding ServicesView}" SelectedItem="{Binding Selected}" AutomationProperties.Name="Windows hizmetleri">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="HİZMET" Width="3*" SortMemberPath="DisplayName">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type diag:ServiceEntry}">
                                        <DockPanel>
                                            <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{StaticResource B.Gray}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                <Setter Property="Fill" Value="{StaticResource B.Green}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding DisplayName}" Style="{StaticResource T.Cell}" />
                                        </DockPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="AD" Binding="{Binding Name}" Width="1.4*" ElementStyle="{StaticResource T.Cell}" />
                            <DataGridTextColumn Header="DURUM" Binding="{Binding StateText}" Width="90" ElementStyle="{StaticResource T.Cell}" />
                            <DataGridTextColumn Header="BAŞLANGIÇ" Binding="{Binding StartModeText}" Width="1.3*" ElementStyle="{StaticResource T.Cell}" />
                            <DataGridTextColumn Header="YAYINCI" Binding="{Binding PublisherText}" Width="1.5*" ElementStyle="{StaticResource T.Cell}" />
                            <DataGridTextColumn Header="DOSYA" Binding="{Binding PathText}" Width="2.5*" ElementStyle="{StaticResource T.Cell}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>
            <Border Grid.Row="3" Style="{StaticResource Tool.ActionBar}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding SelectionNote}" FontSize="12.5" TextWrapping="Wrap" Foreground="{StaticResource B.Text2}" VerticalAlignment="Center"
                               MaxHeight="54" TextTrimming="CharacterEllipsis" />
                    <WrapPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <Button Style="{StaticResource Btn.Ghost}" Height="34" Padding="12,0" Margin="0,0,8,0" Command="{Binding OpenServicesConsoleCommand}">
                            <TextBlock Text="Hizmetler konsolu" FontSize="12.5" />
                        </Button>
                        <Button Style="{StaticResource Btn.Secondary}" Height="34" Padding="12,0" Margin="0,0,8,0" Command="{Binding StartCommand}">
                            <TextBlock Text="Başlat…" FontSize="12.5" />
                        </Button>
                        <Button Style="{StaticResource Btn.Secondary}" Height="34" Padding="12,0" Margin="0,0,8,0" Command="{Binding RestartCommand}">
                            <TextBlock Text="Yeniden başlat…" FontSize="12.5" />
                        </Button>
                        <Button Style="{StaticResource Btn.Secondary}" Height="34" Padding="12,0" Command="{Binding StopCommand}">
                            <TextBlock Text="Durdur…" FontSize="12.5" />
                        </Button>
                    </WrapPanel>
                </Grid>
            </Border>
        </Grid>
    </DataTemplate>

