<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:tools="clr-namespace:RtxWindowsUpdater.ViewModels.Tools"
                    xmlns:diag="clr-namespace:RtxWindowsUpdater.Services.Diagnostics">
    <!-- Araç ekranları (v1.8.0): ortak parçalar + Cihaz Sağlık (Sistem Sağlığı, Depolama Sağlığı, Olay Günlüğü, Çökme Analizi) + Ağ.
         Yalnızca Theme.xaml ve uygulama düzeyindeki dönüştürücüleri kullanır (UiHarness da aynılarını yükler).
         Sürekli animasyon (dönen ikon) gölge efektli bir atanın içinde değildir: kartlar Card.Flat + ayrı CardShadowLayer. -->

    <!-- Dönen durum ikonu: yalnızca görünürken döner (meşgul değilken gizli → animasyon durur). -->
    <Style x:Key="Tool.Spinner" TargetType="TextBlock" BasedOn="{StaticResource T.Icon}">
        <Setter Property="Text" Value="&#xE895;" />
        <Setter Property="Foreground" Value="{StaticResource B.Neon}" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <RotateTransform Angle="0" />
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="ToolSpin" Storyboard="{StaticResource Sb.Spin}" />
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="ToolSpin" />
                </Trigger.ExitActions>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Durum ikonu (CheckState): "Kontrol ediliyor" iken döner. -->
    <Style x:Key="Tool.StateGlyph" TargetType="TextBlock" BasedOn="{StaticResource T.Icon}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <RotateTransform Angle="0" />
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}, Converter={StaticResource StatusIsBusy}}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard x:Name="StateSpin" Storyboard="{StaticResource Sb.Spin}" />
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="StateSpin" />
                </DataTrigger.ExitActions>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Tool.Section" TargetType="TextBlock" BasedOn="{StaticResource T.H2}">
        <Setter Property="Margin" Value="2,0,0,10" />
    </Style>

    <Style x:Key="Tool.FieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{StaticResource B.Text3}" />
        <Setter Property="Margin" Value="0,0,0,2" />
    </Style>

    <Style x:Key="Tool.FieldValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <!-- Ortak üst şerit: durum metni, dönen ikon, son okuma, İptal / Yenile, gerçek hata metni. -->
    <DataTemplate x:Key="ToolHeader" DataType="{x:Type tools:ToolViewModel}">
        <StackPanel Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid VerticalAlignment="Center" Margin="2,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Tool.Spinner}" FontSize="14" Margin="0,0,10,0"
                               Visibility="{Binding IsBusy, Converter={StaticResource Visible}}" />
                    <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="12.5" Foreground="{StaticResource B.Text2}"
                               TextWrapping="Wrap" VerticalAlignment="Center" />
                </Grid>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding LastRunText}" FontSize="11.5" Foreground="{StaticResource B.Text3}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Button Style="{StaticResource Btn.Ghost}" Height="34" Padding="12,0" Margin="0,0,8,0" Command="{Binding CancelCommand}"
                            Visibility="{Binding IsBusy, Converter={StaticResource Visible}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE711;" Style="{StaticResource T.Icon}" FontSize="10" Margin="0,0,7,0" />
                            <TextBlock Text="İptal" FontSize="12.5" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Btn.Secondary}" Height="34" Padding="14,0" Command="{Binding RefreshCommand}"
                            AutomationProperties.Name="Yenile" Visibility="{Binding ShowRefresh, Converter={StaticResource Visible}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" Style="{StaticResource T.Icon}" FontSize="12" Margin="0,0,8,0" Foreground="{StaticResource B.Neon}" />
                            <TextBlock Text="Yenile" FontSize="12.5" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
            <Border Margin="0,10,0,0" CornerRadius="10" Padding="12,8" Background="#1FFF4D61" BorderBrush="#66FF4D61" BorderThickness="1"
                    Visibility="{Binding HasError, Converter={StaticResource Visible}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE783;" Style="{StaticResource T.Icon}" FontSize="13" Foreground="{StaticResource B.Red}" Margin="0,1,10,0" VerticalAlignment="Top" />
                    <TextBlock Grid.Column="1" Text="{Binding ErrorText}" FontSize="12.5" TextWrapping="Wrap" Foreground="{StaticResource B.Text}" />
                </Grid>
            </Border>
        </StackPanel>
    </DataTemplate>

    <!-- Tanılama satırı (CheckRowViewModel): durum ikonu, başlık, özet, ayrıntı, "Ayrıntı" bağlantısı. -->
    <DataTemplate DataType="{x:Type tools:CheckRowViewModel}">
        <Border Style="{StaticResource Card.Flat}" Padding="16,12" Margin="0,0,0,8" AutomationProperties.Name="{Binding Title}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Width="30" Height="30" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Ellipse Fill="{Binding State, Converter={StaticResource StatusSoftBrush}}" />
                    <TextBlock Style="{StaticResource Tool.StateGlyph}" Tag="{Binding State}" Text="{Binding State, Converter={StaticResource StatusGlyph}}"
                               Foreground="{Binding State, Converter={StaticResource StatusBrush}}" />
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource B.Text}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Summary}" FontSize="12.5" Margin="0,3,0,0" Foreground="{StaticResource B.Text2}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource T.SettingDesc}" Margin="0,4,0,0"
                               Visibility="{Binding HasDetail, Converter={StaticResource Visible}}" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock Text="{Binding StateText}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"
                               Foreground="{Binding State, Converter={StaticResource StatusBrush}}" />
                    <Button Style="{StaticResource Btn.Link}" FontSize="12" HorizontalAlignment="Right" Margin="0,4,-6,0" Command="{Binding OpenCommand}"
                            Visibility="{Binding CanOpen, Converter={StaticResource Visible}}" AutomationProperties.Name="Ayrıntıyı aç">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Ayrıntı" />
                            <TextBlock Text="&#xE76C;" Style="{StaticResource T.Icon}" FontSize="10" Margin="6,1,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- ================================================================== Sistem Sağlığı -->
    <DataTemplate DataType="{x:Type tools:SystemHealthViewModel}">
        <!-- Kart düzeni: içerik (başlık dahil) en fazla 1136 px, sola yaslı (mevcut bölmelerle aynı) -->
        <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MaxWidth="1136" />
        </Grid.ColumnDefinitions>
        <Grid Margin="8,0,8,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ToolHeader}" Focusable="False" />
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Border Style="{StaticResource CardShadowLayer}" />
                        <Border Style="{StaticResource Card.Flat}" Padding="20,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="44" Height="44" Margin="0,0,16,0">
                                    <Ellipse Fill="{Binding Overall, Converter={StaticResource StatusSoftBrush}}" />
                                    <TextBlock Text="{Binding Overall, Converter={StaticResource StatusGlyph}}" Style="{StaticResource T.Icon}" FontSize="18"
                                               Foreground="{Binding Overall, Converter={StaticResource StatusBrush}}" />
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding OverallText}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Style="{StaticResource T.SettingDesc}" Margin="0,4,0,0"
                                               Text="Windows'un kendi kaynaklarından okunur: sürüm, etkinleştirme, bekleyen yeniden başlatma, kritik hizmetler, SFC / DISM / Windows Update kartlarının son gerçek sonucu, disk, sürücü, olay günlüğü ve çökme kayıtları. Hiçbir ayar değiştirilmez." />
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource Btn.Primary}" Height="40" Margin="16,0,0,0" Padding="16,0"
                                        Command="{Binding ScanWithDismCommand}" VerticalAlignment="Center"
                                        ToolTip="Yönetici yetkisiyle ve DISM sonucu yoksa DISM /CheckHealth (salt okunur) da çalıştırılır.">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE9D9;" Style="{StaticResource T.Icon}" FontSize="14" Margin="0,0,9,0" />
                                        <TextBlock Text="Taramayı başlat" FontSize="13" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Rows}" Focusable="False" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
        </Grid>
    </DataTemplate>

    <!-- ================================================================== Depolama Sağlığı -->
    <DataTemplate DataType="{x:Type tools:StorageHealthViewModel}">
        <!-- Kart düzeni: içerik (başlık dahil) en fazla 1136 px, sola yaslı (mevcut bölmelerle aynı) -->
        <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MaxWidth="1136" />
        </Grid.ColumnDefinitions>
        <Grid Margin="8,0,8,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ToolHeader}" Focusable="False" />
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                <StackPanel>
                    <Border CornerRadius="10" Padding="12,8" Margin="0,0,0,12" Background="#140FA0FF" BorderBrush="#331FB6FF" BorderThickness="1"
                            Visibility="{Binding HasNote, Converter={StaticResource Visible}}">
                        <TextBlock Text="{Binding Note}" FontSize="12.5" TextWrapping="Wrap" Foreground="{StaticResource B.Text2}" />
                    </Border>
                    <ItemsControl ItemsSource="{Binding Disks}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type diag:DiskHealth}">
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource IconTile}">
                                        <TextBlock Text="&#xEDA2;" Style="{StaticResource T.TileIcon}" />
                                    </Border>
                                    <Grid Grid.Column="1">
                                        <Border Style="{StaticResource CardShadowLayer}" />
                                        <Border Style="{StaticResource Card.Flat}" Padding="20,16,20,6">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" Style="{StaticResource T.H2}" FontSize="16" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding TypeText}" FontSize="12" Foreground="{StaticResource B.Text3}" Margin="0,3,0,0" />
                                                    </StackPanel>
                                                    <Border Grid.Column="1" CornerRadius="11" Padding="10,3" VerticalAlignment="Top"
                                                            Background="{Binding State, Converter={StaticResource StatusSoftBrush}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding State, Converter={StaticResource StatusGlyph}}" Style="{StaticResource T.Icon}" FontSize="11"
                                                                       Foreground="{Binding State, Converter={StaticResource StatusBrush}}" Margin="0,0,6,0" />
                                                            <TextBlock Text="{Binding StateText}" FontSize="12" FontWeight="SemiBold"
                                                                       Foreground="{Binding State, Converter={StaticResource StatusBrush}}" />
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                                <UniformGrid Columns="3">
                                                    <StackPanel Margin="0,0,12,0">
                                                        <TextBlock Text="Kapasite" Style="{StaticResource Tool.FieldLabel}" />
                                                        <TextBlock Text="{Binding SizeText}" Style="{StaticResource Tool.FieldValue}" />
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,12,0">
                                                        <TextBlock Text="Sıcaklık" Style="{StaticResource Tool.FieldLabel}" />
                                                        <TextBlock Text="{Binding TemperatureText}" Style="{StaticResource Tool.FieldValue}" />
                                                    </StackPanel>
                                                    <StackPanel>
                                                        <TextBlock Text="Aşınma" Style="{StaticResource Tool.FieldLabel}" />
                                                        <TextBlock Text="{Binding WearText}" Style="{StaticResource Tool.FieldValue}" />
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,12,0">
                                                        <TextBlock Text="Çalışma süresi" Style="{StaticResource Tool.FieldLabel}" />
                                                        <TextBlock Text="{Binding PowerOnText}" Style="{StaticResource Tool.FieldValue}" />
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,12,0">
                                                        <TextBlock Text="Bölümler" Style="{StaticResource Tool.FieldLabel}" />
                                                        <TextBlock Text="{Binding VolumesText}" Style="{StaticResource Tool.FieldValue}" />
                                                    </StackPanel>
                                                    <StackPanel>
                                                        <TextBlock Text="Ürün yazılımı" Style="{StaticResource Tool.FieldLabel}" />
                                                        <TextBlock Text="{Binding Disk.Firmware, TargetNullValue=—}" Style="{StaticResource Tool.FieldValue}" />
                                                    </StackPanel>
                                                </UniformGrid>
                                                <TextBlock Text="Okuma / yazma hataları" Style="{StaticResource Tool.FieldLabel}" />
                                                <TextBlock Text="{Binding ErrorsText}" Style="{StaticResource Tool.FieldValue}" />
                                                <TextBlock Text="Bulgular" Style="{StaticResource Tool.FieldLabel}" />
                                                <TextBlock Text="{Binding FindingsText}" Style="{StaticResource Tool.FieldValue}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid Margin="96,0,0,8">
                        <Border Style="{StaticResource CardShadowLayer}" />
                        <Border Style="{StaticResource Card.Flat}" Padding="20,16,20,8">
                            <StackPanel>
                                <TextBlock Text="Harfli bölümler" Style="{StaticResource Tool.Section}" />
                                <ItemsControl ItemsSource="{Binding Volumes}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type diag:VolumeInfo}">
                                            <StackPanel Margin="0,0,0,12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock FontWeight="SemiBold" FontSize="13" Margin="0,0,12,0">
                                                        <Run Text="{Binding Letter, Mode=OneWay}" />
                                                        <Run Text="{Binding Label, Mode=OneWay}" Foreground="{StaticResource B.Text3}" />
                                                    </TextBlock>
                                                    <TextBlock Grid.Column="1" Text="{Binding UsageText}" FontSize="12" Foreground="{StaticResource B.Text2}"
                                                               TextWrapping="Wrap" HorizontalAlignment="Right" />
                                                </Grid>
                                                <ProgressBar Style="{StaticResource Progress.Neon}" Margin="0,6,0,0" Minimum="0" Maximum="100"
                                                             Value="{Binding UsedPercent, Mode=OneWay}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        </Grid>
    </DataTemplate>

    <!-- ================================================================== Olay Günlüğü -->
    <DataTemplate DataType="{x:Type tools:EventLogViewModel}">
        <Grid Margin="8,0,8,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ToolHeader}" Focusable="False" />
            <StackPanel Grid.Row="1" Margin="0,0,0,10">
                <WrapPanel Margin="0,0,0,8">
                    <TextBlock Text="Süre:" FontSize="12" Foreground="{StaticResource B.Text3}" VerticalAlignment="Center" Margin="2,0,8,6" />
                    <RadioButton Style="{StaticResource Chip}" GroupName="EvPeriod" Content="Son 1 saat" Margin="0,0,6,6"
                                 IsChecked="{Binding Period, Converter={StaticResource EqualsParam}, ConverterParameter=1h}" />
                    <RadioButton Style="{StaticResource Chip}" GroupName="EvPeriod" Content="Son 24 saat" Margin="0,0,6,6"
                                 IsChecked="{Binding Period, Converter={StaticResource EqualsParam}, ConverterParameter=24h}" />
                    <RadioButton Style="{StaticResource Chip}" GroupName="EvPeriod" Content="Son 7 gün" Margin="0,0,6,6"
                                 IsChecked="{Binding Period, Converter={StaticResource EqualsParam}, ConverterParameter=7d}" />
                    <RadioButton Style="{StaticResource Chip}" GroupName="EvPeriod" Content="Son 30 gün" Margin="0,0,18,6"
                                 IsChecked="{Binding Period, Converter={StaticResource EqualsParam}, ConverterParameter=30d}" />
                    <TextBlock Text="Günlük:" FontSize="12" Foreground="{StaticResource B.Text3}" VerticalAlignment="Center" Margin="0,0,8,6" />
                    <RadioButton Style="{StaticResource Chip}" GroupName="EvLog" Content="Sistem + Uygulama" Margin="0,0,6,6"
                                 IsChecked="{Binding Log, Converter={StaticResource EqualsParam}, ConverterParameter=both}" />
                    <RadioButton Style="{StaticResource Chip}" GroupName="EvLog" Content="Sistem" Margin="0,0,6,6"
                                 IsChecked="{Binding Log, Converter={StaticResource EqualsParam}, ConverterParameter=system}" />
                    <RadioButton Style="{StaticResource Chip}" GroupName="EvLog" Content="Uygulama" Margin="0,0,6,6"
                                 IsChecked="{Binding Log, Converter={StaticResource EqualsParam}, ConverterParameter=application}" />
                </WrapPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MaxWidth="360" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox Content="Kritik" IsChecked="{Binding IncludeCritical}" Margin="2,0,16,0" />
                        <CheckBox Content="Hata" IsChecked="{Binding IncludeError}" Margin="0,0,16,0" />
                        <CheckBox Content="Uyarı" IsChecked="{Binding IncludeWarning}" Margin="0,0,20,0" />
                    </StackPanel>
                    <TextBox Grid.Column="1" Style="{StaticResource Input.Search}" Tag="Kaynak, ileti veya olay no ara"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Olaylarda ara" />
                </Grid>
            </StackPanel>
            <Grid Grid.Row="2">
                <Border Style="{StaticResource CardShadowLayer}" />
                <Border Style="{StaticResource Card.Flat}" Padding="10,12,10,8">
                    <DataGrid Style="{StaticResource Grid.Tool}" ItemsSource="{Binding EntriesView}" SelectedItem="{Binding Selected}"
                              AutomationProperties.Name="Olay kayıtları">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="TARİH" Binding="{Binding TimeText}" Width="120" ElementStyle="{StaticResource T.Cell}" />
                            <DataGridTemplateColumn Header="DÜZEY" Width="92" SortMemberPath="Level">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type diag:EventEntry}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{StaticResource B.Orange}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Level}" Value="1">
                                                                <Setter Property="Fill" Value="{StaticResource B.Red}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Level}" Value="2">
                                                                <Setter Property="Fill" Value="{StaticResource B.Red}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding LevelText}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="GÜNLÜK" Binding="{Binding LogText}" Width="80" ElementStyle="{StaticResource T.Cell}" />
                            <DataGridTextColumn Header="KAYNAK" Binding="{Binding Provider}" Width="2*" ElementStyle="{StaticResource T.Cell}" />
                            <DataGridTextColumn Header="OLAY" Binding="{Binding Id}" Width="64" ElementStyle="{StaticResource T.Cell}" />
                            <DataGridTextColumn Header="İLETİ" Binding="{Binding ShortMessage}" Width="4*" ElementStyle="{StaticResource T.Cell}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>
            <Grid Grid.Row="3" Margin="0,10,0,0" Visibility="{Binding HasSelected, Converter={StaticResource Visible}}">
                <Border Style="{StaticResource Card.Flat}" Padding="16,12">
                    <StackPanel>
                        <TextBlock FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,6" TextWrapping="Wrap">
                            <Run Text="{Binding Selected.Provider, Mode=OneWay}" />
                            <Run Text=" · Olay " Foreground="{StaticResource B.Text3}" />
                            <Run Text="{Binding Selected.Id, Mode=OneWay}" />
                            <Run Text=" · " Foreground="{StaticResource B.Text3}" />
                            <Run Text="{Binding Selected.TimeText, Mode=OneWay}" Foreground="{StaticResource B.Text2}" />
                        </TextBlock>
                        <TextBox Style="{StaticResource Input.ReadOnly}" MaxHeight="140" Text="{Binding Selected.Message, Mode=OneWay}"
                                 AutomationProperties.Name="Olay iletisi" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </DataTemplate>

    <!-- ================================================================== Çökme Analizi -->
    <DataTemplate DataType="{x:Type tools:CrashViewModel}">
        <Grid Margin="8,0,8,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ToolHeader}" Focusable="False" />
            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Border Style="{StaticResource CardShadowLayer}" />
                <Border Style="{StaticResource Card.Flat}" Padding="20,14">
                    <StackPanel>
                        <WrapPanel Margin="0,0,0,8">
                            <TextBlock Text="Süre:" FontSize="12" Foreground="{StaticResource B.Text3}" VerticalAlignment="Center" Margin="0,0,8,4" />
                            <RadioButton Style="{StaticResource Chip}" GroupName="CrashDays" Content="30 gün" Margin="0,0,6,4"
                                         IsChecked="{Binding Days, Converter={StaticResource EqualsParam}, ConverterParameter=30}" />
                            <RadioButton Style="{StaticResource Chip}" GroupName="CrashDays" Content="90 gün" Margin="0,0,6,4"
                                         IsChecked="{Binding Days, Converter={StaticResource EqualsParam}, ConverterParameter=90}" />
                            <RadioButton Style="{StaticResource Chip}" GroupName="CrashDays" Content="1 yıl" Margin="0,0,6,4"
                                         IsChecked="{Binding Days, Converter={StaticResource EqualsParam}, ConverterParameter=365}" />
                        </WrapPanel>
                        <TextBlock Text="{Binding CountsText}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding DumpNote}" Style="{StaticResource T.SettingDesc}" Margin="0,6,0,0" />
                        <TextBlock Style="{StaticResource T.SettingDesc}" Margin="0,6,0,0"
                                   Text="Kaynak: Sistem günlüğü (WER 1001 hata denetimi, Kernel-Power 41, EventLog 6008, Display 4101, WHEA) ve minidump başlığı. Hata kodundan çıkarılan bileşen yalnızca &quot;ilişkili olabilir&quot; bilgisidir; kesin neden için döküm dosyası WinDbg ile incelenmelidir." />
                    </StackPanel>
                </Border>
            </Grid>
            <Grid Grid.Row="2">
                <Border Style="{StaticResource CardShadowLayer}" />
                <Border Style="{StaticResource Card.Flat}" Padding="10,12,10,8">
                    <Grid>
                        <DataGrid Style="{StaticResource Grid.Tool}" ItemsSource="{Binding Events}" AutomationProperties.Name="Çökme kayıtları">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="TARİH" Binding="{Binding TimeText}" Width="120" ElementStyle="{StaticResource T.Cell}" />
                                <DataGridTextColumn Header="TÜR" Binding="{Binding KindText}" Width="2*" ElementStyle="{StaticResource T.Cell}" />
                                <DataGridTextColumn Header="OLAY" Binding="{Binding EventId}" Width="56" ElementStyle="{StaticResource T.Cell}" />
                                <DataGridTextColumn Header="KOD" Binding="{Binding CodeText}" Width="2*" ElementStyle="{StaticResource T.Cell}" />
                                <DataGridTextColumn Header="MODÜL" Binding="{Binding ModuleText}" Width="*" ElementStyle="{StaticResource T.Cell}" />
                                <DataGridTextColumn Header="İLİŞKİLİ OLABİLİR" Binding="{Binding RelationText}" Width="3*" ElementStyle="{StaticResource T.Cell}" />
                                <DataGridTextColumn Header="DÖKÜM" Binding="{Binding DumpText}" Width="*" ElementStyle="{StaticResource T.Cell}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="Seçilen sürede çökme / beklenmedik kapanma kaydı yok." FontSize="12.5" Foreground="{StaticResource B.Text3}"
                                   Margin="12,48,12,0" VerticalAlignment="Top" TextWrapping="Wrap"
                                   Visibility="{Binding HasEvents, Converter={StaticResource Hidden}}" />
                    </Grid>
                </Border>
            </Grid>
            <Grid Grid.Row="3" Margin="0,12,0,0" Visibility="{Binding HasDumps, Converter={StaticResource Visible}}">
                <Border Style="{StaticResource Card.Flat}" Padding="10,12,10,8">
                    <DataGrid Style="{StaticResource Grid.Tool}" ItemsSource="{Binding Dumps}" MaxHeight="170" AutomationProperties.Name="Minidump dosyaları">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="MINIDUMP" Binding="{Binding Name}" Width="2*" ElementStyle="{StaticResource T.Cell}" />
                            <DataGridTextColumn Header="TARİH" Binding="{Binding TimeText}" Width="120" ElementStyle="{StaticResource T.Cell}" />
                            <DataGridTextColumn Header="BOYUT" Binding="{Binding SizeText}" Width="80" ElementStyle="{StaticResource T.Cell}" />
                            <DataGridTextColumn Header="KOD" Binding="{Binding CodeText}" Width="2*" ElementStyle="{StaticResource T.Cell}" />
                            <DataGridTextColumn Header="PARAMETRELER" Binding="{Binding ParametersText}" Width="2*" ElementStyle="{StaticResource T.Cell}" />
                            <DataGridTextColumn Header="İLİŞKİLİ OLABİLİR" Binding="{Binding RelationText}" Width="3*" ElementStyle="{StaticResource T.Cell}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>
        </Grid>
    </DataTemplate>

    <!-- ================================================================== Ağ Merkezi -->
    <DataTemplate DataType="{x:Type tools:NetworkViewModel}">
        <!-- Kart düzeni: içerik (başlık dahil) en fazla 1136 px, sola yaslı (mevcut bölmelerle aynı) -->
        <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MaxWidth="1136" />
        </Grid.ColumnDefinitions>
        <Grid Margin="8,0,8,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ToolHeader}" Focusable="False" />
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                <StackPanel>
                    <!-- Bağlantı testleri -->
                    <Grid Margin="0,0,0,14">
                        <Border Style="{StaticResource CardShadowLayer}" />
                        <Border Style="{StaticResource Card.Flat}" Padding="20,16">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ConnectivityText}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding ProfileText}" FontSize="12" Foreground="{StaticResource B.Text3}" Margin="0,3,0,0"
                                                   Visibility="{Binding ProfileText, Converter={StaticResource Visible}}" />
                                        <TextBlock Text="{Binding WifiText}" Style="{StaticResource T.SettingDesc}" Margin="0,4,0,0"
                                                   Visibility="{Binding HasWifi, Converter={StaticResource Visible}}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource Btn.Primary}" Height="40" Padding="16,0" Margin="16,0,0,0"
                                            Command="{Binding RunTestsCommand}" VerticalAlignment="Center" AutomationProperties.Name="Bağlantı testlerini çalıştır">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE968;" Style="{StaticResource T.Icon}" FontSize="14" Margin="0,0,9,0" />
                                            <TextBlock Text="Testleri çalıştır" FontSize="13" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <TextBlock Text="{Binding TestStatus}" Style="{StaticResource T.SettingDesc}" Margin="0,12,0,10" />
                                <ItemsControl ItemsSource="{Binding Tests}" Focusable="False" />
                                <TextBlock Style="{StaticResource T.SettingDesc}" Margin="0,4,0,0"
                                           Text="Ağ geçidi: 10 ICMP · İnternet: 1.1.1.1'e 20 ICMP (gecikme + paket kaybı; hiç yanıt yoksa kayıp oranı hesaplanmaz) · Windows NCSI değerlendirmesi · Sistem çözümleyicisiyle DNS · microsoft.com ve speed.cloudflare.com'a HTTPS. Hız ölçümü için Hız Testi bölmesi." />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Grid Margin="2,0,0,10">
                        <TextBlock Text="Ağ bağdaştırıcıları" Style="{StaticResource Tool.Section}" Margin="0" VerticalAlignment="Center" />
                        <CheckBox HorizontalAlignment="Right" Content="Bağlı olmayanları da göster" IsChecked="{Binding ShowInactive}" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Adapters}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type diag:AdapterInfo}">
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource IconTile}">
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource T.TileIcon}">
                                                    <Setter Property="Text" Value="&#xE839;" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsWireless}" Value="True">
                                                            <Setter Property="Text" Value="&#xE701;" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                    <Grid Grid.Column="1">
                                        <Border Style="{StaticResource CardShadowLayer}" />
                                        <Border Style="{StaticResource Card.Flat}" Padding="20,16,20,6">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap">
                                                            <Run Text="{Binding Name, Mode=OneWay}" />
                                                            <Run Text="{Binding TypeText, Mode=OneWay}" FontSize="12" Foreground="{StaticResource B.Text3}" />
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{StaticResource B.Text3}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                                        <Border CornerRadius="11" Padding="10,3" Margin="0,0,6,0" Background="#1A1FB6FF"
                                                                Visibility="{Binding IsPrimary, Converter={StaticResource Visible}}">
                                                            <TextBlock Text="Birincil" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource B.Neon}" />
                                                        </Border>
                                                        <Border CornerRadius="11" Padding="10,3" Background="#14FFFFFF">
                                                            <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource B.Text}" />
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>
                                                <UniformGrid Columns="3">
                                                    <StackPanel Margin="0,0,12,0">
                                                        <TextBlock Text="Bağlantı hızı" Style="{StaticResource Tool.FieldLabel}" />
                                                        <TextBlock Text="{Binding SpeedText}" Style="{StaticResource Tool.FieldValue}" />
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,12,0">
                                                        <TextBlock Text="IPv4" Style="{StaticResource Tool.FieldLabel}" />
                                                        <TextBlock Text="{Binding IPv4Text}" Style="{StaticResource Tool.FieldValue}" />
                                                    </StackPanel>
                                                    <StackPanel>
                                                        <TextBlock Text="Ağ geçidi" Style="{StaticResource Tool.FieldLabel}" />
                                                        <TextBlock Text="{Binding GatewayText}" Style="{StaticResource Tool.FieldValue}" />
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,12,0">
                                                        <TextBlock Text="DNS sunucuları" Style="{StaticResource Tool.FieldLabel}" />
                                                        <TextBlock Text="{Binding DnsText}" Style="{StaticResource Tool.FieldValue}" />
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,12,0">
                                                        <TextBlock Text="DHCP" Style="{StaticResource Tool.FieldLabel}" />
                                                        <TextBlock Text="{Binding DhcpText}" Style="{StaticResource Tool.FieldValue}" />
                                                    </StackPanel>
                                                    <StackPanel>
                                                        <TextBlock Text="MAC adresi" Style="{StaticResource Tool.FieldLabel}" />
                                                        <TextBlock Text="{Binding MacText}" Style="{StaticResource Tool.FieldValue}" />
                                                    </StackPanel>
                                                </UniformGrid>
                                                <TextBlock Text="IPv6" Style="{StaticResource Tool.FieldLabel}" />
                                                <TextBlock Text="{Binding IPv6Text}" Style="{StaticResource Tool.FieldValue}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        </Grid>
    </DataTemplate>

    <!-- ================================================================== DNS Tanılama -->
    <DataTemplate DataType="{x:Type tools:DnsViewModel}">
        <!-- Kart düzeni: içerik (başlık dahil) en fazla 1136 px, sola yaslı (mevcut bölmelerle aynı) -->
        <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MaxWidth="1136" />
        </Grid.ColumnDefinitions>
        <Grid Margin="8,0,8,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ToolHeader}" Focusable="False" />
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Border Style="{StaticResource CardShadowLayer}" />
                        <Border Style="{StaticResource Card.Flat}" Padding="20,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding OverallText}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Style="{StaticResource T.SettingDesc}" Margin="0,6,0,0">
                                        <Run Text="Etkin bağlantıların DNS sunucuları Windows yapılandırmasından okunur ve her birine doğrudan UDP 53 sorgusu gönderilir. Test alan adları:" />
                                        <Run Text="{Binding TestDomains, Mode=OneWay}" Foreground="{StaticResource B.Text2}" />
                                        <Run Text=". DNSSEC: imzalı alan adında AD bayrağı + bilerek bozuk imzalı dnssec-failed.org'un reddedilmesi. DNS ayarlarınız değiştirilmez." />
                                    </TextBlock>
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource Btn.Primary}" Height="40" Padding="16,0" Margin="16,0,0,0"
                                        Command="{Binding RefreshCommand}" VerticalAlignment="Center" AutomationProperties.Name="DNS testini çalıştır">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE774;" Style="{StaticResource T.Icon}" FontSize="14" Margin="0,0,9,0" />
                                        <TextBlock Text="DNS testini çalıştır" FontSize="13" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>
                    <Grid>
                        <Border Style="{StaticResource CardShadowLayer}" />
                        <Border Style="{StaticResource Card.Flat}" Padding="10,12,10,8">
                            <DataGrid Style="{StaticResource Grid.Tool}" ItemsSource="{Binding Servers}" AutomationProperties.Name="DNS sunucuları" MinHeight="120">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="SUNUCU" Width="2*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate DataType="{x:Type diag:DnsServerResult}">
                                                <DockPanel>
                                                    <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"
                                                             Fill="{Binding State, Converter={StaticResource StatusBrush}}" />
                                                    <TextBlock Text="{Binding ServerText}" Style="{StaticResource T.Cell}" />
                                                </DockPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="TÜR" Binding="{Binding Family}" Width="56" ElementStyle="{StaticResource T.Cell}" />
                                    <DataGridTextColumn Header="BAĞDAŞTIRICI" Binding="{Binding Adapter}" Width="*" ElementStyle="{StaticResource T.Cell}" />
                                    <DataGridTextColumn Header="ÇÖZÜMLEME" Binding="{Binding ResultText}" Width="2*" ElementStyle="{StaticResource T.Cell}" />
                                    <DataGridTextColumn Header="YANIT SÜRESİ" Binding="{Binding TimeText}" Width="2*" ElementStyle="{StaticResource T.Cell}" />
                                    <DataGridTextColumn Header="DNSSEC" Binding="{Binding DnssecText}" Width="3*" ElementStyle="{StaticResource T.Cell}" />
                                    <DataGridTextColumn Header="HATALAR" Binding="{Binding FailuresText}" Width="2*" ElementStyle="{StaticResource T.Cell}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        </Grid>
    </DataTemplate>

</ResourceDictionary>
