<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:RtxWindowsUpdater.Views"
                    xmlns:tools="clr-namespace:RtxWindowsUpdater.ViewModels.Tools"
                    xmlns:diag="clr-namespace:RtxWindowsUpdater.Services.Diagnostics">
    <!-- Araç ekranları (v1.8.0): ortak parçalar + Cihaz Sağlık (Sistem Sağlığı, Depolama Sağlığı, Olay Günlüğü, Çökme Analizi) + Ağ.
         Yalnızca Theme.xaml ve uygulama düzeyindeki dönüştürücüleri kullanır (UiHarness da aynılarını yükler).
         Sürekli animasyon (dönen ikon) gölge efektli bir atanın içinde değildir: kartlar Card.Flat + ayrı CardShadowLayer. -->

    <!-- Dönen durum ikonu: yalnızca görünürken döner (meşgul değilken gizli → animasyon durur). -->
    <Style x:Key="Tool.Spinner" TargetType="TextBlock" BasedOn="{StaticResource T.Icon}">
        <Setter Property="Text" Value="&#xE895;" />
        <Setter Property="Foreground" Value="{DynamicResource B.Neon}" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <RotateTransform Angle="0" />
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="ToolSpin" Storyboard="{StaticResource Sb.Spin}" />
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="ToolSpin" />
                </Trigger.ExitActions>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Durum ikonu (CheckState): "Kontrol ediliyor" iken döner. -->
    <Style x:Key="Tool.StateGlyph" TargetType="TextBlock" BasedOn="{StaticResource T.Icon}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <RotateTransform Angle="0" />
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}, Converter={StaticResource StatusIsBusy}}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard x:Name="StateSpin" Storyboard="{StaticResource Sb.Spin}" />
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="StateSpin" />
                </DataTrigger.ExitActions>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Tool.Section" TargetType="TextBlock" BasedOn="{StaticResource T.H2}">
        <Setter Property="Margin" Value="2,0,0,10" />
    </Style>

    <Style x:Key="Tool.FieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{DynamicResource B.Text3}" />
        <Setter Property="Margin" Value="0,0,0,2" />
    </Style>

    <Style x:Key="Tool.FieldValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <!-- Ortak üst şerit: durum metni, dönen ikon, son okuma, İptal / Yenile, gerçek hata metni. -->
    <DataTemplate x:Key="ToolHeader" DataType="{x:Type tools:ToolViewModel}">
        <StackPanel Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid VerticalAlignment="Center" Margin="2,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Tool.Spinner}" FontSize="14" Margin="0,0,10,0"
                               Visibility="{Binding IsBusy, Converter={StaticResource Visible}}" />
                    <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="12.5" Foreground="{DynamicResource B.Text2}"
                               TextWrapping="Wrap" VerticalAlignment="Center" />
                </Grid>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding LastRunText}" FontSize="11.5" Foreground="{DynamicResource B.Text3}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Button Style="{StaticResource Btn.Ghost}" Height="34" Padding="12,0" Margin="0,0,8,0" Command="{Binding CancelCommand}"
                            Visibility="{Binding IsBusy, Converter={StaticResource Visible}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE711;" Style="{StaticResource T.Icon}" FontSize="10" Margin="0,0,7,0" />
                            <TextBlock Text="{l:T 'İptal', 'Cancel'}" FontSize="12.5" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Btn.Secondary}" Height="34" Padding="14,0" Command="{Binding RefreshCommand}"
                            AutomationProperties.Name="{l:T 'Yenile', 'Refresh'}" Visibility="{Binding ShowRefresh, Converter={StaticResource Visible}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" Style="{StaticResource T.Icon}" FontSize="12" Margin="0,0,8,0" Foreground="{DynamicResource B.Neon}" />
                            <TextBlock Text="{l:T 'Yenile', 'Refresh'}" FontSize="12.5" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
            <Border Margin="0,10,0,0" CornerRadius="10" Padding="12,8" Background="#1FFF4D61" BorderBrush="#66FF4D61" BorderThickness="1"
                    Visibility="{Binding HasError, Converter={StaticResource Visible}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE783;" Style="{StaticResource T.Icon}" FontSize="13" Foreground="{DynamicResource B.Red}" Margin="0,1,10,0" VerticalAlignment="Top" />
                    <TextBlock Grid.Column="1" Text="{Binding ErrorText}" FontSize="12.5" TextWrapping="Wrap" Foreground="{DynamicResource B.Text}" />
                </Grid>
            </Border>
        </StackPanel>
    </DataTemplate>

    <!-- Tanılama satırı (CheckRowViewModel): durum ikonu, başlık, özet, ayrıntı, "Ayrıntı" bağlantısı. -->
    <DataTemplate DataType="{x:Type tools:CheckRowViewModel}">
        <Border Style="{StaticResource Card.Flat}" Padding="16,12" Margin="0,0,0,8" AutomationProperties.Name="{Binding Title}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Width="30" Height="30" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Ellipse Fill="{Binding State, Converter={StaticResource StatusSoftBrush}}" />
                    <TextBlock Style="{StaticResource Tool.StateGlyph}" Tag="{Binding State}" Text="{Binding State, Converter={StaticResource StatusGlyph}}"
                               Foreground="{Binding State, Converter={StaticResource StatusBrush}}" />
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource B.Text}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Summary}" FontSize="12.5" Margin="0,3,0,0" Foreground="{DynamicResource B.Text2}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource T.SettingDesc}" Margin="0,4,0,0"
                               Visibility="{Binding HasDetail, Converter={StaticResource Visible}}" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock Text="{Binding StateText}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"
                               Foreground="{Binding State, Converter={StaticResource StatusBrush}}" />
                    <Button Style="{StaticResource Btn.Link}" FontSize="12" HorizontalAlignment="Right" Margin="0,4,-6,0" Command="{Binding OpenCommand}"
                            Visibility="{Binding CanOpen, Converter={StaticResource Visible}}" AutomationProperties.Name="{l:T 'Ayrıntıyı aç', 'Open details'}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{l:T 'Ayrıntı', 'Details'}" />
                            <TextBlock Text="&#xE76C;" Style="{StaticResource T.Icon}" FontSize="10" Margin="6,1,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- ================================================================== Sistem Sağlığı -->
    <DataTemplate DataType="{x:Type tools:SystemHealthViewModel}">
        <!-- Kart düzeni: içerik (başlık dahil) en fazla 1136 px, sola yaslı (mevcut bölmelerle aynı) -->
        <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MaxWidth="1136" />
        </Grid.ColumnDefinitions>
        <Grid Margin="8,0,8,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ToolHeader}" Focusable="False" />
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Border Style="{StaticResource CardShadowLayer}" />
                        <Border Style="{StaticResource Card.Flat}" Padding="20,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="44" Height="44" Margin="0,0,16,0">
                                    <Ellipse Fill="{Binding Overall, Converter={StaticResource StatusSoftBrush}}" />
                                    <TextBlock Text="{Binding Overall, Converter={StaticResource StatusGlyph}}" Style="{StaticResource T.Icon}" FontSize="18"
                                               Foreground="{Binding Overall, Converter={StaticResource StatusBrush}}" />
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding OverallText}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Style="{StaticResource T.SettingDesc}" Margin="0,4,0,0"
                                               Text="{l:T 'Windows\'un kendi kaynaklarından okunur: sürüm, etkinleştirme, bekleyen yeniden başlatma, kritik hizmetler, SFC / DISM / Windows Update kartlarının son gerçek sonucu, disk, sürücü, olay günlüğü ve çökme kayıtları. Hiçbir ayar değiştirilmez.', 'Read from Windows\' own sources: version, activation, pending restart, critical services, the latest real result of the SFC / DISM / Windows Update cards, disk, drivers, event log and crash records. No setting is changed.'}" />
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource Btn.Primary}" Height="40" Margin="16,0,0,0" Padding="16,0"
                                        Command="{Binding ScanWithDismCommand}" VerticalAlignment="Center"
                                        ToolTip="{l:T 'Yönetici yetkisiyle ve DISM sonucu yoksa DISM /CheckHealth (salt okunur) da çalıştırılır.', 'With administrator rights and no DISM result yet, DISM /CheckHealth (read-only) is also run.'}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE9D9;" Style="{StaticResource T.Icon}" FontSize="14" Margin="0,0,9,0" />
                                        <TextBlock Text="{l:T 'Taramayı başlat', 'Start scan'}" FontSize="13" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Rows}" Focusable="False" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
        </Grid>
    </DataTemplate>

    <!-- ================================================================== Depolama Sağlığı -->
    <DataTemplate DataType="{x:Type tools:StorageHealthViewModel}">
        <!-- Kart düzeni: içerik (başlık dahil) en fazla 1136 px, sola yaslı (mevcut bölmelerle aynı) -->
        <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MaxWidth="1136" />
        </Grid.ColumnDefinitions>
        <Grid Margin="8,0,8,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ToolHeader}" Focusable="False" />
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                <StackPanel>
                    <Border CornerRadius="10" Padding="12,8" Margin="0,0,0,12" Background="#140FA0FF" BorderBrush="#331FB6FF" BorderThickness="1"
                            Visibility="{Binding HasNote, Converter={StaticResource Visible}}">
                        <TextBlock Text="{Binding Note}" FontSize="12.5" TextWrapping="Wrap" Foreground="{DynamicResource B.Text2}" />
                    </Border>
                    <ItemsControl ItemsSource="{Binding Disks}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type diag:DiskHealth}">
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource IconTile}">
                                        <TextBlock Text="&#xEDA2;" Style="{StaticResource T.TileIcon}" />
                                    </Border>
                                    <Grid Grid.Column="1">
                                        <Border Style="{StaticResource CardShadowLayer}" />
                                        <Border Style="{StaticResource Card.Flat}" Padding="20,16,20,6">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" Style="{StaticResource T.H2}" FontSize="16" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding TypeText}" FontSize="12" Foreground="{DynamicResource B.Text3}" Margin="0,3,0,0" />
                                                    </StackPanel>
                                                    <Border Grid.Column="1" CornerRadius="11" Padding="10,3" VerticalAlignment="Top"
                                                            Background="{Binding State, Converter={StaticResource StatusSoftBrush}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding State, Converter={StaticResource StatusGlyph}}" Style="{StaticResource T.Icon}" FontSize="11"
                                                                       Foreground="{Binding State, Converter={StaticResource StatusBrush}}" Margin="0,0,6,0" />
                                                            <TextBlock Text="{Binding StateText}" FontSize="12" FontWeight="SemiBold"
                                                                       Foreground="{Binding State, Converter={StaticResource StatusBrush}}" />
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                                <UniformGrid Columns="3">
                                                    <StackPanel Margin="0,0,12,0">
                                                        <TextBlock Text="{l:T 'Kapasite', 'Capacity'}" Style="{StaticResource Tool.FieldLabel}" />
                                                        <TextBlock Text="{Binding SizeText}" Style="{StaticResource Tool.FieldValue}" />
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,12,0">
                                                        <TextBlock Text="{l:T 'Sıcaklık', 'Temperature'}" Style="{StaticResource Tool.FieldLabel}" />
                                                        <TextBlock Text="{Binding TemperatureText}" Style="{StaticResource Tool.FieldValue}" />
                                                    </StackPanel>
                                                    <StackPanel>
                                                        <TextBlock Text="{l:T 'Aşınma', 'Wear'}" Style="{StaticResource Tool.FieldLabel}" />
                                                        <TextBlock Text="{Binding WearText}" Style="{StaticResource Tool.FieldValue}" />
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,12,0">
                                                        <TextBlock Text="{l:T 'Çalışma süresi', 'Power-on time'}" Style="{StaticResource Tool.FieldLabel}" />
                                                        <TextBlock Text="{Binding PowerOnText}" Style="{StaticResource Tool.FieldValue}" />
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,12,0">
                                                        <TextBlock Text="{l:T 'Bölümler', 'Partitions'}" Style="{StaticResource Tool.FieldLabel}" />
                                                        <TextBlock Text="{Binding VolumesText}" Style="{StaticResource Tool.FieldValue}" />
                                                    </StackPanel>
                                                    <StackPanel>
                                                        <TextBlock Text="{l:T 'Ürün yazılımı', 'Firmware'}" Style="{StaticResource Tool.FieldLabel}" />
                                                        <TextBlock Text="{Binding Disk.Firmware, TargetNullValue=—}" Style="{StaticResource Tool.FieldValue}" />
                                                    </StackPanel>
                                                </UniformGrid>
                                                <TextBlock Text="{l:T 'Okuma / yazma hataları', 'Read / write errors'}" Style="{StaticResource Tool.FieldLabel}" />
                                                <TextBlock Text="{Binding ErrorsText}" Style="{StaticResource Tool.FieldValue}" />
                                                <TextBlock Text="{l:T 'Bulgular', 'Findings'}" Style="{StaticResource Tool.FieldLabel}" />
                                                <TextBlock Text="{Binding FindingsText}" Style="{StaticResource Tool.FieldValue}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid Margin="96,0,0,8">
                        <Border Style="{StaticResource CardShadowLayer}" />
                        <Border Style="{StaticResource Card.Flat}" Padding="20,16,20,8">
                            <StackPanel>
                                <TextBlock Text="{l:T 'Harfli bölümler', 'Lettered partitions'}" Style="{StaticResource Tool.Section}" />
                                <ItemsControl ItemsSource="{Binding Volumes}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type diag:VolumeInfo}">
                                            <StackPanel Margin="0,0,0,12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock FontWeight="SemiBold" FontSize="13" Margin="0,0,12,0">
                                                        <Run Text="{Binding Letter, Mode=OneWay}" />
                                                        <Run Text="{Binding Label, Mode=OneWay}" Foreground="{DynamicResource B.Text3}" />
                                                    </TextBlock>
                                                    <TextBlock Grid.Column="1" Text="{Binding UsageText}" FontSize="12" Foreground="{DynamicResource B.Text2}"
                                                               TextWrapping="Wrap" HorizontalAlignment="Right" />
                                                </Grid>
                                                <ProgressBar Style="{StaticResource Progress.Neon}" Margin="0,6,0,0" Minimum="0" Maximum="100"
                                                             Value="{Binding UsedPercent, Mode=OneWay}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        </Grid>
    </DataTemplate>

    <!-- ================================================================== Olay Günlüğü -->
    <DataTemplate DataType="{x:Type tools:EventLogViewModel}">
        <Grid Margin="8,0,8,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ToolHeader}" Focusable="False" />
            <StackPanel Grid.Row="1" Margin="0,0,0,10">
                <WrapPanel Margin="0,0,0,8">
                    <TextBlock Text="{l:T 'Süre:', 'Period:'}" FontSize="12" Foreground="{DynamicResource B.Text3}" VerticalAlignment="Center" Margin="2,0,8,6" />
                    <RadioButton Style="{StaticResource Chip}" GroupName="EvPeriod" Content="{l:T 'Son 1 saat', 'Last 1 hour'}" Margin="0,0,6,6"
                                 IsChecked="{Binding Period, Converter={StaticResource EqualsParam}, ConverterParameter=1h}" />
                    <RadioButton Style="{StaticResource Chip}" GroupName="EvPeriod" Content="{l:T 'Son 24 saat', 'Last 24 hours'}" Margin="0,0,6,6"
                                 IsChecked="{Binding Period, Converter={StaticResource EqualsParam}, ConverterParameter=24h}" />
                    <RadioButton Style="{StaticResource Chip}" GroupName="EvPeriod" Content="{l:T 'Son 7 gün', 'Last 7 days'}" Margin="0,0,6,6"
                                 IsChecked="{Binding Period, Converter={StaticResource EqualsParam}, ConverterParameter=7d}" />
                    <RadioButton Style="{StaticResource Chip}" GroupName="EvPeriod" Content="{l:T 'Son 30 gün', 'Last 30 days'}" Margin="0,0,18,6"
                                 IsChecked="{Binding Period, Converter={StaticResource EqualsParam}, ConverterParameter=30d}" />
                    <TextBlock Text="{l:T 'Günlük:', 'Log:'}" FontSize="12" Foreground="{DynamicResource B.Text3}" VerticalAlignment="Center" Margin="0,0,8,6" />
                    <RadioButton Style="{StaticResource Chip}" GroupName="EvLog" Content="{l:T 'Sistem + Uygulama', 'System + Application'}" Margin="0,0,6,6"
                                 IsChecked="{Binding Log, Converter={StaticResource EqualsParam}, ConverterParameter=both}" />
                    <RadioButton Style="{StaticResource Chip}" GroupName="EvLog" Content="{l:T 'Sistem', 'System'}" Margin="0,0,6,6"
                                 IsChecked="{Binding Log, Converter={StaticResource EqualsParam}, ConverterParameter=system}" />
                    <RadioButton Style="{StaticResource Chip}" GroupName="EvLog" Content="{l:T 'Uygulama', 'Application'}" Margin="0,0,6,6"
                                 IsChecked="{Binding Log, Converter={StaticResource EqualsParam}, ConverterParameter=application}" />
                </WrapPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MaxWidth="360" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox Content="{l:T 'Kritik', 'Critical'}" IsChecked="{Binding IncludeCritical}" Margin="2,0,16,0" />
                        <CheckBox Content="{l:T 'Hata', 'Error'}" IsChecked="{Binding IncludeError}" Margin="0,0,16,0" />
                        <CheckBox Content="{l:T 'Uyarı', 'Warning'}" IsChecked="{Binding IncludeWarning}" Margin="0,0,20,0" />
                    </StackPanel>
                    <TextBox Grid.Column="1" Style="{StaticResource Input.Search}" Tag="{l:T 'Kaynak, ileti veya olay no ara', 'Search source, message or event ID'}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{l:T 'Olaylarda ara', 'Search events'}" />
                </Grid>
            </StackPanel>
            <Grid Grid.Row="2">
                <Border Style="{StaticResource CardShadowLayer}" />
                <Border Style="{StaticResource Card.Flat}" Padding="10,12,10,8">
                    <DataGrid Style="{StaticResource Grid.Tool}" ItemsSource="{Binding EntriesView}" SelectedItem="{Binding Selected}"
                              AutomationProperties.Name="{l:T 'Olay kayıtları', 'Event records'}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{l:T 'TARİH', 'DATE'}" Binding="{Binding TimeText}" Width="120" ElementStyle="{StaticResource T.Cell}" />
                            <DataGridTemplateColumn Header="{l:T 'DÜZEY', 'LEVEL'}" Width="92" SortMemberPath="Level">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type diag:EventEntry}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{DynamicResource B.Orange}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Level}" Value="1">
                                                                <Setter Property="Fill" Value="{DynamicResource B.Red}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Level}" Value="2">
                                                                <Setter Property="Fill" Value="{DynamicResource B.Red}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding LevelText}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{l:T 'GÜNLÜK', 'LOG'}" Binding="{Binding LogText}" Width="80" ElementStyle="{StaticResource T.Cell}" />
                            <DataGridTextColumn Header="{l:T 'KAYNAK', 'SOURCE'}" Binding="{Binding Provider}" Width="2*" ElementStyle="{StaticResource T.Cell}" />
                            <DataGridTextColumn Header="{l:T 'OLAY', 'EVENT'}" Binding="{Binding Id}" Width="64" ElementStyle="{StaticResource T.Cell}" />
                            <DataGridTextColumn Header="{l:T 'İLETİ', 'MESSAGE'}" Binding="{Binding ShortMessage}" Width="4*" ElementStyle="{StaticResource T.Cell}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>
            <Grid Grid.Row="3" Margin="0,10,0,0" Visibility="{Binding HasSelected, Converter={StaticResource Visible}}">
                <Border Style="{StaticResource Card.Flat}" Padding="16,12">
                    <StackPanel>
                        <TextBlock FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,6" TextWrapping="Wrap">
                            <Run Text="{Binding Selected.Provider, Mode=OneWay}" />
                            <Run Text="{l:T ' · Olay ', ' · Event'}" Foreground="{DynamicResource B.Text3}" />
                            <Run Text="{Binding Selected.Id, Mode=OneWay}" />
                            <Run Text=" · " Foreground="{DynamicResource B.Text3}" />
                            <Run Text="{Binding Selected.TimeText, Mode=OneWay}" Foreground="{DynamicResource B.Text2}" />
                        </TextBlock>
                        <TextBox Style="{StaticResource Input.ReadOnly}" MaxHeight="140" Text="{Binding Selected.Message, Mode=OneWay}"
                                 AutomationProperties.Name="{l:T 'Olay iletisi', 'Event message'}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </DataTemplate>

    <!-- ================================================================== Çökme Analizi -->
    <DataTemplate DataType="{x:Type tools:CrashViewModel}">
        <Grid Margin="8,0,8,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ToolHeader}" Focusable="False" />
            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Border Style="{StaticResource CardShadowLayer}" />
                <Border Style="{StaticResource Card.Flat}" Padding="20,14">
                    <StackPanel>
                        <WrapPanel Margin="0,0,0,8">
                            <TextBlock Text="{l:T 'Süre:', 'Period:'}" FontSize="12" Foreground="{DynamicResource B.Text3}" VerticalAlignment="Center" Margin="0,0,8,4" />
                            <RadioButton Style="{StaticResource Chip}" GroupName="CrashDays" Content="{l:T '30 gün', '30 days'}" Margin="0,0,6,4"
                                         IsChecked="{Binding Days, Converter={StaticResource EqualsParam}, ConverterParameter=30}" />
                            <RadioButton Style="{StaticResource Chip}" GroupName="CrashDays" Content="{l:T '90 gün', '90 days'}" Margin="0,0,6,4"
                                         IsChecked="{Binding Days, Converter={StaticResource EqualsParam}, ConverterParameter=90}" />
                            <RadioButton Style="{StaticResource Chip}" GroupName="CrashDays" Content="{l:T '1 yıl', '1 year'}" Margin="0,0,6,4"
                                         IsChecked="{Binding Days, Converter={StaticResource EqualsParam}, ConverterParameter=365}" />
                        </WrapPanel>
                        <TextBlock Text="{Binding CountsText}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding DumpNote}" Style="{StaticResource T.SettingDesc}" Margin="0,6,0,0" />
                        <TextBlock Style="{StaticResource T.SettingDesc}" Margin="0,6,0,0"
                                   Text="{l:T 'Kaynak: Sistem günlüğü (WER 1001 hata denetimi, Kernel-Power 41, EventLog 6008, Display 4101, WHEA) ve minidump başlığı. Hata kodundan çıkarılan bileşen yalnızca &quot;ilişkili olabilir&quot; bilgisidir; kesin neden için döküm dosyası WinDbg ile incelenmelidir.', 'Source: the System log (WER 1001 bug check, Kernel-Power 41, EventLog 6008, Display 4101, WHEA) and the minidump header. The component inferred from the error code is only a &quot;may be related&quot; hint; examine the dump file with WinDbg for the exact cause.'}" />
                    </StackPanel>
                </Border>
            </Grid>
            <Grid Grid.Row="2">
                <Border Style="{StaticResource CardShadowLayer}" />
                <Border Style="{StaticResource Card.Flat}" Padding="10,12,10,8">
                    <Grid>
                        <DataGrid Style="{StaticResource Grid.Tool}" ItemsSource="{Binding Events}" AutomationProperties.Name="{l:T 'Çökme kayıtları', 'Crash records'}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{l:T 'TARİH', 'DATE'}" Binding="{Binding TimeText}" Width="120" ElementStyle="{StaticResource T.Cell}" />
                                <DataGridTextColumn Header="{l:T 'TÜR', 'TYPE'}" Binding="{Binding KindText}" Width="2*" ElementStyle="{StaticResource T.Cell}" />
                                <DataGridTextColumn Header="{l:T 'OLAY', 'EVENT'}" Binding="{Binding EventId}" Width="56" ElementStyle="{StaticResource T.Cell}" />
                                <DataGridTextColumn Header="{l:T 'KOD', 'CODE'}" Binding="{Binding CodeText}" Width="2*" ElementStyle="{StaticResource T.Cell}" />
                                <DataGridTextColumn Header="{l:T 'MODÜL', 'MODULE'}" Binding="{Binding ModuleText}" Width="*" ElementStyle="{StaticResource T.Cell}" />
                                <DataGridTextColumn Header="{l:T 'İLİŞKİLİ OLABİLİR', 'MAY BE RELATED'}" Binding="{Binding RelationText}" Width="3*" ElementStyle="{StaticResource T.Cell}" />
                                <DataGridTextColumn Header="{l:T 'DÖKÜM', 'DUMP'}" Binding="{Binding DumpText}" Width="*" ElementStyle="{StaticResource T.Cell}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="{l:T 'Seçilen sürede çökme / beklenmedik kapanma kaydı yok.', 'No crash / unexpected shutdown records in the selected period.'}" FontSize="12.5" Foreground="{DynamicResource B.Text3}"
                                   Margin="12,48,12,0" VerticalAlignment="Top" TextWrapping="Wrap"
                                   Visibility="{Binding HasEvents, Converter={StaticResource Hidden}}" />
                    </Grid>
                </Border>
            </Grid>
            <Grid Grid.Row="3" Margin="0,12,0,0" Visibility="{Binding HasDumps, Converter={StaticResource Visible}}">
                <Border Style="{StaticResource Card.Flat}" Padding="10,12,10,8">
                    <DataGrid Style="{StaticResource Grid.Tool}" ItemsSource="{Binding Dumps}" MaxHeight="170" AutomationProperties.Name="{l:T 'Minidump dosyaları', 'Minidump files'}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="MINIDUMP" Binding="{Binding Name}" Width="2*" ElementStyle="{StaticResource T.Cell}" />
                            <DataGridTextColumn Header="{l:T 'TARİH', 'DATE'}" Binding="{Binding TimeText}" Width="120" ElementStyle="{StaticResource T.Cell}" />
                            <DataGridTextColumn Header="{l:T 'BOYUT', 'SIZE'}" Binding="{Binding SizeText}" Width="80" ElementStyle="{StaticResource T.Cell}" />
                            <DataGridTextColumn Header="{l:T 'KOD', 'CODE'}" Binding="{Binding CodeText}" Width="2*" ElementStyle="{StaticResource T.Cell}" />
                            <DataGridTextColumn Header="{l:T 'PARAMETRELER', 'PARAMETERS'}" Binding="{Binding ParametersText}" Width="2*" ElementStyle="{StaticResource T.Cell}" />
                            <DataGridTextColumn Header="{l:T 'İLİŞKİLİ OLABİLİR', 'MAY BE RELATED'}" Binding="{Binding RelationText}" Width="3*" ElementStyle="{StaticResource T.Cell}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>
        </Grid>
    </DataTemplate>

    <!-- ================================================================== Ağ Merkezi -->
    <DataTemplate DataType="{x:Type tools:NetworkViewModel}">
        <!-- Kart düzeni: içerik (başlık dahil) en fazla 1136 px, sola yaslı (mevcut bölmelerle aynı) -->
        <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MaxWidth="1136" />
        </Grid.ColumnDefinitions>
        <Grid Margin="8,0,8,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ToolHeader}" Focusable="False" />
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                <StackPanel>
                    <!-- Bağlantı testleri -->
                    <Grid Margin="0,0,0,14">
                        <Border Style="{StaticResource CardShadowLayer}" />
                        <Border Style="{StaticResource Card.Flat}" Padding="20,16">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ConnectivityText}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding ProfileText}" FontSize="12" Foreground="{DynamicResource B.Text3}" Margin="0,3,0,0"
                                                   Visibility="{Binding ProfileText, Converter={StaticResource Visible}}" />
                                        <TextBlock Text="{Binding WifiText}" Style="{StaticResource T.SettingDesc}" Margin="0,4,0,0"
                                                   Visibility="{Binding HasWifi, Converter={StaticResource Visible}}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource Btn.Primary}" Height="40" Padding="16,0" Margin="16,0,0,0"
                                            Command="{Binding RunTestsCommand}" VerticalAlignment="Center" AutomationProperties.Name="{l:T 'Bağlantı testlerini çalıştır', 'Run the connection tests'}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE968;" Style="{StaticResource T.Icon}" FontSize="14" Margin="0,0,9,0" />
                                            <TextBlock Text="{l:T 'Testleri çalıştır', 'Run tests'}" FontSize="13" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <TextBlock Text="{Binding TestStatus}" Style="{StaticResource T.SettingDesc}" Margin="0,12,0,10" />
                                <ItemsControl ItemsSource="{Binding Tests}" Focusable="False" />
                                <TextBlock Style="{StaticResource T.SettingDesc}" Margin="0,4,0,0"
                                           Text="{l:T 'Ağ geçidi: 10 ICMP · İnternet: 1.1.1.1\'e 20 ICMP (gecikme + paket kaybı; hiç yanıt yoksa kayıp oranı hesaplanmaz) · Windows NCSI değerlendirmesi · Sistem çözümleyicisiyle DNS · microsoft.com ve speed.cloudflare.com\'a HTTPS. Hız ölçümü için Hız Testi bölmesi.', 'Gateway: 10 ICMP · Internet: 20 ICMP to 1.1.1.1 (latency + packet loss; no loss rate is calculated if nothing replies) · Windows NCSI assessment · DNS with the system resolver · HTTPS to microsoft.com and speed.cloudflare.com. For speed, use the Speed Test section.'}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Grid Margin="2,0,0,10">
                        <TextBlock Text="{l:T 'Ağ bağdaştırıcıları', 'Network adapters'}" Style="{StaticResource Tool.Section}" Margin="0" VerticalAlignment="Center" />
                        <CheckBox HorizontalAlignment="Right" Content="{l:T 'Bağlı olmayanları da göster', 'Also show disconnected ones'}" IsChecked="{Binding ShowInactive}" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Adapters}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type diag:AdapterInfo}">
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource IconTile}">
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource T.TileIcon}">
                                                    <Setter Property="Text" Value="&#xE839;" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsWireless}" Value="True">
                                                            <Setter Property="Text" Value="&#xE701;" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                    <Grid Grid.Column="1">
                                        <Border Style="{StaticResource CardShadowLayer}" />
                                        <Border Style="{StaticResource Card.Flat}" Padding="20,16,20,6">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap">
                                                            <Run Text="{Binding Name, Mode=OneWay}" />
                                                            <Run Text="{Binding TypeText, Mode=OneWay}" FontSize="12" Foreground="{DynamicResource B.Text3}" />
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource B.Text3}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                                        <Border CornerRadius="11" Padding="10,3" Margin="0,0,6,0" Background="#1A1FB6FF"
                                                                Visibility="{Binding IsPrimary, Converter={StaticResource Visible}}">
                                                            <TextBlock Text="{l:T 'Birincil', 'Primary'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource B.Neon}" />
                                                        </Border>
                                                        <Border CornerRadius="11" Padding="10,3" Background="{DynamicResource B.Subtle}">
                                                            <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource B.Text}" />
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>
                                                <UniformGrid Columns="3">
                                                    <StackPanel Margin="0,0,12,0">
                                                        <TextBlock Text="{l:T 'Bağlantı hızı', 'Link speed'}" Style="{StaticResource Tool.FieldLabel}" />
                                                        <TextBlock Text="{Binding SpeedText}" Style="{StaticResource Tool.FieldValue}" />
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,12,0">
                                                        <TextBlock Text="IPv4" Style="{StaticResource Tool.FieldLabel}" />
                                                        <TextBlock Text="{Binding IPv4Text}" Style="{StaticResource Tool.FieldValue}" />
                                                    </StackPanel>
                                                    <StackPanel>
                                                        <TextBlock Text="{l:T 'Ağ geçidi', 'Gateway'}" Style="{StaticResource Tool.FieldLabel}" />
                                                        <TextBlock Text="{Binding GatewayText}" Style="{StaticResource Tool.FieldValue}" />
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,12,0">
                                                        <TextBlock Text="{l:T 'DNS sunucuları', 'DNS servers'}" Style="{StaticResource Tool.FieldLabel}" />
                                                        <TextBlock Text="{Binding DnsText}" Style="{StaticResource Tool.FieldValue}" />
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,12,0">
                                                        <TextBlock Text="DHCP" Style="{StaticResource Tool.FieldLabel}" />
                                                        <TextBlock Text="{Binding DhcpText}" Style="{StaticResource Tool.FieldValue}" />
                                                    </StackPanel>
                                                    <StackPanel>
                                                        <TextBlock Text="{l:T 'MAC adresi', 'MAC address'}" Style="{StaticResource Tool.FieldLabel}" />
                                                        <TextBlock Text="{Binding MacText}" Style="{StaticResource Tool.FieldValue}" />
                                                    </StackPanel>
                                                </UniformGrid>
                                                <TextBlock Text="IPv6" Style="{StaticResource Tool.FieldLabel}" />
                                                <TextBlock Text="{Binding IPv6Text}" Style="{StaticResource Tool.FieldValue}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        </Grid>
    </DataTemplate>

    <!-- ================================================================== DNS Tanılama -->
    <DataTemplate DataType="{x:Type tools:DnsViewModel}">
        <!-- Kart düzeni: içerik (başlık dahil) en fazla 1136 px, sola yaslı (mevcut bölmelerle aynı) -->
        <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MaxWidth="1136" />
        </Grid.ColumnDefinitions>
        <Grid Margin="8,0,8,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ToolHeader}" Focusable="False" />
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Border Style="{StaticResource CardShadowLayer}" />
                        <Border Style="{StaticResource Card.Flat}" Padding="20,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding OverallText}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Style="{StaticResource T.SettingDesc}" Margin="0,6,0,0">
                                        <Run Text="{l:T 'Etkin bağlantıların DNS sunucuları Windows yapılandırmasından okunur ve her birine doğrudan UDP 53 sorgusu gönderilir. Test alan adları:', 'The DNS servers of active connections are read from the Windows configuration, and a direct UDP 53 query is sent to each one. Test domains:'}" />
                                        <Run Text="{Binding TestDomains, Mode=OneWay}" Foreground="{DynamicResource B.Text2}" />
                                        <Run Text="{l:T '. DNSSEC: imzalı alan adında AD bayrağı + bilerek bozuk imzalı dnssec-failed.org\'un reddedilmesi. DNS ayarlarınız değiştirilmez.', '. DNSSEC: the AD flag on a signed domain + rejection of the deliberately broken dnssec-failed.org. Your DNS settings are not changed.'}" />
                                    </TextBlock>
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource Btn.Primary}" Height="40" Padding="16,0" Margin="16,0,0,0"
                                        Command="{Binding RefreshCommand}" VerticalAlignment="Center" AutomationProperties.Name="{l:T 'DNS testini çalıştır', 'Run the DNS test'}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE774;" Style="{StaticResource T.Icon}" FontSize="14" Margin="0,0,9,0" />
                                        <TextBlock Text="{l:T 'DNS testini çalıştır', 'Run the DNS test'}" FontSize="13" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>
                    <Grid>
                        <Border Style="{StaticResource CardShadowLayer}" />
                        <Border Style="{StaticResource Card.Flat}" Padding="10,12,10,8">
                            <DataGrid Style="{StaticResource Grid.Tool}" ItemsSource="{Binding Servers}" AutomationProperties.Name="{l:T 'DNS sunucuları', 'DNS servers'}" MinHeight="120">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="{l:T 'SUNUCU', 'SERVER'}" Width="2*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate DataType="{x:Type diag:DnsServerResult}">
                                                <DockPanel>
                                                    <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"
                                                             Fill="{Binding State, Converter={StaticResource StatusBrush}}" />
                                                    <TextBlock Text="{Binding ServerText}" Style="{StaticResource T.Cell}" />
                                                </DockPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="{l:T 'TÜR', 'TYPE'}" Binding="{Binding Family}" Width="56" ElementStyle="{StaticResource T.Cell}" />
                                    <DataGridTextColumn Header="{l:T 'BAĞDAŞTIRICI', 'ADAPTER'}" Binding="{Binding Adapter}" Width="*" ElementStyle="{StaticResource T.Cell}" />
                                    <DataGridTextColumn Header="{l:T 'ÇÖZÜMLEME', 'RESOLUTION'}" Binding="{Binding ResultText}" Width="2*" ElementStyle="{StaticResource T.Cell}" />
                                    <DataGridTextColumn Header="{l:T 'YANIT SÜRESİ', 'RESPONSE TIME'}" Binding="{Binding TimeText}" Width="2*" ElementStyle="{StaticResource T.Cell}" />
                                    <DataGridTextColumn Header="DNSSEC" Binding="{Binding DnssecText}" Width="3*" ElementStyle="{StaticResource T.Cell}" />
                                    <DataGridTextColumn Header="{l:T 'HATALAR', 'ERRORS'}" Binding="{Binding FailuresText}" Width="2*" ElementStyle="{StaticResource T.Cell}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        </Grid>
    </DataTemplate>

</ResourceDictionary>
