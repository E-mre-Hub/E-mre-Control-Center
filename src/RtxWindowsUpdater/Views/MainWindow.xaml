<Window x:Class="RtxWindowsUpdater.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:RtxWindowsUpdater.Views"
        xmlns:vm="clr-namespace:RtxWindowsUpdater.ViewModels"
        xmlns:services="clr-namespace:RtxWindowsUpdater.Services"
        xmlns:core="clr-namespace:RtxWindowsUpdater.Core"
        xmlns:views="clr-namespace:RtxWindowsUpdater.Views"
        Title="{x:Static core:AppInfo.Name}"
        Icon="pack://application:,,,/Assets/E-mreLogo.ico"
        Width="1340" Height="900" MinWidth="1024" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        Background="{DynamicResource B.Bg0}"
        FontFamily="{StaticResource F.Text}"
        Foreground="{DynamicResource B.Text}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
        <!-- v1.8.0 araç ekranlarının şablonları (Sistem Tanılama bölmeleri; ToolViewsA ortak parçaları içerir) -->
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="Tools/ToolViewsB.xaml" />
        </ResourceDictionary.MergedDictionaries>

        <ImageBrush x:Key="LogoBrush" ImageSource="pack://application:,,,/Assets/E-mreLogo.jpg" Stretch="UniformToFill" />

        <!-- Durum ikonu: Tag'e bağlanan durum "meşgul" ise döner -->
        <Style x:Key="T.StatusIcon" TargetType="TextBlock" BasedOn="{StaticResource T.Icon}">
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <RotateTransform Angle="0" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}, Converter={StaticResource StatusIsBusy}}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="SpinStoryboard" Storyboard="{StaticResource Sb.Spin}" />
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="SpinStoryboard" />
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- İkon rozeti (kart başlıkları) -->
        <Style x:Key="IconBadge" TargetType="Border">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource B.TileBorder}" />
            <Setter Property="Background" Value="{DynamicResource B.BadgeBg}" />
        </Style>

        <!-- Kart seçim kutusu (içeriksiz, kompakt) -->
        <Style x:Key="SelectCheck" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="ToolTip" Value="{l:T 'Bu işlemi seç', 'Select this task'}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="box" Width="22" Height="22" CornerRadius="6" BorderThickness="1.5"
                                BorderBrush="{DynamicResource B.InputBorder}" Background="{DynamicResource B.RowBg}">
                            <TextBlock x:Name="mark" Text="&#xE73E;" Style="{StaticResource T.Icon}" FontSize="12"
                                       Foreground="White" Opacity="0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="Background" Value="{DynamicResource B.NeonGradient}" />
                                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource B.Neon}" />
                                <Setter TargetName="box" Property="Effect" Value="{DynamicResource Fx.SoftGlow}" />
                                <Setter TargetName="mark" Property="Opacity" Value="1" />
                                <Setter Property="ToolTip" Value="{l:T 'Seçimi kaldır', 'Clear selection'}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource B.Neon}" />
                            </Trigger>
                            <!-- Kullanım dışı kart seçilemez -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource B.Border}" />
                                <Setter TargetName="box" Property="Opacity" Value="0.5" />
                                <Setter Property="Cursor" Value="Arrow" />
                                <Setter Property="ToolTip" Value="{l:T 'Bu kart bu sistemde kullanım dışı', 'This card is unavailable on this system'}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Seçili kartın üzerindeki neon çerçeve (tıklamayı engellemez) -->
        <Style x:Key="SelectedOverlay" TargetType="Border">
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="BorderBrush" Value="{DynamicResource B.Neon}" />
            <Setter Property="Background" Value="#0A1FB6FF" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Effect" Value="{DynamicResource Fx.SoftGlow}" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Opacity" Value="0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.01" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Sistem Bilgileri satırı -->
        <DataTemplate x:Key="SystemInfoRowTemplate" DataType="{x:Type services:SystemInfoField}">
            <Grid Margin="0,0,0,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" FontSize="11.5" Foreground="{DynamicResource B.Text3}" TextWrapping="Wrap" Margin="0,0,10,0" />
                <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12" TextWrapping="Wrap" ToolTip="{Binding Value}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Available}" Value="False">
                                    <Setter Property="Foreground" Value="{DynamicResource B.Orange}" />
                                    <Setter Property="FontStyle" Value="Italic" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </DataTemplate>

        <!-- Gereksinim satırı -->
        <DataTemplate x:Key="RequirementRowTemplate" DataType="{x:Type vm:RequirementRowViewModel}">
            <Border Background="{DynamicResource B.RowBg}" BorderBrush="{DynamicResource B.RowBorder}" BorderThickness="1" CornerRadius="11" Padding="14,12" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource IconBadge}" Width="38" Height="38">
                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource T.Icon}" FontSize="17"
                                   Foreground="{DynamicResource B.Neon}" Effect="{DynamicResource Fx.SoftGlow}" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,10,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource T.H2}" FontSize="14" />
                        <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{DynamicResource B.Text2}"
                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0" ToolTip="{Binding Detail}" />
                    </StackPanel>
                    <Border Grid.Column="2" Width="30" Height="30" CornerRadius="15"
                            Background="{Binding State, Converter={StaticResource StatusSoftBrush}}">
                        <TextBlock Tag="{Binding State}" Text="{Binding State, Converter={StaticResource StatusGlyph}}"
                                   Style="{StaticResource T.StatusIcon}" FontSize="13"
                                   Foreground="{Binding State, Converter={StaticResource StatusBrush}}" />
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- "?" bilgi butonu (kartın sağ üstü) -->
        <Style x:Key="InfoToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="ToolTip" Value="{l:T 'Bu kart ne yapar?', 'What does this card do?'}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bg" CornerRadius="15" Background="{DynamicResource B.TrackBg}" BorderBrush="{DynamicResource B.Border}" BorderThickness="1">
                            <TextBlock x:Name="glyph" Text="&#xE9CE;" Style="{StaticResource T.Icon}" FontSize="13"
                                       Foreground="{DynamicResource B.Text3}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource B.Neon}" />
                                <Setter TargetName="glyph" Property="Foreground" Value="{DynamicResource B.Neon}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource B.SelectedFill}" />
                                <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource B.Neon}" />
                                <Setter TargetName="glyph" Property="Foreground" Value="{DynamicResource B.Neon}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- Sistem İşlemleri kartı (10 kartın tamamı aynı yapıyı kullanır): solda büyük ikon karosu, sağda geniş kart.
             Performans: gölge, kartla aynı biçimdeki ayrı ve statik katmandadır. Kart içindeki dönen ikon ve ilerleme
             animasyonları böylece gölge efektini her karede yeniden hesaplatmaz. -->
        <DataTemplate x:Key="CardTemplate" DataType="{x:Type vm:ComponentCardViewModel}">
            <Grid Margin="8,0,8,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid VerticalAlignment="Top" HorizontalAlignment="Left">
                    <Border Style="{StaticResource IconTile}">
                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource T.TileIcon}" />
                    </Border>
                    <!-- durum renginde küçük nokta (ikon karosunun köşesinde) -->
                    <Ellipse Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,-3,0"
                             Stroke="{DynamicResource B.PanelBg}" StrokeThickness="2.5" Fill="{Binding Status, Converter={StaticResource StatusBrush}}" />
                </Grid>

                <Grid Grid.Column="1" Style="{StaticResource CardLift}">
                    <Border Style="{StaticResource CardShadowLayer}" />
                    <Border Style="{StaticResource Card.Flat.Interactive}" Padding="0">
                        <Grid>
                            <!-- üst kenarda durum renginde ince neon çizgi -->
                            <Border Height="2" VerticalAlignment="Top" Margin="22,0" CornerRadius="1"
                                    Background="{Binding Status, Converter={StaticResource StatusBrush}}" Opacity="0.85" />
                            <Grid Margin="22,16,18,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <!-- Başlık + kullanılan gerçek Windows mekanizması -->
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource T.H2}" FontSize="16" TextWrapping="Wrap" />
                                    <Border HorizontalAlignment="Left" Margin="0,8,0,0" Padding="9,3" CornerRadius="6"
                                            Background="{DynamicResource B.CommandBg}" BorderBrush="{DynamicResource B.TileBorder}" BorderThickness="1">
                                        <TextBlock Text="{Binding CommandText}" FontFamily="{StaticResource F.Mono}" FontSize="11.5" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource B.Neon}" />
                                    </Border>

                                    <!-- Açıklama -->
                                    <TextBlock Text="{Binding Description}" FontSize="12" LineHeight="18" TextWrapping="Wrap"
                                               Margin="0,8,0,0" Foreground="{DynamicResource B.Text3}" />

                                    <!-- Durum -->
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="26" Height="26" CornerRadius="13" VerticalAlignment="Top"
                                                Background="{Binding Status, Converter={StaticResource StatusSoftBrush}}">
                                            <TextBlock Tag="{Binding Status}" Text="{Binding Status, Converter={StaticResource StatusGlyph}}"
                                                       Style="{StaticResource T.StatusIcon}" FontSize="12"
                                                       Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding Summary}" Margin="10,2,0,0" FontSize="15" FontWeight="SemiBold"
                                                   TextWrapping="Wrap" Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                    </Grid>

                                    <!-- Gerçek sonuç ayrıntıları / nedeni -->
                                    <TextBlock Text="{Binding Details}" FontSize="12" LineHeight="18" TextWrapping="Wrap" Margin="0,6,0,0"
                                               MaxHeight="90" TextTrimming="CharacterEllipsis" ToolTip="{Binding Details}"
                                               Foreground="{DynamicResource B.Text2}"
                                               Visibility="{Binding Details, Converter={StaticResource Visible}}" />
                                    <TextBlock Text="{Binding Reason}" FontSize="12" LineHeight="17" TextWrapping="Wrap" Margin="0,6,0,0"
                                               MaxHeight="52" TextTrimming="CharacterEllipsis" ToolTip="{Binding Reason}"
                                               Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" Opacity="0.9"
                                               Visibility="{Binding Reason, Converter={StaticResource Visible}}" />

                                    <!-- Canlı ilerleme (yalnızca işlem sürerken) -->
                                    <StackPanel Margin="0,10,0,0" Visibility="{Binding IsBusy, Converter={StaticResource Visible}}">
                                        <TextBlock Text="{Binding ActivityText}" FontSize="11.5" Foreground="{DynamicResource B.Text2}"
                                                   TextTrimming="CharacterEllipsis" Margin="0,0,0,6" />
                                        <ProgressBar Height="6" Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}" Tag="{Binding IsBusy}">
                                            <ProgressBar.Style>
                                                <Style TargetType="ProgressBar" BasedOn="{StaticResource Progress.Neon}">
                                                    <Setter Property="IsIndeterminate" Value="True" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ProgressKnown}" Value="True">
                                                            <Setter Property="IsIndeterminate" Value="False" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ProgressBar.Style>
                                        </ProgressBar>
                                    </StackPanel>

                                    <!-- Çöp Kutusu: "Tümünü Güncelle" ile birlikte boşaltma tercihi -->
                                    <CheckBox Margin="0,12,0,0" FontSize="12.5"
                                              Content="{l:T 'Tümünü Güncelle ile birlikte boşalt', 'Empty together with Update All'}"
                                              IsEnabled="{Binding IsUnavailable, Converter={StaticResource InverseBool}}"
                                              IsChecked="{Binding DataContext.CleanRecycleBin, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <CheckBox.Style>
                                            <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Key}" Value="recyclebin">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </CheckBox.Style>
                                    </CheckBox>

                                    <!-- Son çalıştırılma -->
                                    <Grid Margin="0,12,0,0" Visibility="{Binding HasLastRun, Converter={StaticResource Visible}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE823;" Style="{StaticResource T.Icon}" FontSize="11" Margin="0,1,6,0" VerticalAlignment="Top"
                                                   Foreground="{DynamicResource B.Text3}" />
                                        <TextBlock Grid.Column="1" Text="{Binding LastRunText}" FontSize="11.5" Foreground="{DynamicResource B.Text3}"
                                                   TextWrapping="Wrap" />
                                    </Grid>
                                </StackPanel>

                                <!-- Sağ: ? bilgi · seçim (üstte), kartın kendi işlem butonu + Detaylı Sonuç (altta) -->
                                <DockPanel Grid.Column="1" Margin="20,0,0,0" LastChildFill="False">
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <ToggleButton x:Name="InfoButton" Style="{StaticResource InfoToggle}" VerticalAlignment="Center"
                                                      IsHitTestVisible="{Binding IsOpen, ElementName=InfoPopup, Converter={StaticResource InverseBool}}" />
                                        <Popup x:Name="InfoPopup" PlacementTarget="{Binding ElementName=InfoButton}" Placement="Bottom"
                                               HorizontalOffset="-282" VerticalOffset="2" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
                                               IsOpen="{Binding IsChecked, ElementName=InfoButton, Mode=TwoWay}">
                                            <Border Margin="12" Width="300" CornerRadius="12" Padding="16,14" Background="{DynamicResource B.PopupBg}"
                                                    BorderBrush="{DynamicResource B.Neon}" BorderThickness="1">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.6" Color="{DynamicResource C.Shadow}" />
                                                </Border.Effect>
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="&#xE946;" Style="{StaticResource T.Icon}" FontSize="14" VerticalAlignment="Top"
                                                                   Margin="0,2,10,0" Foreground="{DynamicResource B.Neon}" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource B.Text}" TextWrapping="Wrap" />
                                                    </Grid>
                                                    <TextBlock Text="{Binding InfoText}" FontSize="12.5" LineHeight="19" TextWrapping="Wrap"
                                                               Margin="0,8,0,0" Foreground="{DynamicResource B.Text2}" />
                                                </StackPanel>
                                            </Border>
                                        </Popup>
                                        <CheckBox Style="{StaticResource SelectCheck}" Margin="10,0,0,0"
                                                  IsChecked="{Binding IsSelected}"
                                                  IsEnabled="{Binding IsUnavailable, Converter={StaticResource InverseBool}}"
                                                  ToolTipService.ShowOnDisabled="True" />
                                    </StackPanel>
                                    <Grid DockPanel.Dock="Bottom" Margin="0,16,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button Style="{StaticResource Btn.Secondary}" Height="40" MinWidth="176" Command="{Binding ActionCommand}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding ActionGlyph}" Style="{StaticResource T.Icon}" FontSize="13" Margin="0,0,9,0"
                                                           Foreground="{DynamicResource B.Neon}" />
                                                <TextBlock Text="{Binding ActionText}" FontSize="13.5" />
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="1" Style="{StaticResource Btn.Secondary}" Width="40" Height="40" Padding="0" Margin="8,0,0,0"
                                                Command="{Binding DetailsCommand}" AutomationProperties.Name="{l:T 'Detaylı Sonuç', 'Detailed Result'}"
                                                ToolTip="{l:T 'Detaylı Sonuç – son işlemin gerçek komutları, çıkış kodları ve çıktısı', 'Detailed Result – the real commands, exit codes and output of the last operation'}"
                                                Visibility="{Binding HasLastRun, Converter={StaticResource Visible}}">
                                            <TextBlock Text="&#xE8FD;" Style="{StaticResource T.Icon}" FontSize="14" Foreground="{DynamicResource B.Neon}" />
                                        </Button>
                                    </Grid>
                                </DockPanel>
                            </Grid>
                            <Border Style="{StaticResource SelectedOverlay}" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </DataTemplate>

        <!-- Log listesi öğe kabı (seçim vurgusu yok) -->
        <Style x:Key="LogItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter Margin="0,1" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Kontrol Merkezi ana sayfa öğesi (Monster düzeni): kutusuz; solda parlayan neon simge, sağda kalın beyaz başlık, açıklama ve
             gerçek durum satırı. Keskin görünüm için metnin atasında efekt yoktur (parlama yalnızca simgede, statik). Animasyon yok:
             üzerine gelince yalnızca hafif zemin ve neon kenar belirir. -->
        <Style x:Key="Btn.HomeItem" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="14" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" Padding="14,14,12,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="54" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="icon" Text="{Binding Glyph}" Style="{StaticResource T.Icon}" FontSize="38" VerticalAlignment="Top"
                                           HorizontalAlignment="Left" Margin="0,2,0,0" Foreground="{DynamicResource B.NeonBright}" Effect="{DynamicResource Fx.IconGlow}" />
                                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Top">
                                    <TextBlock x:Name="title" Text="{Binding Title}" FontFamily="{StaticResource F.Display}" FontSize="16.5" FontWeight="Bold"
                                               Foreground="{DynamicResource B.Text}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Description}" FontSize="12.5" LineHeight="17" Foreground="{DynamicResource B.Text2}"
                                               TextWrapping="Wrap" Margin="0,3,0,0" />
                                    <!-- Grid: metin sütun genişliğiyle sınırlanır ve sarılır (yatay StackPanel sonsuz genişlik verip metni kırpıyordu) -->
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="7" Height="7" VerticalAlignment="Top" Margin="0,5,7,0"
                                                 Fill="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                        <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="11.5" LineHeight="16" Foreground="{DynamicResource B.Text3}"
                                                   TextWrapping="Wrap" ToolTip="{Binding StatusText}" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#141FB6FF" />
                                <Setter TargetName="bg" Property="BorderBrush" Value="#552A8FD0" />
                                <Setter TargetName="icon" Property="Foreground" Value="{DynamicResource B.LinkHover}" />
                                <Setter TargetName="title" Property="Foreground" Value="{DynamicResource B.LinkHover}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource B.Neon}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#241FB6FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ana sayfa arama sonucu satırı (simge + başlık + nerede olduğu) -->
        <Style x:Key="Btn.SearchRow" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="9" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" Padding="12,8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource B.HoverFill}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource B.HoverFill}" />
                                <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource B.Neon}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Kategori alt menüsü (Monster tarzı): bölme listesi. Seçili bölmede solda neon çizgi ve vurgulu ikon. -->
        <Style x:Key="SectionNav" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <!-- Kendi kaydırma alanı yok: fare tekerleği sol sütunun kaydırma alanına geçer -->
                        <ItemsPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SectionNavItem" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{DynamicResource B.Text2}" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Height="44" Background="Transparent">
                            <Border x:Name="fill" CornerRadius="10" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" />
                            <Border x:Name="bar" Width="3" CornerRadius="2" Margin="0,11" HorizontalAlignment="Left"
                                    Background="{DynamicResource B.Neon}" Visibility="Hidden" />
                            <StackPanel Orientation="Horizontal" Margin="16,0,10,0" VerticalAlignment="Center">
                                <TextBlock x:Name="icon" Text="{Binding Glyph}" Style="{StaticResource T.Icon}" FontSize="16"
                                           Foreground="{DynamicResource B.Text3}" Margin="0,0,12,0" />
                                <TextBlock x:Name="title" Text="{Binding Title}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="fill" Property="Background" Value="{DynamicResource B.NavHover}" />
                                <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="fill" Property="Background" Value="{DynamicResource B.NavSelected}" />
                                <Setter TargetName="bar" Property="Visibility" Value="Visible" />
                                <Setter TargetName="icon" Property="Foreground" Value="{DynamicResource B.Neon}" />
                                <Setter TargetName="title" Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="fill" Property="BorderBrush" Value="{DynamicResource B.CardBorderHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Açık / kapalı anahtarı (Kolay Ayar satırları). Sürekli animasyon yok; durum metni "Açık" / "Kapalı". -->
        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <TextBlock x:Name="state" Text="{l:T 'Kapalı', 'Off'}" FontSize="12.5" Foreground="{DynamicResource B.Text3}"
                                       VerticalAlignment="Center" Margin="0,0,12,0" />
                            <Grid Width="48" Height="26">
                                <Border x:Name="track" CornerRadius="13" Background="{DynamicResource B.RowBg}" BorderBrush="{DynamicResource B.InputBorder}" BorderThickness="1.5" />
                                <Ellipse x:Name="knob" Width="16" Height="16" HorizontalAlignment="Left" Margin="5,0,0,0" Fill="{DynamicResource B.Gray}" />
                            </Grid>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource B.Neon}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="{DynamicResource B.NeonGradient}" />
                                <Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource B.Neon}" />
                                <Setter TargetName="knob" Property="Fill" Value="White" />
                                <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="knob" Property="Margin" Value="0,0,5,0" />
                                <Setter TargetName="state" Property="Text" Value="{l:T 'Açık', 'On'}" />
                                <Setter TargetName="state" Property="Foreground" Value="{DynamicResource B.Text}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource B.Neon}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cihaz Bilgileri kartı: solda büyük donanım ikonu, sağda başlık + sistem bilgisi alanları -->
        <DataTemplate x:Key="DeviceSectionTemplate" DataType="{x:Type vm:DeviceInfoSectionViewModel}">
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource IconTile}">
                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource T.TileIcon}" />
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="22,16,22,10">
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource T.H2}" FontSize="16" />
                        <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding Fields}" ItemTemplate="{StaticResource SystemInfoRowTemplate}" />
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- Cihaz Durumu halka göstergesi (değer yoksa "—" ve "okunamıyor"; neden araç ipucunda) -->
        <DataTemplate x:Key="GaugeTemplate" DataType="{x:Type vm:DeviceGaugeViewModel}">
            <StackPanel Width="120" Margin="0,0,16,0" ToolTip="{Binding ToolTipText}" ToolTipService.ShowOnDisabled="True">
                <Grid Width="104" Height="104">
                    <views:RingGauge Ratio="{Binding Ratio}" Thickness="6" TrackBrush="{DynamicResource B.GaugeTrack}">
                        <views:RingGauge.Style>
                            <Style TargetType="views:RingGauge">
                                <Setter Property="FillBrush" Value="{DynamicResource B.Neon}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Level}" Value="warm">
                                        <Setter Property="FillBrush" Value="{DynamicResource B.Orange}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Level}" Value="hot">
                                        <Setter Property="FillBrush" Value="{DynamicResource B.Red}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </views:RingGauge.Style>
                    </views:RingGauge>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DisplayValue}" FontFamily="{StaticResource F.Display}" FontSize="26" FontWeight="SemiBold"
                                   Foreground="{DynamicResource B.Text}" />
                        <TextBlock Text="{Binding DisplayUnit}" FontSize="12" Margin="3,0,0,5" VerticalAlignment="Bottom"
                                   Foreground="{DynamicResource B.Text2}" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="{Binding CaptionText}" FontSize="12" Margin="0,7,0,0" HorizontalAlignment="Center" TextAlignment="Center"
                           TextWrapping="Wrap" Foreground="{DynamicResource B.Text2}" />
            </StackPanel>
        </DataTemplate>

        <!-- Cihaz Durumu satırı: başlık (+ aygıt adı) ve göstergeler / açıklama -->
        <DataTemplate x:Key="DeviceStatusRowTemplate" DataType="{x:Type vm:DeviceStatusRowViewModel}">
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding Title}" FontSize="15.5" FontWeight="SemiBold" Foreground="{DynamicResource B.Text}" />
                    <TextBlock Text="{Binding Subtitle}" FontSize="11.5" Margin="0,3,0,0" TextWrapping="Wrap" Foreground="{DynamicResource B.Text3}"
                               Visibility="{Binding Subtitle, Converter={StaticResource Visible}}" />
                </StackPanel>
                <ItemsControl Grid.Column="1" ItemsSource="{Binding Gauges}" ItemTemplate="{StaticResource GaugeTemplate}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <Border Grid.Column="1" Visibility="{Binding HasNote, Converter={StaticResource Visible}}" HorizontalAlignment="Left"
                        CornerRadius="10" Padding="14,10" Background="{DynamicResource B.ChipBg}" BorderBrush="{DynamicResource B.Border}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE946;" Style="{StaticResource T.Icon}" FontSize="13" Foreground="{DynamicResource B.Text3}"
                                   VerticalAlignment="Top" Margin="0,2,10,0" />
                        <TextBlock Text="{Binding Note}" FontSize="12.5" LineHeight="18" TextWrapping="Wrap" MaxWidth="560"
                                   Foreground="{DynamicResource B.Text2}" />
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- Seçili bölmenin içeriği: Visibility="{Binding CurrentSectionKey, Converter={StaticResource SectionVisible}, ConverterParameter=anahtar}" -->
        <views:EqualsToVisibilityConverter x:Key="SectionVisible" />

        <!-- ================= Hız Testi ================= -->
        <!-- Gösterge dolgu renkleri: indirme neon mavi, yükleme ikinci neon (tasarım paletinden) -->
        <LinearGradientBrush x:Key="B.SpeedDown" StartPoint="0,1" EndPoint="1,0">
            <GradientStop Color="#FF0E8FD6" Offset="0" />
            <GradientStop Color="#FF1FB6FF" Offset="0.5" />
            <GradientStop Color="#FF7FE0FF" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="B.SpeedUp" StartPoint="0,1" EndPoint="1,0">
            <GradientStop Color="#FF2A4FD6" Offset="0" />
            <GradientStop Color="#FF3D6BFF" Offset="0.5" />
            <GradientStop Color="#FF8FA8FF" Offset="1" />
        </LinearGradientBrush>

        <!-- BAŞLAT düğmesi (büyük neon halka). Sürekli animasyon yok; parlama statik katmandadır. -->
        <Style x:Key="Btn.SpeedGo" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="root" Width="196" Height="196" RenderTransformOrigin="0.5,0.5" Background="Transparent">
                            <Grid.RenderTransform><ScaleTransform /></Grid.RenderTransform>
                            <Ellipse x:Name="glow" Stroke="{DynamicResource B.Neon}" StrokeThickness="3" Opacity="0.5" IsHitTestVisible="False"
                                     Effect="{DynamicResource Fx.NeonGlow}" />
                            <Ellipse x:Name="ring" Stroke="{DynamicResource B.Neon}" StrokeThickness="2.5">
                                <Ellipse.Fill>
                                    <DynamicResource ResourceKey="B.GoFill" />
                                </Ellipse.Fill>
                            </Ellipse>
                            <TextBlock x:Name="label" Text="{l:T 'BAŞLAT', 'START'}" FontFamily="{StaticResource F.Display}" FontSize="30" FontWeight="SemiBold"
                                       Foreground="{DynamicResource B.Text}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ring" Property="StrokeThickness" Value="4" />
                                <Setter TargetName="glow" Property="Opacity" Value="0.95" />
                                <Setter TargetName="label" Property="Foreground" Value="{DynamicResource B.LinkHover}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ring" Property="StrokeThickness" Value="4" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="root" Property="RenderTransform">
                                    <Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97" /></Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ring" Property="Stroke" Value="{DynamicResource B.BorderHi}" />
                                <Setter TargetName="glow" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="label" Property="Foreground" Value="{DynamicResource B.Text3}" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sunucu listesi satırı ("Istanbul - Turkcell"): seçili sunucuda solda neon çizgi ve dolgu (Speedtest sunucu listesi düzeni) -->
        <Style x:Key="Btn.ServerRow" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{DynamicResource B.Text2}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid MinHeight="44" Background="Transparent">
                            <Border x:Name="fill" CornerRadius="9" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" />
                            <Border x:Name="bar" Width="3" CornerRadius="2" Margin="0,11" HorizontalAlignment="Left"
                                    Background="{DynamicResource B.Neon}" Visibility="Hidden" />
                            <ContentPresenter Margin="16,8,12,8" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="fill" Property="Background" Value="{DynamicResource B.NavHover}" />
                                <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="fill" Property="Background" Value="{DynamicResource B.NavSelected}" />
                                <Setter TargetName="bar" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
                            </DataTrigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="fill" Property="BorderBrush" Value="{DynamicResource B.CardBorderHover}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- Kullanım uygunluğu: ikon + 5 nokta + ad (puan ölçülen değerlerden; eşikler araç ipucunda) -->
        <DataTemplate x:Key="UsageRatingTemplate" DataType="{x:Type vm:UsageRatingViewModel}">
            <StackPanel Width="112" Margin="0,0,6,0" Background="Transparent" ToolTip="{Binding Detail}" ToolTipService.ShowDuration="30000">
                <TextBlock Text="{Binding Glyph}" Style="{StaticResource T.Icon}" FontSize="24" Foreground="{DynamicResource B.Text2}"
                           HorizontalAlignment="Center" />
                <ItemsControl ItemsSource="{Binding Dots}" HorizontalAlignment="Center" Margin="0,9,0,0" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Ellipse Width="6" Height="6" Margin="2,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource B.BorderHi}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource B.Text}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding Title}" FontSize="11.5" Foreground="{DynamicResource B.Text3}" HorizontalAlignment="Center"
                           TextAlignment="Center" TextWrapping="Wrap" Margin="0,7,0,0" />
            </StackPanel>
        </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ================= Arka plan: gradyan + neon ışıklar =================
             Performans: ışıklar statiktir ve katman BitmapCache ile bir kez çizilip önbellekten kullanılır.
             (Önceki sonsuz saydamlık animasyonu, büyük bulanıklık efektleri nedeniyle her karede tüm pencereyi yeniden çizdiriyordu.) -->
        <Rectangle Grid.RowSpan="2" Fill="{DynamicResource B.WindowBg}" />
        <Canvas Grid.RowSpan="2" ClipToBounds="True" IsHitTestVisible="False">
            <Canvas.CacheMode>
                <BitmapCache EnableClearType="False" RenderAtScale="1" SnapsToDevicePixels="False" />
            </Canvas.CacheMode>
            <Ellipse Width="620" Height="620" Canvas.Left="-220" Canvas.Top="-260" Fill="#FF1FB6FF" Opacity="0.05">
                <Ellipse.Effect><BlurEffect Radius="160" /></Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="700" Height="700" Canvas.Right="-260" Canvas.Bottom="-320" Fill="#FF3D6BFF" Opacity="0.04">
                <Ellipse.Effect><BlurEffect Radius="180" /></Ellipse.Effect>
            </Ellipse>
        </Canvas>
        <!-- Ana sayfa: alt kısımda ince dalga çizgileri (statik, bir kez çizilir; yalnızca Kontrol Merkezi ana sayfasında) -->
        <views:WaveBackdrop x:Name="HomeWaves" Grid.RowSpan="2" IsHitTestVisible="False" LineBrush="{DynamicResource B.WaveLine}"
                            Visibility="{Binding IsHomeScreen, Converter={StaticResource Visible}}">
            <views:WaveBackdrop.CacheMode>
                <BitmapCache EnableClearType="False" RenderAtScale="1" SnapsToDevicePixels="False" />
            </views:WaveBackdrop.CacheMode>
        </views:WaveBackdrop>

        <!-- ================= Başlık çubuğu ================= -->
        <Grid Grid.Row="0" Background="Transparent">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <Rectangle Width="18" Height="18" RadiusX="4" RadiusY="4" Fill="{StaticResource LogoBrush}" />
                <TextBlock Text="{x:Static core:AppInfo.Name}" Margin="10,0,0,0" FontSize="12.5" Foreground="{DynamicResource B.Text2}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding AppVersion}" Margin="8,0,0,0" FontSize="11.5" Foreground="{DynamicResource B.Text3}" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Style="{StaticResource Btn.Caption}" Content="&#xE921;" Click="Minimize_Click" ToolTip="{l:T 'Simge durumuna küçült', 'Minimize'}" />
                <Button x:Name="MaxButton" Style="{StaticResource Btn.Caption}" Content="&#xE922;" Click="Maximize_Click" ToolTip="{l:T 'Büyüt', 'Maximize'}" />
                <Button Style="{StaticResource Btn.CaptionClose}" Content="&#xE8BB;" Click="Close_Click" ToolTip="{l:T 'Kapat', 'Close'}" />
            </StackPanel>
        </Grid>

        <!-- ================= İçerik ================= -->
        <Grid x:Name="ContentHost" Grid.Row="1">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Dialog.IsOpen}" Value="True">
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <BlurEffect Radius="8" />
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                        <!-- İnternet yokken arkadaki içerik bulanık ve devre dışı (klavyeyle de ulaşılamaz) -->
                        <DataTrigger Binding="{Binding ShowOfflineOverlay}" Value="True">
                            <Setter Property="IsEnabled" Value="False" />
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <BlurEffect Radius="8" />
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                        <!-- Zorunlu güncelleme penceresi açıkken arkadaki içerik bulanık ve devre dışı (klavyeyle de ulaşılamaz) -->
                        <DataTrigger Binding="{Binding ShowUpdateOverlay}" Value="True">
                            <Setter Property="IsEnabled" Value="False" />
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <BlurEffect Radius="8" />
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <!-- ============ SAYFA 1: SİSTEM GEREKSİNİMLERİ ============ -->
            <Grid x:Name="RequirementsPage" Visibility="{Binding IsRequirementsPage, Converter={StaticResource Visible}}">
                <Grid.RenderTransform><TranslateTransform /></Grid.RenderTransform>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Style="{StaticResource Card}" Width="600" Padding="40,36" Margin="0,10,0,40"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel>
                            <Grid HorizontalAlignment="Center" Width="96" Height="96">
                                <Border CornerRadius="24" Background="{DynamicResource B.NeonGradient}" Opacity="0.45" Margin="6">
                                    <Border.Effect><BlurEffect Radius="30" /></Border.Effect>
                                </Border>
                                <Rectangle RadiusX="22" RadiusY="22" Fill="{StaticResource LogoBrush}" Stroke="{DynamicResource B.BorderHi}" StrokeThickness="1" />
                            </Grid>
                            <TextBlock Text="{x:Static core:AppInfo.Name}" Style="{StaticResource T.H1}" HorizontalAlignment="Center" Margin="0,22,0,6" />
                            <TextBlock Text="{l:T 'Windows 11 ve NVIDIA RTX sistemler için güncelleme merkezi', 'Update center for Windows 11 and NVIDIA RTX systems'}" Style="{StaticResource T.Body}"
                                       HorizontalAlignment="Center" TextAlignment="Center" />

                            <TextBlock Text="{l:T 'SİSTEM GEREKSİNİMLERİ', 'SYSTEM REQUIREMENTS'}" Style="{StaticResource T.Label}" Margin="2,32,0,12" />
                            <ItemsControl ItemsSource="{Binding Requirements}" ItemTemplate="{StaticResource RequirementRowTemplate}" />

                            <!-- Desteklenmiyor -->
                            <Border Visibility="{Binding ShowUnsupported, Converter={StaticResource Visible}}"
                                    Background="#1FFF4D61" BorderBrush="#66FF4D61" BorderThickness="1" CornerRadius="11" Padding="16,14" Margin="0,6,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE7BA;" Style="{StaticResource T.Icon}" FontSize="18" Foreground="{DynamicResource B.Red}" VerticalAlignment="Top" Margin="0,1,12,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding UnsupportedMessage}" Style="{StaticResource T.Body}" Foreground="{DynamicResource B.Text}" />
                                </Grid>
                            </Border>

                            <!-- İnternet yok: uygulamaya girilemez (KULLANICI KARARI 2026-09-27) -->
                            <Border x:Name="NoInternetBox" Visibility="{Binding ShowNoInternet, Converter={StaticResource Visible}}"
                                    Background="#1FFF4D61" BorderBrush="#66FF4D61" BorderThickness="1" CornerRadius="11" Padding="16,14" Margin="0,6,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE774;" Style="{StaticResource T.Icon}" FontSize="18" Foreground="{DynamicResource B.Red}" VerticalAlignment="Top" Margin="0,1,12,0" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Style="{StaticResource T.Body}" Foreground="{DynamicResource B.Text}"
                                                   Text="{l:T 'İnternet bağlantısı gerekli; bağlantı olmadan uygulamaya girilemez. Wi-Fi veya Ethernet bağlantınızı kontrol edin; bağlantı gelince bu ekran kendiliğinden yenilenir.', 'An internet connection is required; the app cannot be used without one. Check your Wi-Fi or Ethernet connection; this screen refreshes automatically when the connection is back.'}" />
                                        <TextBlock Text="{Binding OfflineDetailText}" FontSize="12" Foreground="{DynamicResource B.Text2}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                    </StackPanel>
                                    <Button x:Name="RetryInternetButton" Grid.Column="2" Style="{StaticResource Btn.Secondary}" Height="38" Margin="12,0,0,0"
                                            VerticalAlignment="Top" Command="{Binding RetryInternetCommand}" AutomationProperties.Name="{Binding RetryInternetText}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE72C;" Style="{StaticResource T.Icon}" FontSize="14" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding RetryInternetText}" FontSize="13" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- RTX yok: uygulama kartsız kullanılabilir (yalnızca NVIDIA Driver kartı kullanım dışı) -->
                            <Border Visibility="{Binding ShowNoRtx, Converter={StaticResource Visible}}"
                                    Background="#14FFA63D" BorderBrush="#55FFA63D" BorderThickness="1" CornerRadius="11" Padding="16,14" Margin="0,6,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE7F4;" Style="{StaticResource T.Icon}" FontSize="18" Foreground="{DynamicResource B.Orange}" VerticalAlignment="Top" Margin="0,1,12,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding NoRtxMessage}" Style="{StaticResource T.Body}" Foreground="{DynamicResource B.Text}" />
                                </Grid>
                            </Border>

                            <!-- Yönetici değil -->
                            <Border Visibility="{Binding ShowElevate, Converter={StaticResource Visible}}"
                                    Background="#14FFA63D" BorderBrush="#55FFA63D" BorderThickness="1" CornerRadius="11" Padding="16,14" Margin="0,6,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xEA18;" Style="{StaticResource T.Icon}" FontSize="18" Foreground="{DynamicResource B.Orange}" Margin="0,0,12,0" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource T.Body}" Foreground="{DynamicResource B.Text}" VerticalAlignment="Center"
                                               Text="{l:T 'Kontrol ve güncelleme için yönetici izni gerekir. Yönetici olmadan girerseniz tüm kartlar kullanım dışı olur.', 'Checks and updates require administrator permission. If you continue without it, all cards will be unavailable.'}" />
                                    <Button Grid.Column="2" Style="{StaticResource Btn.Secondary}" Height="38" Margin="12,0,0,0" Command="{Binding ElevateCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE7EF;" Style="{StaticResource T.Icon}" FontSize="14" Margin="0,0,8,0" />
                                            <TextBlock Text="{l:T 'Yönetici olarak başlat', 'Start as administrator'}" FontSize="13" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <CheckBox x:Name="AcceptCheck" Margin="2,24,0,0" IsChecked="{Binding Accepted}" IsEnabled="{Binding IsSupported}"
                                      AutomationProperties.Name="{l:T 'Gereksinimleri, Kullanım Koşulları\'nı ve Gizlilik Politikası\'nı kabul ediyorum', 'I accept the requirements, the Terms of Use and the Privacy Policy'}">
                                <TextBlock Text="{l:T 'Gereksinimleri, Kullanım Koşulları\'nı ve Gizlilik Politikası\'nı kabul ediyorum', 'I accept the requirements, the Terms of Use and the Privacy Policy'}" TextWrapping="Wrap" />
                            </CheckBox>
                            <!-- v1.9.0 yasal belgeler: bağlantılar kutunun dışında (tıklamak kutuyu değiştirmez); yalnızca izin listesindeki adresler -->
                            <WrapPanel Margin="22,6,0,0">
                                <Button x:Name="ReqTermsLink" Style="{StaticResource Btn.Link}" FontSize="12.5" Margin="0,0,4,0" Content="{l:T 'Kullanım Koşulları', 'Terms of Use'}"
                                        Command="{Binding OpenLegalLinkCommand}" CommandParameter="{x:Static core:AppInfo.TermsUrlLocal}" ToolTip="{x:Static core:AppInfo.TermsUrlLocal}" />
                                <Button x:Name="ReqPrivacyLink" Style="{StaticResource Btn.Link}" FontSize="12.5" Margin="0,0,4,0" Content="{l:T 'Gizlilik Politikası', 'Privacy Policy'}"
                                        Command="{Binding OpenLegalLinkCommand}" CommandParameter="{x:Static core:AppInfo.PrivacyPolicyUrlLocal}" ToolTip="{x:Static core:AppInfo.PrivacyPolicyUrlLocal}" />
                                <Button Style="{StaticResource Btn.Link}" FontSize="12.5" Margin="0,0,4,0" Content="{l:T 'Terms of Use', 'Kullanım Koşulları (Türkçe)'}"
                                        Command="{Binding OpenLegalLinkCommand}" CommandParameter="{x:Static core:AppInfo.TermsUrlOther}" ToolTip="{x:Static core:AppInfo.TermsUrlOther}" />
                                <Button Style="{StaticResource Btn.Link}" FontSize="12.5" Content="{l:T 'Privacy Policy', 'Gizlilik Politikası (Türkçe)'}"
                                        Command="{Binding OpenLegalLinkCommand}" CommandParameter="{x:Static core:AppInfo.PrivacyPolicyUrlOther}" ToolTip="{x:Static core:AppInfo.PrivacyPolicyUrlOther}" />
                            </WrapPanel>

                            <Button Style="{StaticResource Btn.Primary}" Margin="0,22,0,0" Command="{Binding ContinueCommand}"
                                    Visibility="{Binding ShowContinue, Converter={StaticResource Visible}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{l:T 'Devam Et', 'Continue'}" />
                                    <TextBlock Text="&#xE72A;" Style="{StaticResource T.Icon}" FontSize="14" Margin="12,1,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Btn.Primary}" Margin="0,22,0,0" Command="{Binding ContinueWithoutGpuCommand}"
                                    Visibility="{Binding ShowNoRtx, Converter={StaticResource Visible}}"
                                    ToolTip="{l:T 'NVIDIA Driver kartı kullanım dışı olur; diğer tüm işlemler normal çalışır.', 'The NVIDIA Driver card will be unavailable; everything else works normally.'}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{l:T 'Kartsız Devam Et', 'Continue without RTX'}" />
                                    <TextBlock Text="&#xE72A;" Style="{StaticResource T.Icon}" FontSize="14" Margin="12,1,0,0" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </Grid>

            <!-- ============ SAYFA 2: ANA EKRAN – KONTROL MERKEZİ ============
                 Ana sayfa: 7 kategori (üstte 4, altta 3). Kategori ekranı: solda Ana Sayfa + kategori başlığı + bölmeler (+ İlerleme),
                 sağda seçili bölmenin içeriği. Yalnızca düzen değişti: kartlar, komutlar ve veriler aynıdır. -->
            <Grid x:Name="DashboardPage" Visibility="{Binding IsDashboard, Converter={StaticResource Visible}}" Margin="28,6,28,24">
                <Grid.RenderTransform><TranslateTransform /></Grid.RenderTransform>

                <!-- ===================== ANA SAYFA (KONTROL MERKEZİ) ===================== -->
                <Grid x:Name="HomeView" Visibility="{Binding IsHome, Converter={StaticResource Visible}}">
                    <Grid.RenderTransform><TranslateTransform /></Grid.RenderTransform>
                    <ScrollViewer x:Name="HomeScroll" VerticalScrollBarVisibility="Auto">
                        <Grid MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                            <StackPanel MaxWidth="1056" VerticalAlignment="Center" Margin="0,0,0,8">
                                <!-- Logo: neon parlama (radyal gradyan; bulanıklık yok, keskin) + neon çerçeve -->
                                <Grid HorizontalAlignment="Center" Width="200" Height="136" Margin="0,-6,0,0">
                                    <Ellipse IsHitTestVisible="False">
                                        <Ellipse.Fill>
                                            <RadialGradientBrush>
                                                <GradientStop Color="#591FB6FF" Offset="0" />
                                                <GradientStop Color="#1A1FB6FF" Offset="0.5" />
                                                <GradientStop Color="#001FB6FF" Offset="1" />
                                            </RadialGradientBrush>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <Border x:Name="HomeLogo" Width="92" Height="92" CornerRadius="24" BorderThickness="1.5" BorderBrush="{DynamicResource B.NeonBright}"
                                            Effect="{DynamicResource Fx.IconGlow}">
                                        <Rectangle RadiusX="22" RadiusY="22" Fill="{StaticResource LogoBrush}" />
                                    </Border>
                                </Grid>
                                <TextBlock Text="{x:Static core:AppInfo.Name}" FontFamily="{StaticResource F.Display}" FontSize="31" Foreground="{DynamicResource B.Text}"
                                           HorizontalAlignment="Center" Margin="0,6,0,4" />
                                <TextBlock Text="{l:T 'KONTROL MERKEZİ', 'CONTROL CENTER'}" Style="{StaticResource T.Label}" FontSize="11.5" Foreground="{DynamicResource B.NeonBright}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding PlatformText}" FontSize="12" Foreground="{DynamicResource B.Text3}"
                                           HorizontalAlignment="Center" Margin="0,6,0,0" />

                                <!-- Ara: kategori, bölme ve kart adlarında arar; sonuç seçilince ilgili bölme açılır (Enter = ilk sonuç, Esc = temizle) -->
                                <Grid HorizontalAlignment="Center" Width="400" Height="44" Margin="0,24,0,0">
                                    <!-- neon parlama ayrı ve statik katmanda (imleç yanıp sönerken efekt yeniden hesaplanmaz) -->
                                    <Border CornerRadius="22" BorderBrush="{DynamicResource B.Neon}" BorderThickness="1.5" IsHitTestVisible="False"
                                            Effect="{DynamicResource Fx.SoftGlow}" />
                                    <Border x:Name="HomeSearchFrame" CornerRadius="22" BorderBrush="{DynamicResource B.NeonBright}" BorderThickness="1.5">
                                        <Border.Background>
                                            <DynamicResource ResourceKey="B.SearchBg" />
                                        </Border.Background>
                                        <Grid>
                                            <TextBox x:Name="HomeSearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Margin="20,0,46,0"
                                                     Background="Transparent" BorderThickness="0" Foreground="{DynamicResource B.Text}" CaretBrush="{DynamicResource B.NeonBright}"
                                                     FontSize="14" VerticalContentAlignment="Center" AutomationProperties.Name="{l:T 'Ara', 'Search'}"
                                                     ToolTip="{l:T 'Kategori, bölme veya kart ara (Ctrl+F)', 'Search categories, sections or cards (Ctrl+F)'}">
                                                <TextBox.InputBindings>
                                                    <KeyBinding Key="Enter" Command="{Binding OpenFirstSearchResultCommand}" />
                                                </TextBox.InputBindings>
                                            </TextBox>
                                            <TextBlock Text="{l:T 'Ara', 'Search'}" FontSize="14" Foreground="{DynamicResource B.Text3}" Margin="23,0,0,0" VerticalAlignment="Center"
                                                       IsHitTestVisible="False" Visibility="{Binding SearchText, Converter={StaticResource Hidden}}" />
                                            <TextBlock Text="&#xE721;" Style="{StaticResource T.Icon}" FontSize="16" Foreground="{DynamicResource B.NeonBright}"
                                                       HorizontalAlignment="Right" Margin="0,0,18,0" IsHitTestVisible="False"
                                                       Visibility="{Binding SearchText, Converter={StaticResource Hidden}}" />
                                            <Button Style="{StaticResource Btn.Link}" HorizontalAlignment="Right" Margin="0,0,10,0" Command="{Binding ClearSearchCommand}"
                                                    ToolTip="{l:T 'Aramayı temizle (Esc)', 'Clear search (Esc)'}" AutomationProperties.Name="{l:T 'Aramayı temizle', 'Clear search'}"
                                                    Visibility="{Binding SearchText, Converter={StaticResource Visible}}">
                                                <TextBlock Text="&#xE711;" Style="{StaticResource T.Icon}" FontSize="12" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                    <Popup x:Name="HomeSearchPopup" PlacementTarget="{Binding ElementName=HomeSearchFrame}" Placement="Bottom" VerticalOffset="8"
                                           HorizontalOffset="-30" Width="460" AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade"
                                           IsOpen="{Binding IsSearchOpen, Mode=TwoWay}">
                                        <Border Margin="0,0,0,14" CornerRadius="14" Background="{DynamicResource B.MenuBg}" BorderBrush="{DynamicResource B.BorderHi}" BorderThickness="1" Padding="8">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.7" Color="{DynamicResource C.Shadow}" />
                                            </Border.Effect>
                                            <StackPanel>
                                                <ItemsControl x:Name="HomeSearchResults" ItemsSource="{Binding SearchResults}" Focusable="False">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:SearchResultViewModel}">
                                                            <Button Style="{StaticResource Btn.SearchRow}" AutomationProperties.Name="{Binding Title}"
                                                                    Command="{Binding DataContext.OpenSearchResultCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="34" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource T.Icon}" FontSize="17" HorizontalAlignment="Left"
                                                                               Foreground="{DynamicResource B.NeonBright}" />
                                                                    <StackPanel Grid.Column="1">
                                                                        <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource B.Text}"
                                                                                   TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock Text="{Binding Subtitle}" FontSize="11.5" Foreground="{DynamicResource B.Text3}" Margin="0,1,0,0"
                                                                                   TextTrimming="CharacterEllipsis" />
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Text="{l:T 'Sonuç bulunamadı.', 'No results found.'}" FontSize="12.5" Foreground="{DynamicResource B.Text3}" Margin="12,8"
                                                           Visibility="{Binding ShowNoSearchResults, Converter={StaticResource Visible}}" />
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </Grid>

                                <!-- Yönetici değil: tüm kartlar kullanım dışı (yetki yalnızca UAC onayıyla yeniden başlatarak alınır) -->
                                <Border Visibility="{Binding ShowElevate, Converter={StaticResource Visible}}" HorizontalAlignment="Center" MaxWidth="780"
                                        Background="#14FFA63D" BorderBrush="#55FFA63D" BorderThickness="1" CornerRadius="11" Padding="16,10" Margin="10,16,10,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xEA18;" Style="{StaticResource T.Icon}" FontSize="16" Foreground="{DynamicResource B.Orange}" Margin="0,0,12,0" />
                                        <TextBlock Grid.Column="1" FontSize="12.5" LineHeight="18" TextWrapping="Wrap" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource B.Text}"
                                                   Text="{l:T 'Yönetici yetkisi yok: tüm kartlar kullanım dışı. Kontrol ve güncelleme için uygulamayı yönetici olarak yeniden başlatın.', 'No administrator rights: all cards are unavailable. Restart the app as administrator to run checks and updates.'}" />
                                        <Button Grid.Column="2" Style="{StaticResource Btn.Secondary}" Height="36" Margin="14,0,0,0" Command="{Binding ElevateCommand}"
                                                ToolTip="{l:T 'Uygulama UAC onayıyla yönetici olarak yeniden açılır; onay vermezseniz hiçbir şey değişmez.', 'The app reopens as administrator after UAC approval; if you decline, nothing changes.'}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE7EF;" Style="{StaticResource T.Icon}" FontSize="14" Margin="0,0,8,0" />
                                                <TextBlock Text="{l:T 'Yönetici olarak yeniden başlat', 'Restart as administrator'}" FontSize="13" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- 8 kategori: üstte 4, altta 4 (ortalı) -->
                                <ItemsControl x:Name="HomeCategories" ItemsSource="{Binding Categories}" Margin="0,30,0,6" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <views:CenteredWrapPanel ItemWidth="264" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:CategoryViewModel}">
                                            <Button Style="{StaticResource Btn.HomeItem}" Command="{Binding OpenCommand}"
                                                    AutomationProperties.Name="{Binding Title}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Hızlı işlemler + işlem durumu (mevcut komutlar ve gerçek durum) -->
                                <Grid Margin="10,8,10,0">
                                    <Border Style="{StaticResource CardShadowLayer}" />
                                    <Border Style="{StaticResource Card.Flat}" Padding="18,14">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button Style="{StaticResource Btn.Primary}" Height="48" MinWidth="200" Command="{Binding StartCheckCommand}"
                                                    ToolTip="{l:T 'Tüm kartları kontrol eder (seçimlere bakılmaz).', 'Checks all cards (selections are ignored).'}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE721;" Style="{StaticResource T.Icon}" FontSize="15" Margin="0,0,10,0" />
                                                    <TextBlock Text="{l:T 'Tümünü Kontrol Et', 'Check All'}" />
                                                </StackPanel>
                                            </Button>
                                            <Button Grid.Column="1" Style="{StaticResource Btn.Accent}" Height="48" MinWidth="200" Margin="12,0,0,0"
                                                    Command="{Binding UpdateAllCommand}" ToolTip="{l:T 'Kontrolde işlem gerektiren tüm kartları işler.', 'Runs every card that needs action according to the check.'}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE896;" Style="{StaticResource T.Icon}" FontSize="15" Margin="0,0,10,0" />
                                                    <TextBlock Text="{Binding UpdateAllText}" />
                                                </StackPanel>
                                            </Button>
                                            <StackPanel Grid.Column="2" Margin="20,0,0,0" VerticalAlignment="Center">
                                                <DockPanel LastChildFill="True">
                                                    <TextBlock DockPanel.Dock="Right" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource B.Neon}"
                                                               Margin="10,0,0,0" Text="{Binding Progress, StringFormat={l:T '%{0:0}', '{}{0:0}%'}}" />
                                                    <TextBlock Text="{Binding OperationStateText}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding OperationState}" Value="Completed">
                                                                        <Setter Property="Foreground" Value="{DynamicResource B.Green}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding OperationState}" Value="Failed">
                                                                        <Setter Property="Foreground" Value="{DynamicResource B.Red}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding OperationState}" Value="Cancelled">
                                                                        <Setter Property="Foreground" Value="{DynamicResource B.Orange}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsOperationRunning}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource B.Neon}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </DockPanel>
                                                <!-- İşlem sürerken gerçek adım, boştayken uygulanabilir işlem özeti -->
                                                <TextBlock FontSize="11.5" Margin="0,3,0,0" Foreground="{DynamicResource B.Text2}" TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="{Binding AvailableSummary}" />
                                                            <Setter Property="ToolTip" Value="{Binding AvailableSummary}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsOperationRunning}" Value="True">
                                                                    <Setter Property="Text" Value="{Binding StepText}" />
                                                                    <Setter Property="ToolTip" Value="{Binding StepText}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <ProgressBar Style="{StaticResource Progress.Neon}" Margin="0,9,0,0" Minimum="0" Maximum="100"
                                                             Tag="{Binding IsOperationRunning}" Value="{Binding Progress, Mode=OneWay}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>

                <!-- ===================== KATEGORİ EKRANI (Monster düzeni) =====================
                     Solda Ana Sayfa + kategori başlığı + bölmeler (alt menü) + İlerleme; sağda seçili bölmenin başlığı ve içeriği.
                     Satırlar Cihaz Bilgileri'ndeki gibi: solda büyük ikon karosu, sağda geniş kart. Kartlar, komutlar ve veriler aynıdır. -->
                <Grid x:Name="CategoryView" Visibility="{Binding IsHome, Converter={StaticResource Hidden}}">
                    <Grid.RenderTransform><TranslateTransform /></Grid.RenderTransform>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Sol sütun: Ana Sayfa + kategori başlığı + bölmeler + (yönetici uyarısı, İlerleme) -->
                    <ScrollViewer x:Name="LeftScroll" Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,-8,0" Padding="0,0,8,0">
                        <StackPanel>
                            <Button Style="{StaticResource Btn.Ghost}" HorizontalAlignment="Left" Height="34" Padding="10,0" Margin="0,2,0,12"
                                    Command="{Binding GoHomeCommand}" ToolTip="{l:T 'Kontrol Merkezi\'ne dön (Esc)', 'Back to Control Center (Esc)'}" AutomationProperties.Name="{l:T 'Ana Sayfa', 'Home'}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE80F;" Style="{StaticResource T.Icon}" FontSize="14" Margin="0,0,9,0" Foreground="{DynamicResource B.Neon}" />
                                    <TextBlock Text="{l:T 'Ana Sayfa', 'Home'}" FontSize="13" />
                                </StackPanel>
                            </Button>

                            <Grid Margin="4,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconBadge}" Width="52" Height="52" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding CurrentCategory.Glyph}" Style="{StaticResource T.Icon}" FontSize="22"
                                               Foreground="{DynamicResource B.Neon}" Effect="{DynamicResource Fx.SoftGlow}" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CurrentCategory.Title}" Style="{StaticResource T.H1}" FontSize="22" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding CurrentCategory.Description}" FontSize="12" Foreground="{DynamicResource B.Text3}"
                                               Margin="0,3,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>

                            <!-- Bölmeler (alt menü) -->
                            <ListBox x:Name="SectionList" Style="{StaticResource SectionNav}" ItemContainerStyle="{StaticResource SectionNavItem}"
                                     ItemsSource="{Binding CurrentCategory.Sections}" SelectedItem="{Binding CurrentSection, Mode=TwoWay}"
                                     AutomationProperties.Name="{l:T 'Bölmeler', 'Sections'}" />

                            <!-- İşlem başlatılabilen kategorilerde: yönetici uyarısı + İlerleme -->
                            <StackPanel Margin="0,18,0,4" Visibility="{Binding ShowProgressPanel, Converter={StaticResource Visible}}">
                                <!-- Yönetici değil: tüm kartlar kullanım dışı; yetki yalnızca UAC onayıyla yeniden başlatarak alınır -->
                                <Border Visibility="{Binding ShowElevate, Converter={StaticResource Visible}}"
                                        Background="#14FFA63D" BorderBrush="#55FFA63D" BorderThickness="1" CornerRadius="11" Padding="14,12" Margin="0,0,0,18">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="&#xEA18;" Style="{StaticResource T.Icon}" FontSize="16" Foreground="{DynamicResource B.Orange}"
                                                       VerticalAlignment="Top" Margin="0,1,10,0" />
                                            <TextBlock Grid.Column="1" FontSize="12.5" LineHeight="18" TextWrapping="Wrap" Foreground="{DynamicResource B.Text}"
                                                       Text="{l:T 'Yönetici yetkisi yok: tüm kartlar kullanım dışı. Kontrol ve güncelleme için uygulamayı yönetici olarak yeniden başlatın.', 'No administrator rights: all cards are unavailable. Restart the app as administrator to run checks and updates.'}" />
                                        </Grid>
                                        <Button Style="{StaticResource Btn.Secondary}" Height="38" Margin="0,12,0,0" Command="{Binding ElevateCommand}"
                                                ToolTip="{l:T 'Uygulama UAC onayıyla yönetici olarak yeniden açılır; onay vermezseniz hiçbir şey değişmez.', 'The app reopens as administrator after UAC approval; if you decline, nothing changes.'}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE7EF;" Style="{StaticResource T.Icon}" FontSize="14" Margin="0,0,8,0" />
                                                <TextBlock Text="{l:T 'Yönetici olarak yeniden başlat', 'Restart as administrator'}" FontSize="13" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- İlerleme (gölge ayrı statik katmanda: dönen ikon ve parıltı gölgeyi her karede yeniden hesaplatmaz) -->
                                <Grid>
                                    <Border Style="{StaticResource CardShadowLayer}" />
                                    <Border Style="{StaticResource Card.Flat}" Padding="18">
                                        <StackPanel>
                                            <Grid Margin="2,0,0,12">
                                                <TextBlock Text="{l:T 'İLERLEME', 'PROGRESS'}" Style="{StaticResource T.Label}" />
                                                <TextBlock HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource B.Neon}"
                                                           Text="{Binding Progress, StringFormat={l:T '%{0:0}', '{}{0:0}%'}}" />
                                            </Grid>
                                            <!-- İşlem durumu: ikon yalnızca işlem GERÇEKTEN sürerken döner (DataTrigger Begin/StopStoryboard).
                                                 İşlem bitince animasyon durdurulur ve sonuca göre tik / hata / uyarı ikonu gösterilir. -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="30" Height="30" CornerRadius="9" Margin="0,0,11,0" VerticalAlignment="Top"
                                                        Background="{DynamicResource B.ChipBg}" BorderBrush="{DynamicResource B.Border}" BorderThickness="1">
                                                    <TextBlock FontSize="14" RenderTransformOrigin="0.5,0.5">
                                                        <TextBlock.RenderTransform><RotateTransform /></TextBlock.RenderTransform>
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource T.Icon}">
                                                                <Setter Property="Text" Value="&#xE946;" />
                                                                <Setter Property="Foreground" Value="{DynamicResource B.Text3}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding OperationState}" Value="Completed">
                                                                        <Setter Property="Text" Value="&#xE73E;" />
                                                                        <Setter Property="Foreground" Value="{DynamicResource B.Green}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding OperationState}" Value="Failed">
                                                                        <Setter Property="Text" Value="&#xE783;" />
                                                                        <Setter Property="Foreground" Value="{DynamicResource B.Red}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding OperationState}" Value="Cancelled">
                                                                        <Setter Property="Text" Value="&#xE7BA;" />
                                                                        <Setter Property="Foreground" Value="{DynamicResource B.Orange}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsOperationRunning}" Value="True">
                                                                        <Setter Property="Text" Value="&#xE895;" />
                                                                        <Setter Property="Foreground" Value="{DynamicResource B.Neon}" />
                                                                        <DataTrigger.EnterActions>
                                                                            <BeginStoryboard x:Name="OperationSpin" Storyboard="{StaticResource Sb.Spin}" />
                                                                        </DataTrigger.EnterActions>
                                                                        <DataTrigger.ExitActions>
                                                                            <StopStoryboard BeginStoryboardName="OperationSpin" />
                                                                        </DataTrigger.ExitActions>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding OperationStateText}" FontSize="13.5" FontWeight="SemiBold" TextWrapping="Wrap">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding OperationState}" Value="Completed">
                                                                        <Setter Property="Foreground" Value="{DynamicResource B.Green}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding OperationState}" Value="Failed">
                                                                        <Setter Property="Foreground" Value="{DynamicResource B.Red}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding OperationState}" Value="Cancelled">
                                                                        <Setter Property="Foreground" Value="{DynamicResource B.Orange}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsOperationRunning}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource B.Neon}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding StepText}" FontSize="12" Margin="0,3,0,0" Foreground="{DynamicResource B.Text2}"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Grid>
                                            <!-- Değer yalnızca modüllerin bildirdiği gerçek adımlardan gelir; parıltı animasyonu yalnızca işlem sürerken (Tag=True) çalışır. -->
                                            <ProgressBar Style="{StaticResource Progress.Neon}" Margin="0,14,0,2" Minimum="0" Maximum="100"
                                                         Tag="{Binding IsOperationRunning}" Value="{Binding Progress, Mode=OneWay}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Sağ sütun: seçili bölmenin başlığı ve içeriği -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding CurrentSection.Title}" FontFamily="{StaticResource F.Display}" FontSize="24"
                                   Foreground="{DynamicResource B.Text}" Margin="8,4,8,18" />

                        <!-- ============ v1.8.0 araç bölmeleri (Sistem Sağlığı, Sürücüler, Ağ Merkezi, Servisler…): açık bölmenin aracı, şablonu Tools/ToolViews*.xaml ============ -->
                        <ContentControl x:Name="ToolHost" Grid.Row="1" Content="{Binding CurrentTool}" Focusable="False"
                                        Visibility="{Binding CurrentTool, Converter={StaticResource Visible}}" />

                        <!-- ============ Kartlar (Güncellemeler / Temizlik / Sağlık Araçları): işlem çubuğu + kart satırları ============ -->
                        <Grid Grid.Row="1" Visibility="{Binding CurrentSectionKey, Converter={StaticResource SectionVisible}, ConverterParameter=cards}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Margin="8,0,8,12">
                                <WrapPanel>
                                    <Button Style="{StaticResource Btn.Primary}" Height="46" Margin="0,0,10,10" Command="{Binding StartCheckCommand}"
                                            ToolTip="{l:T 'Tüm kartları kontrol eder (seçimlere bakılmaz).', 'Checks all cards (selections are ignored).'}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE721;" Style="{StaticResource T.Icon}" FontSize="15" Margin="0,0,10,0" />
                                            <TextBlock Text="{l:T 'Tümünü Kontrol Et', 'Check All'}" FontSize="14" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource Btn.Secondary}" Height="46" Margin="0,0,10,10" Command="{Binding CheckSelectedCommand}"
                                            ToolTip="{l:T 'Yalnızca seçtiğiniz kartları kontrol eder.', 'Checks only the cards you selected.'}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE73A;" Style="{StaticResource T.Icon}" FontSize="14" Margin="0,0,10,0"
                                                       Foreground="{DynamicResource B.Neon}" />
                                            <TextBlock Text="{l:T 'Seçilenleri Kontrol Et', 'Check Selected'}" FontSize="13.5" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource Btn.Accent}" Height="46" Margin="0,0,10,10" Command="{Binding UpdateAllCommand}"
                                            ToolTip="{l:T 'Kontrolde işlem gerektiren tüm kartları işler.', 'Runs every card that needs action according to the check.'}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE896;" Style="{StaticResource T.Icon}" FontSize="15" Margin="0,0,10,0" />
                                            <TextBlock Text="{Binding UpdateAllText}" FontSize="14" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource Btn.Secondary}" Height="46" Margin="0,0,10,10" Command="{Binding UpdateSelectedCommand}"
                                            ToolTip="{l:T 'Yalnızca seçilen kartlardan gerçekten işlem gerektirenleri çalıştırır.', 'Runs only the selected cards that actually need action.'}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE768;" Style="{StaticResource T.Icon}" FontSize="13" Margin="0,0,10,0"
                                                       Foreground="{DynamicResource B.Green}" />
                                            <TextBlock Text="{Binding UpdateSelectedText}" FontSize="13.5" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource Btn.Ghost}" Height="46" Margin="0,0,10,10" Command="{Binding CancelCommand}"
                                            Visibility="{Binding IsBusy, Converter={StaticResource Visible}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE711;" Style="{StaticResource T.Icon}" FontSize="11" Margin="0,0,7,0" />
                                            <TextBlock Text="{l:T 'İptal', 'Cancel'}" FontSize="13" />
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <!-- Seçim durumu (kartların sağ üstündeki seçim kutuları) -->
                                    <Border CornerRadius="10" Padding="12,5,6,5" Background="{DynamicResource B.ChipBg}" VerticalAlignment="Center"
                                            BorderBrush="{DynamicResource B.Border}" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE73A;" FontSize="14" Margin="0,0,9,0" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource T.Icon}">
                                                        <Setter Property="Foreground" Value="{DynamicResource B.Text3}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasSelection}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource B.Neon}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding SelectionText}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource B.Text}" Margin="0,0,10,0" />
                                            <Button Style="{StaticResource Btn.Ghost}" Height="28" Padding="10,0" Command="{Binding ClearSelectionCommand}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE894;" Style="{StaticResource T.Icon}" FontSize="11" Margin="0,0,7,0" />
                                                    <TextBlock Text="{l:T 'Seçimi Temizle', 'Clear Selection'}" FontSize="12" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding AvailableSummary}" FontSize="12" LineHeight="17" Margin="14,0,0,0"
                                               Foreground="{DynamicResource B.Text3}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </Grid>
                            </StackPanel>

                            <ScrollViewer x:Name="CardsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MaxWidth="1120" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,6,0,0">
                                        <ItemsControl ItemsSource="{Binding CurrentCategory.Cards}" ItemTemplate="{StaticResource CardTemplate}" Focusable="False" />
                                        <!-- Renk açıklaması -->
                                        <WrapPanel Margin="104,0,8,10">
                                            <Ellipse Width="8" Height="8" Fill="{DynamicResource B.Green}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{l:T 'Güncel / Sağlıklı', 'Up to date / Healthy'}" FontSize="11.5" Foreground="{DynamicResource B.Text3}" Margin="0,0,14,0" VerticalAlignment="Center" />
                                            <Ellipse Width="8" Height="8" Fill="{DynamicResource B.Orange}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{l:T 'Güncelleme / Uyarı', 'Update / Warning'}" FontSize="11.5" Foreground="{DynamicResource B.Text3}" Margin="0,0,14,0" VerticalAlignment="Center" />
                                            <Ellipse Width="8" Height="8" Fill="{DynamicResource B.Red}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{l:T 'Hata', 'Error'}" FontSize="11.5" Foreground="{DynamicResource B.Text3}" Margin="0,0,14,0" VerticalAlignment="Center" />
                                            <Ellipse Width="8" Height="8" Fill="{DynamicResource B.Blue}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{l:T 'Çalışıyor', 'Running'}" FontSize="11.5" Foreground="{DynamicResource B.Text3}" Margin="0,0,14,0" VerticalAlignment="Center" />
                                            <Ellipse Width="8" Height="8" Fill="{DynamicResource B.Gray}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{l:T 'Çalıştırılmadı / Kullanım dışı', 'Not run / Unavailable'}" FontSize="11.5" Foreground="{DynamicResource B.Text3}" VerticalAlignment="Center" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Grid>
                            </ScrollViewer>
                        </Grid>

                        <!-- ============ Bulunan Güncellemeler (kartların son gerçek sonuçlarındaki öğeler) ============ -->
                        <Grid Grid.Row="1" Margin="8,0,8,8"
                              Visibility="{Binding CurrentSectionKey, Converter={StaticResource SectionVisible}, ConverterParameter=found}">
                            <Border Style="{StaticResource CardShadowLayer}" />
                            <Border Style="{StaticResource Card.Flat}" Padding="20,16,20,14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Style="{StaticResource T.SettingDesc}" Margin="2,0,0,12"
                                               Text="{l:T 'Kartların son kontrol ve işlem sonuçlarında bildirilen güncellemeler, paketler ve bileşenler (turuncu: işlem gerektiriyor). Liste her kontrol ve işlemden sonra gerçek sonuçlardan yenilenir.', 'Updates, packages and components reported in the cards\' latest check and operation results (orange: needs action). The list is refreshed from the real results after every check and operation.'}" />
                                    <DataGrid Grid.Row="1" ItemsSource="{Binding UpdateRows}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="{l:T 'KATEGORİ', 'CATEGORY'}" Binding="{Binding Category}" Width="150" />
                                            <DataGridTextColumn Header="{l:T 'PROGRAM / GÜNCELLEME', 'PROGRAM / UPDATE'}" Binding="{Binding Name}" Width="*" />
                                            <DataGridTextColumn Header="{l:T 'MEVCUT', 'CURRENT'}" Binding="{Binding CurrentVersion}" Width="130" />
                                            <DataGridTextColumn Header="{l:T 'YENİ', 'NEW'}" Binding="{Binding NewVersion}" Width="130" />
                                            <DataGridTemplateColumn Header="{l:T 'DURUM', 'STATUS'}" Width="220">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource B.Green}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding UpdateAvailable}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource B.Orange}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock Grid.Row="1" VerticalAlignment="Top" Margin="10,52,10,0" FontSize="12.5" TextWrapping="Wrap"
                                               Foreground="{DynamicResource B.Text3}" Visibility="{Binding UpdateRows.Count, Converter={StaticResource Hidden}}"
                                               Text="{l:T 'Henüz listelenecek sonuç yok. Kartları kontrol ettiğinizde bulunan güncellemeler ve paketler burada görünür.', 'Nothing to list yet. Updates and packages found when you check the cards appear here.'}" />
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- ============ İşlem Günlüğü (filtreler yalnızca görünümü değiştirir) ============ -->
                        <Grid Grid.Row="1" Margin="8,0,8,8"
                              Visibility="{Binding CurrentSectionKey, Converter={StaticResource SectionVisible}, ConverterParameter=log}">
                            <Border Style="{StaticResource CardShadowLayer}" />
                            <Border Style="{StaticResource Card.Flat}" Padding="20,16,20,14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <DockPanel Margin="0,0,0,10" LastChildFill="False">
                                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="0,0,12,6">
                                            <RadioButton Style="{StaticResource Chip}" GroupName="LogFilter" Content="{l:T 'Tümü', 'All'}"
                                                         IsChecked="{Binding LogFilter, Converter={StaticResource EqualsParam}, ConverterParameter=all}" />
                                            <RadioButton Style="{StaticResource Chip}" GroupName="LogFilter" Content="{l:T 'Bilgi', 'Info'}"
                                                         IsChecked="{Binding LogFilter, Converter={StaticResource EqualsParam}, ConverterParameter=info}" />
                                            <RadioButton Style="{StaticResource Chip}" GroupName="LogFilter" Content="{l:T 'Başarılı', 'Success'}"
                                                         IsChecked="{Binding LogFilter, Converter={StaticResource EqualsParam}, ConverterParameter=success}" />
                                            <RadioButton Style="{StaticResource Chip}" GroupName="LogFilter" Content="{l:T 'Uyarı', 'Warning'}"
                                                         IsChecked="{Binding LogFilter, Converter={StaticResource EqualsParam}, ConverterParameter=warning}" />
                                            <RadioButton Style="{StaticResource Chip}" GroupName="LogFilter" Content="{l:T 'Hata', 'Error'}"
                                                         IsChecked="{Binding LogFilter, Converter={StaticResource EqualsParam}, ConverterParameter=error}" />
                                        </StackPanel>
                                        <WrapPanel DockPanel.Dock="Right" Margin="0,0,0,6">
                                            <Button Style="{StaticResource Btn.Ghost}" Height="28" Padding="9,0" Command="{Binding ClearLogsCommand}"
                                                    ToolTip="{l:T 'Ekrandaki günlüğü temizler; günlük dosyası korunur', 'Clears the log on screen; the log file is kept'}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE894;" Style="{StaticResource T.Icon}" FontSize="11" Margin="0,0,6,0" />
                                                    <TextBlock Text="{l:T 'Logları Temizle', 'Clear Log'}" FontSize="12" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource Btn.Ghost}" Height="28" Padding="9,0" Command="{Binding ExportLogsCommand}"
                                                    ToolTip="{l:T 'Gerçek günlük dosyasını seçtiğiniz konuma .txt olarak kaydeder', 'Saves the real log file to a location you choose as .txt'}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE74E;" Style="{StaticResource T.Icon}" FontSize="11" Margin="0,0,6,0" />
                                                    <TextBlock Text="{l:T 'Dışa Aktar', 'Export'}" FontSize="12" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource Btn.Ghost}" Height="28" Padding="9,0" Command="{Binding OpenLogFolderCommand}"
                                                    ToolTip="{l:T 'Günlük klasörünü açar', 'Opens the log folder'}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE838;" Style="{StaticResource T.Icon}" FontSize="11" Margin="0,0,6,0" />
                                                    <TextBlock Text="{l:T 'Klasör', 'Folder'}" FontSize="12" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource Btn.Ghost}" Height="28" Padding="9,0" Command="{Binding OpenLogCommand}"
                                                    ToolTip="{Binding LogFilePath}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE8A5;" Style="{StaticResource T.Icon}" FontSize="11" Margin="0,0,6,0" />
                                                    <TextBlock Text="{l:T 'Log dosyası', 'Log file'}" FontSize="12" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource Btn.Ghost}" Height="28" Padding="9,0" Command="{Binding ShowRecentCommand}"
                                                    ToolTip="{l:T 'Özet → Son İşlemler', 'Summary → Recent Operations'}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE823;" Style="{StaticResource T.Icon}" FontSize="11" Margin="0,0,6,0" />
                                                    <TextBlock Text="{l:T 'Son İşlemler', 'Recent Operations'}" FontSize="12" />
                                                </StackPanel>
                                            </Button>
                                        </WrapPanel>
                                    </DockPanel>

                                    <Border Grid.Row="1" Background="{DynamicResource B.DeepBg}" CornerRadius="10" BorderBrush="{DynamicResource B.RowBorder}" BorderThickness="1" Padding="12,8">
                                        <ListBox x:Name="LogList" ItemsSource="{Binding LogsView}" Background="Transparent" BorderThickness="0"
                                                 ItemContainerStyle="{StaticResource LogItem}"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                                 FontFamily="{StaticResource F.Mono}" FontSize="12">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock TextWrapping="Wrap">
                                                        <Run Text="{Binding TimeText, Mode=OneWay, StringFormat='[{0}]'}" Foreground="{DynamicResource B.Timestamp}" />
                                                        <Run Text="{Binding LevelText, Mode=OneWay, StringFormat='[{0}]'}" Foreground="{Binding Level, Converter={StaticResource LogBrush}}" FontWeight="SemiBold" />
                                                        <Run Text="{Binding Message, Mode=OneWay}" Foreground="{Binding Level, Converter={StaticResource LogBrush}}" />
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- ============ Son İşlemler (kalıcı işlem geçmişi) ============ -->
                        <Grid Grid.Row="1" Margin="8,0,8,8"
                              Visibility="{Binding CurrentSectionKey, Converter={StaticResource SectionVisible}, ConverterParameter=recent}">
                            <Border Style="{StaticResource CardShadowLayer}" />
                            <Border Style="{StaticResource Card.Flat}" Padding="20,16,20,14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Style="{StaticResource T.SettingDesc}" Margin="2,0,0,12"
                                               Text="{l:T 'Tamamlanan kontrol, güncelleme ve araç işlemleri (sürücü denetimi, sistem sağlığı, ağ / DNS testi, hizmet ve başlangıç değişiklikleri, rapor…), en yenisi üstte. Başarısız işlem hata metniyle kaydedilir; geçmiş uygulama kapatılıp açıldığında da korunur.', 'Completed checks, updates and tool operations (driver check, system health, network / DNS test, service and startup changes, report…), newest first. Failed operations are recorded with their error text; the history is kept when the app is closed and reopened.'}" />
                                    <DataGrid Grid.Row="1" ItemsSource="{Binding RecentOperations}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="{l:T 'ZAMAN', 'TIME'}" Binding="{Binding TimeText}" Width="130" />
                                            <DataGridTemplateColumn Header="{l:T 'İŞLEM', 'OPERATION'}" Width="250">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"
                                                                     Fill="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="{l:T 'SONUÇ', 'RESULT'}" Width="*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding ResultText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ResultText}"
                                                                   Foreground="{DynamicResource B.Text2}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="{l:T 'SÜRE', 'DURATION'}" Binding="{Binding DurationText}" Width="110" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock Grid.Row="1" VerticalAlignment="Top" Margin="10,52,10,0" FontSize="12.5" TextWrapping="Wrap"
                                               Foreground="{DynamicResource B.Text3}" Visibility="{Binding RecentOperations.Count, Converter={StaticResource Hidden}}"
                                               Text="{l:T 'Henüz tamamlanmış işlem yok.', 'No completed operations yet.'}" />
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- ============ Sağlık Özeti (kartların gerçek durumlarından) + Son İşlem ============ -->
                        <ScrollViewer x:Name="SummaryScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0"
                                      Visibility="{Binding CurrentSectionKey, Converter={StaticResource SectionVisible}, ConverterParameter=health}">
                            <Grid Margin="8,0,8,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MaxWidth="1120" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource IconTile}">
                                            <TextBlock Text="&#xE9D9;" Style="{StaticResource T.TileIcon}" />
                                        </Border>
                                        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="22,16,22,12">
                                            <StackPanel>
                                                <TextBlock Text="{l:T 'Sistem Sağlık Özeti', 'System Health Summary'}" Style="{StaticResource T.H2}" FontSize="16" />
                                                <TextBlock Text="{Binding HealthCounts}" FontSize="11.5" Foreground="{DynamicResource B.Text3}"
                                                           Margin="0,3,0,0" TextWrapping="Wrap" />
                                                <Border HorizontalAlignment="Left" Margin="0,12,0,0" Padding="12,6" CornerRadius="12"
                                                        Background="{Binding HealthStatus, Converter={StaticResource StatusSoftBrush}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,9,0"
                                                                 Fill="{Binding HealthStatus, Converter={StaticResource StatusBrush}}" />
                                                        <TextBlock Text="{Binding HealthHeadline}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                                                                   Foreground="{Binding HealthStatus, Converter={StaticResource StatusBrush}}" />
                                                    </StackPanel>
                                                </Border>
                                                <ItemsControl ItemsSource="{Binding Cards}" Margin="0,12,0,0" Focusable="False">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <UniformGrid Columns="3" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:ComponentCardViewModel}">
                                                            <Border Margin="0,0,8,8" Padding="10,7" CornerRadius="9" Background="{DynamicResource B.RowBg}"
                                                                    BorderBrush="{DynamicResource B.RowBorder}" BorderThickness="1" ToolTip="{Binding Summary}">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Ellipse Width="8" Height="8" VerticalAlignment="Top" Margin="0,5,9,0"
                                                                             Fill="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                                                    <StackPanel Grid.Column="1">
                                                                        <TextBlock Text="{Binding ShortTitle}" FontSize="12" FontWeight="SemiBold"
                                                                                   Foreground="{DynamicResource B.Text}" TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock Text="{Binding HealthText}" FontSize="11.5" TextTrimming="CharacterEllipsis"
                                                                                   Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Sistem tanılaması (v1.8.0): her satır son GERÇEK tanılama sonucudur; yapılmadıysa "Henüz kontrol edilmedi" -->
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource IconTile}">
                                            <TextBlock Text="&#xE95E;" Style="{StaticResource T.TileIcon}" />
                                        </Border>
                                        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="22,16,22,12">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{l:T 'Sistem Tanılaması', 'System Diagnostics'}" Style="{StaticResource T.H2}" FontSize="16" />
                                                        <TextBlock FontSize="11.5" Foreground="{DynamicResource B.Text3}" Margin="0,3,0,0" TextWrapping="Wrap"
                                                                   Text="{l:T 'Bu oturumda yapılan gerçek kontrollerin son sonucu (Tek Tıkla Tanıla, Tümünü Kontrol Et veya ilgili ekran). Satıra tıklayınca ayrıntı açılır.', 'The latest result of the real checks made in this session (One-Click Diagnosis, Check All or the related screen). Click a row for details.'}" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Style="{StaticResource Btn.Secondary}" Height="36" Padding="14,0" Margin="14,0,0,0"
                                                            VerticalAlignment="Top" Command="{Binding OpenDiagnoseCommand}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE9D9;" Style="{StaticResource T.Icon}" FontSize="12" Margin="0,0,8,0"
                                                                       Foreground="{DynamicResource B.Neon}" />
                                                            <TextBlock Text="{l:T 'Tek Tıkla Tanıla', 'One-Click Diagnosis'}" FontSize="13" />
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                                <ItemsControl x:Name="DiagnosticSummaryList" ItemsSource="{Binding DiagnosticSummary}" Margin="0,12,0,0" Focusable="False">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <UniformGrid Columns="2" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:DiagnosticSummaryRowViewModel}">
                                                            <Button Style="{StaticResource Btn.Row}" Margin="0,0,8,8"
                                                                    Command="{Binding OpenCommand}" ToolTip="{Binding Summary}" AutomationProperties.Name="{Binding Title}">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource T.Icon}" FontSize="15" Margin="0,0,10,0"
                                                                               Foreground="{DynamicResource B.Neon}" VerticalAlignment="Top" />
                                                                    <StackPanel Grid.Column="1">
                                                                        <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource B.Text}" />
                                                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                            <TextBlock Text="{Binding State, Converter={StaticResource StatusGlyph}}" Style="{StaticResource T.Icon}" FontSize="11"
                                                                                       Foreground="{Binding State, Converter={StaticResource StatusBrush}}" Margin="0,0,6,0" />
                                                                            <TextBlock Text="{Binding StateText}" FontSize="11.5" FontWeight="SemiBold"
                                                                                       Foreground="{Binding State, Converter={StaticResource StatusBrush}}" />
                                                                        </StackPanel>
                                                                        <TextBlock Text="{Binding Summary}" FontSize="11.5" Foreground="{DynamicResource B.Text2}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                                                    </StackPanel>
                                                                    <TextBlock Grid.Column="2" Text="{Binding TimeText}" FontSize="11" Foreground="{DynamicResource B.Text3}" VerticalAlignment="Top" Margin="8,0,0,0" />
                                                                </Grid>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Son İşlem özeti (gerçek sonuçlardan) -->
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource IconTile}">
                                            <TextBlock Text="&#xE823;" Style="{StaticResource T.TileIcon}" />
                                        </Border>
                                        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="22,16,22,16">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{l:T 'Son İşlem', 'Last Operation'}" Style="{StaticResource T.H2}" FontSize="16" />
                                                    <StackPanel Margin="0,8,0,0" Visibility="{Binding HasLastOperation, Converter={StaticResource Visible}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0"
                                                                     Fill="{Binding LastOperation.Status, Converter={StaticResource StatusBrush}}" />
                                                            <TextBlock Text="{Binding LastOperation.Title}" FontSize="13" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource B.Text}" />
                                                            <TextBlock Text="{Binding LastOperation.TimeText}" FontSize="11.5" Margin="10,1,0,0"
                                                                       Foreground="{DynamicResource B.Text3}" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding LastOperation.SummaryText}" FontSize="12" Margin="16,3,0,0"
                                                                   TextWrapping="Wrap" Foreground="{DynamicResource B.Text2}" />
                                                    </StackPanel>
                                                    <TextBlock Text="{l:T 'Henüz işlem yapılmadı.', 'No operation yet.'}" FontSize="12" Margin="0,8,0,0" Foreground="{DynamicResource B.Text3}"
                                                               Visibility="{Binding HasLastOperation, Converter={StaticResource Hidden}}" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Style="{StaticResource Btn.Secondary}" Height="36" Padding="14,0" Margin="14,0,0,0"
                                                        VerticalAlignment="Top" Command="{Binding ShowRecentCommand}"
                                                        Visibility="{Binding HasLastOperation, Converter={StaticResource Visible}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE81C;" Style="{StaticResource T.Icon}" FontSize="12" Margin="0,0,8,0"
                                                                   Foreground="{DynamicResource B.Neon}" />
                                                        <TextBlock Text="{l:T 'Geçmiş', 'History'}" FontSize="13" />
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>

                        <!-- ============ Kolay Ayar (mevcut tercihler; yeni ayar sistemi yok) ============ -->
                        <ScrollViewer x:Name="QuickScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0"
                                      Visibility="{Binding CurrentSectionKey, Converter={StaticResource SectionVisible}, ConverterParameter=quick}">
                            <Grid Margin="8,0,8,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MaxWidth="1120" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <!-- Dil (v2.0.0): değiştirmek uygulamayı onayla yeniden başlatır -->
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource IconTile}">
                                            <TextBlock Text="&#xF2B7;" Style="{StaticResource T.TileIcon}" />
                                        </Border>
                                        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="22,16">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{l:T 'Dil · Language', 'Language · Dil'}" Style="{StaticResource T.H2}" FontSize="16" />
                                                    <TextBlock Style="{StaticResource T.SettingDesc}" Margin="0,6,0,0"
                                                               Text="{l:T 'Arayüz, günlük, raporlar ve kurulum ekranları seçilen dilde gösterilir. Dil değiştirildiğinde uygulama onayınızla yeniden başlatılır; ayarlar, geçmiş ve günlükler korunur.', 'The interface, log, reports and setup screens are shown in the selected language. When you change the language, the app restarts with your approval; settings, history and logs are kept.'}" />
                                                </StackPanel>
                                                <StackPanel x:Name="LanguageChoice" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                                                    <RadioButton x:Name="LanguageTurkish" Style="{StaticResource Chip}" GroupName="AppLanguage" Content="Türkçe"
                                                                 IsChecked="{Binding IsTurkishLanguage, Mode=TwoWay}" AutomationProperties.Name="Türkçe" />
                                                    <RadioButton x:Name="LanguageEnglish" Style="{StaticResource Chip}" GroupName="AppLanguage" Content="English" Margin="0"
                                                                 IsChecked="{Binding IsEnglishLanguage, Mode=TwoWay}" AutomationProperties.Name="English" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Grid>

                                    <!-- Tema (v2.0.0): anında uygulanır -->
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource IconTile}">
                                            <TextBlock Text="&#xE790;" Style="{StaticResource T.TileIcon}" />
                                        </Border>
                                        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="22,16">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{l:T 'Görünüm', 'Appearance'}" Style="{StaticResource T.H2}" FontSize="16" />
                                                    <TextBlock Style="{StaticResource T.SettingDesc}" Margin="0,6,0,0"
                                                               Text="{l:T 'Koyu tema (varsayılan) siyah ve lacivert, açık tema beyaz ve açık gri renkler kullanır. Seçim hemen uygulanır ve kaydedilir.', 'The dark theme (default) uses black and navy, the light theme uses white and light gray. Your choice is applied immediately and saved.'}" />
                                                </StackPanel>
                                                <StackPanel x:Name="ThemeChoice" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                                                    <RadioButton x:Name="ThemeDark" Style="{StaticResource Chip}" GroupName="AppTheme" Content="{l:T 'Koyu', 'Dark'}"
                                                                 IsChecked="{Binding IsDarkTheme, Mode=TwoWay}" AutomationProperties.Name="{l:T 'Koyu tema', 'Dark theme'}" />
                                                    <RadioButton x:Name="ThemeLight" Style="{StaticResource Chip}" GroupName="AppTheme" Content="{l:T 'Açık', 'Light'}" Margin="0"
                                                                 IsChecked="{Binding IsLightTheme, Mode=TwoWay}" AutomationProperties.Name="{l:T 'Açık tema', 'Light theme'}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Grid>

                                    <!-- Bildirimler -->
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource IconTile}">
                                            <TextBlock Text="&#xEA8F;" Style="{StaticResource T.TileIcon}" />
                                        </Border>
                                        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="22,16">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{l:T 'Windows bildirimleri', 'Windows notifications'}" Style="{StaticResource T.H2}" FontSize="16" />
                                                    <TextBlock Style="{StaticResource T.SettingDesc}" Margin="0,6,0,0"
                                                               Text="{l:T 'Uzun süren işlemler (SFC, MRT, toplu kontrol ve güncellemeler) tamamlandığında Windows bildirimi gönderilir. Windows Ayarları → Sistem → Bildirimler bölümünden de kapatılabilir.', 'A Windows notification is sent when long operations (SFC, MRT, bulk checks and updates) finish. You can also turn this off in Windows Settings → System → Notifications.'}" />
                                                </StackPanel>
                                                <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" Margin="24,0,0,0"
                                                          IsChecked="{Binding NotificationsEnabled}"
                                                          AutomationProperties.Name="{l:T 'İşlem bitince Windows bildirimi göster', 'Show a Windows notification when an operation finishes'}" />
                                            </Grid>
                                        </Border>
                                    </Grid>

                                    <!-- Toplu güncelleme: Çöp Kutusu -->
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource IconTile}">
                                            <TextBlock Text="&#xE74D;" Style="{StaticResource T.TileIcon}" />
                                        </Border>
                                        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="22,16">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{l:T 'Tümünü Güncelle ile Çöp Kutusu\'nu boşalt', 'Empty the Recycle Bin with Update All'}" Style="{StaticResource T.H2}" FontSize="16" TextWrapping="Wrap" />
                                                    <TextBlock Style="{StaticResource T.SettingDesc}" Margin="0,6,0,0"
                                                               Text="{l:T 'Aynı tercih Temizleme → Çöp Kutusu kartında da bulunur. Çöp Kutusu yalnızca kontrol edildiyse ve onay penceresinde onayladıktan sonra boşaltılır.', 'The same option is also on the Cleanup → Recycle Bin card. The Recycle Bin is emptied only if it was checked and after you confirm in the confirmation window.'}" />
                                                </StackPanel>
                                                <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" Margin="24,0,0,0"
                                                          IsChecked="{Binding CleanRecycleBin}"
                                                          AutomationProperties.Name="{l:T 'Tümünü Güncelle ile Çöp Kutusu\'nu da boşalt', 'Also empty the Recycle Bin with Update All'}" />
                                            </Grid>
                                        </Border>
                                    </Grid>

                                    <!-- Bildirim alanı: pencere kapatılınca arka planda çalışma -->
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource IconTile}">
                                            <TextBlock Text="&#xE7F4;" Style="{StaticResource T.TileIcon}" />
                                        </Border>
                                        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="22,16">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{l:T 'Kapatınca arka planda çalışmaya devam et', 'Keep running in the background when closed'}" Style="{StaticResource T.H2}" FontSize="16" TextWrapping="Wrap" />
                                                    <TextBlock Style="{StaticResource T.SettingDesc}" Margin="0,6,0,0"
                                                               Text="{l:T 'Açıkken pencereyi kapatmak uygulamayı kapatmaz: simgesi görev çubuğunun sağındaki bildirim alanında (^ gizli simgeler) kalır, süren işlemler devam eder. Simgeye çift tıklayınca pencere kaldığı yerden açılır; sağ tıklayınca kısayollar ve Çıkış. Simgeyi görev çubuğuna sürükleyerek her zaman görünür yapabilirsiniz.', 'When on, closing the window does not close the app: its icon stays in the notification area on the right of the taskbar (^ hidden icons) and running operations continue. Double-click the icon to reopen the window where you left off; right-click for shortcuts and Exit. You can drag the icon onto the taskbar to keep it always visible.'}" />
                                                </StackPanel>
                                                <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" Margin="24,0,0,0"
                                                          IsChecked="{Binding CloseToTray}"
                                                          AutomationProperties.Name="{l:T 'Kapatınca arka planda çalışmaya devam et', 'Keep running in the background when closed'}" />
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>

                        <!-- ============ Yönetici Yetkisi ============ -->
                        <ScrollViewer x:Name="AdminScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0"
                                      Visibility="{Binding CurrentSectionKey, Converter={StaticResource SectionVisible}, ConverterParameter=admin}">
                            <Grid Margin="8,0,8,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MaxWidth="1120" />
                                </Grid.ColumnDefinitions>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource IconTile}">
                                        <TextBlock Text="&#xE7EF;" Style="{StaticResource T.TileIcon}" />
                                    </Border>
                                    <Border Grid.Column="1" Style="{StaticResource Card}" Padding="22,16">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{l:T 'Yönetici yetkisi', 'Administrator rights'}" Style="{StaticResource T.H2}" FontSize="16" />
                                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                    <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0"
                                                             Fill="{Binding AdminRow.State, Converter={StaticResource StatusBrush}}" />
                                                    <TextBlock Text="{Binding AdminRow.Detail}" FontSize="13" Foreground="{DynamicResource B.Text}" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <TextBlock Style="{StaticResource T.SettingDesc}" Margin="0,8,0,0"
                                                           Text="{l:T 'Kontrol ve güncelleme işlemleri yönetici yetkisi gerektirir; yetki yoksa tüm kartlar kullanım dışıdır. Yetki yalnızca Windows UAC onayıyla alınır; UAC hiçbir şekilde atlatılmaz.', 'Checks and updates require administrator rights; without them all cards are unavailable. Rights are obtained only through Windows UAC approval; UAC is never bypassed.'}" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Style="{StaticResource Btn.Secondary}" Height="40" Margin="20,0,0,0" VerticalAlignment="Top"
                                                    Command="{Binding ElevateCommand}" Visibility="{Binding ShowElevate, Converter={StaticResource Visible}}"
                                                    ToolTip="{l:T 'Uygulama UAC onayıyla yönetici olarak yeniden açılır; onay vermezseniz hiçbir şey değişmez.', 'The app reopens as administrator after UAC approval; if you decline, nothing changes.'}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE7EF;" Style="{StaticResource T.Icon}" FontSize="14" Margin="0,0,8,0" />
                                                    <TextBlock Text="{l:T 'Yönetici olarak yeniden başlat', 'Restart as administrator'}" FontSize="13" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                        </ScrollViewer>

                        <!-- ============ Günlük Dosyaları ============ -->
                        <ScrollViewer x:Name="LogFilesScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0"
                                      Visibility="{Binding CurrentSectionKey, Converter={StaticResource SectionVisible}, ConverterParameter=logfiles}">
                            <Grid Margin="8,0,8,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MaxWidth="1120" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <!-- Oturum günlüğü -->
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource IconTile}">
                                            <TextBlock Text="&#xE81C;" Style="{StaticResource T.TileIcon}" />
                                        </Border>
                                        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="22,16,22,12">
                                            <StackPanel>
                                                <TextBlock Text="{l:T 'Oturum günlüğü', 'Session log'}" Style="{StaticResource T.H2}" FontSize="16" />
                                                <TextBlock Text="{Binding LogFilePath}" FontFamily="{StaticResource F.Mono}" FontSize="11.5" Margin="0,8,0,0"
                                                           Foreground="{DynamicResource B.Text2}" TextWrapping="Wrap" ToolTip="{l:T 'Bu oturumun günlük dosyası', 'This session\'s log file'}" />
                                                <WrapPanel Margin="0,12,0,0">
                                                    <Button Style="{StaticResource Btn.Secondary}" Height="36" Margin="0,0,8,6" Command="{Binding OpenLogCommand}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE8A5;" Style="{StaticResource T.Icon}" FontSize="13" Margin="0,0,8,0" />
                                                            <TextBlock Text="{l:T 'Günlük dosyasını aç', 'Open log file'}" FontSize="13" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Style="{StaticResource Btn.Secondary}" Height="36" Margin="0,0,8,6" Command="{Binding OpenLogFolderCommand}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE838;" Style="{StaticResource T.Icon}" FontSize="13" Margin="0,0,8,0" />
                                                            <TextBlock Text="{l:T 'Klasörü aç', 'Open folder'}" FontSize="13" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Style="{StaticResource Btn.Secondary}" Height="36" Margin="0,0,8,6" Command="{Binding ExportLogsCommand}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE74E;" Style="{StaticResource T.Icon}" FontSize="13" Margin="0,0,8,0" />
                                                            <TextBlock Text="{l:T 'Dışa aktar', 'Export'}" FontSize="13" />
                                                        </StackPanel>
                                                    </Button>
                                                </WrapPanel>
                                                <TextBlock Style="{StaticResource T.SettingDesc}" Margin="0,4,0,0"
                                                           Text="{l:T 'Her oturum ayrı bir dosyaya yazılır. Ekrandaki günlük; Güncelleme, Temizleme, Cihaz Sağlık ve Özet kategorilerinin İşlem Günlüğü bölmesinde görüntülenir.', 'Each session is written to a separate file. The on-screen log is shown in the Operation Log section of the Updates, Cleanup, Device Health and Summary categories.'}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Günlük arşivi (v1.9.0): eski günlükleri onaylı silme + isteğe bağlı açılışta otomatik silme (varsayılan kapalı) -->
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource IconTile}">
                                            <TextBlock Text="&#xE7B8;" Style="{StaticResource T.TileIcon}" />
                                        </Border>
                                        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="22,16,22,12">
                                            <StackPanel>
                                                <TextBlock Text="{l:T 'Günlük arşivi', 'Log archive'}" Style="{StaticResource T.H2}" FontSize="16" />
                                                <TextBlock x:Name="LogArchiveSummary" Text="{Binding LogArchiveText}" Margin="0,8,0,0" FontSize="12.5"
                                                           Foreground="{DynamicResource B.Text}" TextWrapping="Wrap" />
                                                <WrapPanel Margin="0,12,0,0">
                                                    <Button x:Name="DeleteOldLogsButton" Style="{StaticResource Btn.Secondary}" Height="36" Margin="0,0,8,6"
                                                            Command="{Binding DeleteOldLogsCommand}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE74D;" Style="{StaticResource T.Icon}" FontSize="13" Margin="0,0,8,0" />
                                                            <TextBlock Text="{l:T '30 günden eski günlükleri sil', 'Delete logs older than 30 days'}" FontSize="13" />
                                                        </StackPanel>
                                                    </Button>
                                                </WrapPanel>
                                                <Grid Margin="0,8,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{l:T 'Açılışta 30 günden eski günlükleri otomatik sil', 'Automatically delete logs older than 30 days at startup'}" FontSize="13" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource B.Text}" TextWrapping="Wrap" />
                                                        <TextBlock Style="{StaticResource T.SettingDesc}" Margin="0,4,0,0"
                                                                   Text="{l:T 'Uygulama her açılışta yeni bir günlük dosyası oluşturur. Bu ayar açıkken 30 günden eski günlükler uygulama açılırken silinir; bu oturumun günlüğü, işlem geçmişi ve ayarlar etkilenmez. Varsayılan olarak kapalıdır.', 'The app creates a new log file at every start. When this is on, logs older than 30 days are deleted at startup; this session\'s log, the operation history and the settings are not affected. Off by default.'}" />
                                                    </StackPanel>
                                                    <CheckBox x:Name="AutoDeleteLogsToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}" Margin="24,0,0,0"
                                                              IsChecked="{Binding AutoDeleteOldLogs}"
                                                              AutomationProperties.Name="{l:T 'Açılışta 30 günden eski günlükleri otomatik sil', 'Automatically delete logs older than 30 days at startup'}" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Uygulama verileri -->
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource IconTile}">
                                            <TextBlock Text="&#xE838;" Style="{StaticResource T.TileIcon}" />
                                        </Border>
                                        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="22,16">
                                            <StackPanel>
                                                <TextBlock Text="{l:T 'Uygulama verileri', 'App data'}" Style="{StaticResource T.H2}" FontSize="16" />
                                                <TextBlock Text="{x:Static core:AppInfo.DataDirectory}" FontFamily="{StaticResource F.Mono}" FontSize="11.5" Margin="0,8,0,0"
                                                           Foreground="{DynamicResource B.Text2}" TextWrapping="Wrap" />
                                                <TextBlock Style="{StaticResource T.SettingDesc}" Margin="0,8,0,0"
                                                           Text="{l:T 'İşlem geçmişi ve tercihler (state.json) ile oturum günlükleri (Logs klasörü) burada saklanır. Önceki sürümlerin veri klasörleri silinmez.', 'The operation history and preferences (state.json) and the session logs (Logs folder) are stored here. Data folders of previous versions are not deleted.'}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>

                        <!-- ============ Yasal ve Gizlilik (v1.9.0): Gizlilik Politikası, Kullanım Koşulları, bağlanılan hizmetler, kabul kaydı ============
                             Bağlantılar yalnızca AppInfo.LegalLinks izin listesindeki proje adresleridir; tarayıcı yönetici yetkisi olmadan açılır. -->
                        <ScrollViewer x:Name="LegalScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0"
                                      Visibility="{Binding CurrentSectionKey, Converter={StaticResource SectionVisible}, ConverterParameter=legal}">
                            <Grid Margin="8,0,8,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MaxWidth="1120" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <!-- Gizlilik Politikası -->
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource IconTile}">
                                            <TextBlock Text="&#xE72E;" Style="{StaticResource T.TileIcon}" />
                                        </Border>
                                        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="22,16,22,12">
                                            <StackPanel>
                                                <TextBlock Text="{l:T 'Gizlilik Politikası', 'Privacy Policy'}" Style="{StaticResource T.H2}" FontSize="16" />
                                                <TextBlock Margin="0,8,0,0" FontSize="13" Foreground="{DynamicResource B.Text}" TextWrapping="Wrap"
                                                           Text="{l:T 'Hesap istenmez; telemetri, analitik, reklam ve çerez kullanılmaz. İşlem geçmişi, tercihler ve günlükler yalnızca bu bilgisayarda saklanır ve geliştiriciye gönderilmez.', 'No account is required; no telemetry, analytics, ads or cookies are used. The operation history, preferences and logs are stored only on this computer and are never sent to the developer.'}" />
                                                <TextBlock Style="{StaticResource T.SettingDesc}" Margin="0,6,0,0"
                                                           Text="{l:T 'Uygulamada çerez veya izleme teknolojisi bulunmadığından çerez onayı gerekmez. Sistem Raporu ve Destek Paketi\'nde bilgisayar adı, kullanıcı adı, IP ve MAC adresleri maskelenir. KVKK ve GDPR kapsamındaki haklarınız politikada açıklanmıştır.', 'There are no cookies or tracking technologies in the app, so no cookie consent is needed. The computer name, user name, IP and MAC addresses are masked in the System Report and Support Package. Your rights under KVKK and GDPR are explained in the policy.'}" />
                                                <WrapPanel Margin="0,10,0,0">
                                                    <Button x:Name="PrivacyLinkTr" Style="{StaticResource Btn.Link}" Margin="-6,0,8,4" Content="{l:T 'Gizlilik Politikası (Türkçe)', 'Privacy Policy (Turkish)'}"
                                                            Command="{Binding OpenLegalLinkCommand}" CommandParameter="{x:Static core:AppInfo.PrivacyPolicyUrl}"
                                                            ToolTip="{x:Static core:AppInfo.PrivacyPolicyUrl}" />
                                                    <Button x:Name="PrivacyLinkEn" Style="{StaticResource Btn.Link}" Margin="0,0,8,4" Content="Privacy Policy (English)"
                                                            Command="{Binding OpenLegalLinkCommand}" CommandParameter="{x:Static core:AppInfo.PrivacyPolicyUrlEn}"
                                                            ToolTip="{x:Static core:AppInfo.PrivacyPolicyUrlEn}" />
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Kullanım Koşulları -->
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource IconTile}">
                                            <TextBlock Text="&#xE8A5;" Style="{StaticResource T.TileIcon}" />
                                        </Border>
                                        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="22,16,22,12">
                                            <StackPanel>
                                                <TextBlock Text="{l:T 'Kullanım Koşulları ve Lisans Sözleşmesi', 'Terms of Use and License Agreement'}" Style="{StaticResource T.H2}" FontSize="16" />
                                                <TextBlock Margin="0,8,0,0" FontSize="13" Foreground="{DynamicResource B.Text}" TextWrapping="Wrap"
                                                           Text="{l:T 'Uygulama ücretsizdir ve &quot;olduğu gibi&quot; sunulur. Güncelleme, onarım ve temizlik işlemleri yalnızca sizin başlatmanız ve onayınızla çalışır.', 'The app is free and provided &quot;as is&quot;. Update, repair and cleanup operations run only when you start and approve them.'}" />
                                                <TextBlock Style="{StaticResource T.SettingDesc}" Margin="0,6,0,0"
                                                           Text="{l:T 'Önemli verilerinizi yedeklemeniz ve büyük değişikliklerden önce sistem geri yükleme noktası oluşturmanız önerilir. Garanti reddi, sorumluluğun sınırlandırılması, üçüncü taraf yazılımlar ve Ookla koşulları belgede açıklanmıştır.', 'We recommend backing up important data and creating a system restore point before major changes. The warranty disclaimer, limitation of liability, third-party software and the Ookla terms are explained in the document.'}" />
                                                <WrapPanel Margin="0,10,0,0">
                                                    <Button x:Name="TermsLinkTr" Style="{StaticResource Btn.Link}" Margin="-6,0,8,4" Content="{l:T 'Kullanım Koşulları (Türkçe)', 'Terms of Use (Turkish)'}"
                                                            Command="{Binding OpenLegalLinkCommand}" CommandParameter="{x:Static core:AppInfo.TermsUrl}"
                                                            ToolTip="{x:Static core:AppInfo.TermsUrl}" />
                                                    <Button x:Name="TermsLinkEn" Style="{StaticResource Btn.Link}" Margin="0,0,8,4" Content="Terms of Use (English)"
                                                            Command="{Binding OpenLegalLinkCommand}" CommandParameter="{x:Static core:AppInfo.TermsUrlEn}"
                                                            ToolTip="{x:Static core:AppInfo.TermsUrlEn}" />
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Bağlanılan hizmetler -->
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource IconTile}">
                                            <TextBlock Text="&#xE774;" Style="{StaticResource T.TileIcon}" />
                                        </Border>
                                        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="22,16">
                                            <StackPanel>
                                                <TextBlock Text="{l:T 'Uygulamanın bağlandığı hizmetler', 'Services the app connects to'}" Style="{StaticResource T.H2}" FontSize="16" />
                                                <TextBlock Margin="0,8,0,0" FontSize="12.5" Foreground="{DynamicResource B.Text}" TextWrapping="Wrap" LineHeight="20">
                                                    <Run Text="{l:T 'GitHub – yeni sürüm denetimi ve güncelleme indirme', 'GitHub – new version check and update download'}" /><LineBreak />
                                                    <Run Text="{l:T 'Microsoft – internet bağlantı testi, Windows Update, winget, Microsoft Store, Defender, Edge Update', 'Microsoft – internet connectivity test, Windows Update, winget, Microsoft Store, Defender, Edge Update'}" /><LineBreak />
                                                    <Run Text="{l:T 'Uygulama yayıncıları – winget ile güncellenen uygulamaların resmi indirme adresleri', 'App publishers – official download addresses of apps updated with winget'}" /><LineBreak />
                                                    <Run Text="{l:T 'NVIDIA – sürücü denetimi ve indirme (ekran kartı modeli, Windows sürümü ve dil)', 'NVIDIA – driver check and download (graphics card model, Windows version and language)'}" /><LineBreak />
                                                    <Run Text="{l:T 'Cloudflare – hız testi ve ağ tanılaması', 'Cloudflare – speed test and network diagnostics'}" /><LineBreak />
                                                    <Run Text="{l:T 'Speedtest by Ookla – yalnızca Ookla altyapısını seçip koşullarını kabul ederseniz', 'Speedtest by Ookla – only if you choose the Ookla engine and accept its terms'}" /><LineBreak />
                                                    <Run Text="{l:T 'Google Forms – yalnızca kaldırırken geri bildirim göndermeyi seçerseniz (nedenler, mesaj, uygulama ve Windows sürümü)', 'Google Forms – only if you choose to send feedback when uninstalling (reasons, message, app and Windows version)'}" />
                                                </TextBlock>
                                                <TextBlock Style="{StaticResource T.SettingDesc}" Margin="0,8,0,0"
                                                           Text="{l:T 'Bu hizmetler kendi gizlilik politikalarına tabidir. Adınız, e-posta adresiniz, bilgisayar adınız veya kullanıcı adınız hiçbir hizmete gönderilmez; veriler satılmaz veya paylaşılmaz.', 'These services are subject to their own privacy policies. Your name, e-mail address, computer name or user name is never sent to any service; data is never sold or shared.'}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Kabul kaydı ve iletişim -->
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource IconTile}">
                                            <TextBlock Text="&#xE946;" Style="{StaticResource T.TileIcon}" />
                                        </Border>
                                        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="22,16,22,12">
                                            <StackPanel>
                                                <TextBlock Text="{l:T 'Kabul kaydı ve iletişim', 'Acceptance record and contact'}" Style="{StaticResource T.H2}" FontSize="16" />
                                                <TextBlock x:Name="LegalAcceptanceSummary" Text="{Binding LegalAcceptanceText}" Margin="0,8,0,0" FontSize="13"
                                                           Foreground="{DynamicResource B.Text}" TextWrapping="Wrap" />
                                                <TextBlock Style="{StaticResource T.SettingDesc}" Margin="0,6,0,0">
                                                    <Run Text="{Binding LegalVersionText, Mode=OneWay}" />
                                                    <Run Text="{l:T '· Kabul kaydı yalnızca bu bilgisayarda (state.json) tutulur. Soru ve talepleriniz için proje sayfasındaki Issues bölümünü kullanın; herkese açık başlıklara kişisel bilgi yazmayın.', '· The acceptance record is kept only on this computer (state.json). For questions and requests use the Issues section of the project page; do not write personal information in public topics.'}" />
                                                </TextBlock>
                                                <WrapPanel Margin="0,10,0,0">
                                                    <Button x:Name="IssuesLink" Style="{StaticResource Btn.Link}" Margin="-6,0,8,4" Content="{l:T 'GitHub Issues (iletişim)', 'GitHub Issues (contact)'}"
                                                            Command="{Binding OpenLegalLinkCommand}" CommandParameter="{x:Static core:AppInfo.IssuesUrl}"
                                                            ToolTip="{x:Static core:AppInfo.IssuesUrl}" />
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>

                        <!-- ============ Cihaz Bilgileri: donanım kartları (mevcut sistem bilgisi alanları) + uyumluluk (gereksinimler) ============ -->
                        <ScrollViewer x:Name="DeviceScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0"
                                      Visibility="{Binding CurrentSectionKey, Converter={StaticResource SectionVisible}, ConverterParameter=device-info}">
                            <Grid Margin="8,0,8,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MaxWidth="1120" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <Grid Margin="96,0,0,12">
                                        <TextBlock Text="{Binding SystemInfoStatus}" FontSize="11.5" Foreground="{DynamicResource B.Text3}" VerticalAlignment="Center" />
                                        <Button Style="{StaticResource Btn.Ghost}" Height="30" Padding="10,0" HorizontalAlignment="Right"
                                                Command="{Binding RefreshSystemInfoCommand}" ToolTip="{l:T 'Sistem bilgilerini yenile', 'Refresh system information'}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE72C;" Style="{StaticResource T.Icon}" FontSize="12" Margin="0,0,7,0" />
                                                <TextBlock Text="{l:T 'Yenile', 'Refresh'}" FontSize="12" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding DeviceSections}" ItemTemplate="{StaticResource DeviceSectionTemplate}" Focusable="False" />
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource IconTile}">
                                            <TextBlock Text="&#xEA86;" Style="{StaticResource T.TileIcon}" />
                                        </Border>
                                        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="22,16,22,6">
                                            <StackPanel>
                                                <TextBlock Text="{l:T 'Uyumluluk', 'Compatibility'}" Style="{StaticResource T.H2}" FontSize="16" />
                                                <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding Requirements}" ItemTemplate="{StaticResource RequirementRowTemplate}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>

                        <!-- ============ Cihaz Durumu: canlı ölçüm (yalnızca bu bölme açıkken, 2 saniyede bir) ============ -->
                        <ScrollViewer x:Name="DeviceStatusScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0"
                                      Visibility="{Binding CurrentSectionKey, Converter={StaticResource SectionVisible}, ConverterParameter=device-status}">
                            <StackPanel Margin="8,0,8,8" MaxWidth="1000" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                    <Ellipse Width="8" Height="8" Fill="{DynamicResource B.Green}" VerticalAlignment="Center" Margin="0,0,9,0" />
                                    <TextBlock Text="{Binding DeviceStatusTime}" FontSize="12" Foreground="{DynamicResource B.Text3}" />
                                </StackPanel>
                                <Grid>
                                    <Border Style="{StaticResource CardShadowLayer}" />
                                    <Border Style="{StaticResource Card.Flat}" Padding="24,22,24,4">
                                        <ItemsControl ItemsSource="{Binding DeviceStatusRows}" ItemTemplate="{StaticResource DeviceStatusRowTemplate}" Focusable="False" />
                                    </Border>
                                </Grid>
                                <TextBlock Style="{StaticResource T.SettingDesc}" Margin="4,14,0,0" MaxWidth="820" HorizontalAlignment="Left"
                                           Text="{l:T 'Değerler Windows\'un ve NVIDIA sürücüsünün bildirdiği gerçek ölçümlerdir; okunamayan değer tahmin edilmez (&quot;okunamıyor&quot;, neden için göstergenin üzerine gelin). Termal bölge, Windows\'un ACPI termal bölge sayacıdır ve işlemci çekirdek sıcaklığıyla aynı olmayabilir. Disk sıcaklığı yönetici yetkisi gerektirir ve 15 saniyede bir okunur. Ölçüm yalnızca bu bölme açıkken yapılır.', 'Values are real measurements reported by Windows and the NVIDIA driver; an unreadable value is never guessed (&quot;unreadable&quot;; hover over the gauge for the reason). The thermal zone is Windows\' ACPI thermal zone counter and may differ from the CPU core temperature. Disk temperature requires administrator rights and is read every 15 seconds. Measurements run only while this section is open.'}" />
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ============ Hakkında ============ -->
                        <ScrollViewer x:Name="DeviceAboutScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0"
                                      Visibility="{Binding CurrentSectionKey, Converter={StaticResource SectionVisible}, ConverterParameter=device-about}">
                            <StackPanel Margin="8,0,8,8" MaxWidth="780" HorizontalAlignment="Left">
                                <Border Style="{StaticResource Card}" Padding="26,22">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Rectangle Width="60" Height="60" RadiusX="15" RadiusY="15" Fill="{StaticResource LogoBrush}"
                                                       Stroke="{DynamicResource B.BorderHi}" StrokeThickness="1" />
                                            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Static core:AppInfo.Name}" Style="{StaticResource T.H1}" FontSize="22" />
                                                <TextBlock FontSize="12.5" Foreground="{DynamicResource B.Neon}" Margin="0,3,0,0">
                                                    <Run Text="{l:T 'Kontrol Merkezi ·', 'Control Center ·'}" />
                                                    <Run Text="{Binding AppVersion, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Style="{StaticResource T.SettingDesc}" FontSize="12.5" Margin="0,16,0,0"
                                                   Text="{l:T 'Windows 11 için güncelleme ve bakım merkezi. Tüm durumlar Windows araçlarının, Windows API\'lerinin, NVIDIA sürücüsünün ve hız testi sunucularının (Cloudflare, Speedtest by Ookla) gerçek çıktılarından okunur; hiçbir sonuç tahmin edilmez. Sistemde değişiklik yapan her işlem yalnızca onayınızla çalışır.', 'Update and maintenance center for Windows 11. Every status is read from the real output of Windows tools, Windows APIs, the NVIDIA driver and the speed test servers (Cloudflare, Speedtest by Ookla); no result is guessed. Every operation that changes the system runs only with your approval.'}" />
                                        <Border Height="1" Background="{DynamicResource B.Border}" Margin="0,18,0,14" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="{l:T 'Sürüm', 'Version'}" FontSize="12" Foreground="{DynamicResource B.Text3}" Margin="0,0,10,9" />
                                            <TextBlock Grid.Column="1" Text="{Binding AppVersion}" FontSize="12.5" Foreground="{DynamicResource B.Text}" />
                                            <TextBlock Grid.Row="1" Text="{l:T 'Kurulum', 'Installation'}" FontSize="12" Foreground="{DynamicResource B.Text3}" Margin="0,0,10,9" />
                                            <TextBlock x:Name="InstallStatusText" Grid.Row="1" Grid.Column="1" Text="{Binding InstallStatusText}" FontSize="12.5"
                                                       Foreground="{DynamicResource B.Text}" TextWrapping="Wrap" Margin="0,0,0,9" />
                                            <TextBlock Grid.Row="2" Text="{l:T 'Güncelleme', 'Update'}" FontSize="12" Foreground="{DynamicResource B.Text3}" Margin="0,0,10,9" />
                                            <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,9">
                                                <TextBlock x:Name="UpdateAboutText" Text="{Binding Update.AboutText}" FontSize="12.5" Foreground="{DynamicResource B.Text}"
                                                           TextWrapping="Wrap" />
                                                <Button x:Name="UpdateCheckLink" Style="{StaticResource Btn.Link}" Content="{l:T 'Şimdi denetle', 'Check now'}" HorizontalAlignment="Left"
                                                        Margin="0,2,0,0" Command="{Binding Update.CheckCommand}"
                                                        ToolTip="{l:T 'Sürüm deposunda (GitHub) yeni sürüm olup olmadığını denetler.', 'Checks the release repository (GitHub) for a new version.'}" />
                                            </StackPanel>
                                            <TextBlock Grid.Row="3" Text="{l:T 'Dil', 'Language'}" FontSize="12" Foreground="{DynamicResource B.Text3}" Margin="0,0,10,9" />
                                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{l:T 'Türkçe', 'English'}" FontSize="12.5" Foreground="{DynamicResource B.Text}" />
                                            <TextBlock Grid.Row="4" Text="{l:T 'Veri klasörü', 'Data folder'}" FontSize="12" Foreground="{DynamicResource B.Text3}" Margin="0,0,10,9" />
                                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{x:Static core:AppInfo.DataDirectory}" FontSize="12.5"
                                                       Foreground="{DynamicResource B.Text}" TextWrapping="Wrap" />
                                            <TextBlock Grid.Row="5" Text="{l:T 'Günlük dosyası', 'Log file'}" FontSize="12" Foreground="{DynamicResource B.Text3}" Margin="0,0,10,9" />
                                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding LogFilePath}" FontSize="12.5" Foreground="{DynamicResource B.Text}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Grid.Row="6" Text="{l:T 'Kaynak kod', 'Source code'}" FontSize="12" Foreground="{DynamicResource B.Text3}" Margin="0,0,10,0" />
                                            <TextBlock Grid.Row="6" Grid.Column="1" Text="{l:T 'github.com/E-mre-Hub/E-mre-Control-Center (herkese açık)', 'github.com/E-mre-Hub/E-mre-Control-Center (public)'}" FontSize="12.5"
                                                       Foreground="{DynamicResource B.Text}" TextWrapping="Wrap" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ============ Hız Testi: BAŞLAT / canlı gösterge + gerçek sonuçlar + ISS ve sunucu ============ -->
                        <ScrollViewer x:Name="SpeedTestScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0"
                                      Visibility="{Binding CurrentSectionKey, Converter={StaticResource SectionVisible}, ConverterParameter=speedtest}">
                            <Grid Margin="8,0,8,8" DataContext="{Binding SpeedTest}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MaxWidth="1120" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <!-- Ana panel (gösterge test sırasında her karede çizildiği için gölge ayrı statik katmanda) -->
                                    <Grid Margin="0,0,0,16">
                                        <Border Style="{StaticResource CardShadowLayer}" />
                                        <Border Style="{StaticResource Card.Flat}" Padding="28,26,28,24">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="326" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Sol: BAŞLAT + seçili sunucu (boşta) / canlı gösterge (test sürerken) -->
                                                <Grid Width="306" Height="344" VerticalAlignment="Top" HorizontalAlignment="Left">
                                                    <StackPanel VerticalAlignment="Top" Visibility="{Binding IsRunning, Converter={StaticResource Hidden}}">
                                                        <Button x:Name="SpeedGoButton" Style="{StaticResource Btn.SpeedGo}" Command="{Binding StartCommand}" Margin="0,4,0,0"
                                                                AutomationProperties.Name="{l:T 'Hız testini başlat', 'Start the speed test'}"
                                                                ToolTip="{l:T 'Gecikme, paket kaybı, indirme ve yükleme hızını seçili sunucuyla gerçek ölçümle test eder.', 'Measures latency, packet loss, download and upload speed with the selected server.'}" />
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                                                            <TextBlock Text="&#xE968;" Style="{StaticResource T.Icon}" FontSize="13" Foreground="{DynamicResource B.Neon}" Margin="0,0,8,0" />
                                                            <TextBlock Text="{Binding SelectionTitle}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource B.Text}"
                                                                       TextTrimming="CharacterEllipsis" MaxWidth="260" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding SelectionSubtitle}" FontSize="12" Foreground="{DynamicResource B.Text3}" HorizontalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" MaxWidth="300" Margin="0,3,0,0" ToolTip="{Binding SelectionSubtitle}" />
                                                        <Button x:Name="ChangeServerLink" Style="{StaticResource Btn.Link}" HorizontalAlignment="Center" Margin="0,4,0,0"
                                                                Command="{Binding DataContext.ShowSpeedServersCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBool}}">
                                                            <TextBlock Text="{l:T 'Sunucuyu değiştir', 'Change server'}" />
                                                        </Button>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0"
                                                                    Visibility="{Binding ShowConnectionChoice, Converter={StaticResource Visible}}">
                                                            <RadioButton Style="{StaticResource Chip}" GroupName="SpeedConnections" Content="{Binding MultiLabel}"
                                                                         ToolTip="{l:T '6 paralel TCP bağlantısı: bağlantının toplam kapasitesini ölçer.', '6 parallel TCP connections: measures the total capacity of the connection.'}"
                                                                         IsChecked="{Binding ConnectionMode, Converter={StaticResource EqualsParam}, ConverterParameter=multi}" />
                                                            <RadioButton Style="{StaticResource Chip}" GroupName="SpeedConnections" Content="{l:T 'Tek bağlantı', 'Single connection'}"
                                                                         ToolTip="{l:T 'Tek TCP bağlantısı: tek bir indirmenin / yüklemenin ulaşabildiği hızı ölçer.', 'A single TCP connection: measures the speed one download / upload can reach.'}"
                                                                         IsChecked="{Binding ConnectionMode, Converter={StaticResource EqualsParam}, ConverterParameter=single}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <Grid Height="306" VerticalAlignment="Top" Visibility="{Binding IsRunning, Converter={StaticResource Visible}}">
                                                        <views:SpeedGauge x:Name="SpeedGaugeControl" Value="{Binding GaugeValue}" Thickness="20" TrackBrush="{DynamicResource B.GaugeTrack}"
                                                                          LabelBrush="{DynamicResource B.Text3}" ActiveLabelBrush="{DynamicResource B.Text}">
                                                            <views:SpeedGauge.Style>
                                                                <Style TargetType="views:SpeedGauge">
                                                                    <Setter Property="FillBrush" Value="{DynamicResource B.SpeedDown}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding GaugeIsUpload}" Value="True">
                                                                            <Setter Property="FillBrush" Value="{DynamicResource B.SpeedUp}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </views:SpeedGauge.Style>
                                                        </views:SpeedGauge>
                                                        <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,2">
                                                            <TextBlock Text="{Binding GaugeValueText}" FontFamily="{StaticResource F.Display}" FontSize="38" FontWeight="Light"
                                                                       Foreground="{DynamicResource B.Text}" HorizontalAlignment="Center" />
                                                            <TextBlock HorizontalAlignment="Center" FontSize="12.5" Foreground="{DynamicResource B.Text2}">
                                                                <Run Text="{Binding GaugeCaption, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding GaugeUnit, Mode=OneWay}" />
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Grid>
                                                </Grid>

                                                <!-- Sağ: gerçek sonuçlar -->
                                                <StackPanel Grid.Column="1" Margin="10,6,0,0">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xE896;" Style="{StaticResource T.Icon}" FontSize="14" Foreground="{DynamicResource B.Neon}" Margin="0,0,8,0" />
                                                                <TextBlock FontSize="12.5" Foreground="{DynamicResource B.Text2}"><Run Text="{l:T 'İNDİRME', 'DOWNLOAD'}" FontWeight="SemiBold" Foreground="{DynamicResource B.Text}" /><Run Text=" Mbps" /></TextBlock>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding DownloadText}" FontFamily="{StaticResource F.Display}" FontSize="46" FontWeight="Light"
                                                                       Foreground="{DynamicResource B.Text}" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xE898;" Style="{StaticResource T.Icon}" FontSize="14" Foreground="{DynamicResource B.Neon2}" Margin="0,0,8,0" />
                                                                <TextBlock FontSize="12.5" Foreground="{DynamicResource B.Text2}"><Run Text="{l:T 'YÜKLEME', 'UPLOAD'}" FontWeight="SemiBold" Foreground="{DynamicResource B.Text}" /><Run Text=" Mbps" /></TextBlock>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding UploadText}" FontFamily="{StaticResource F.Display}" FontSize="46" FontWeight="Light"
                                                                       Foreground="{DynamicResource B.Text}" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                    </Grid>

                                                    <!-- Ping: boşta · indirme sırasında · yükleme sırasında -->
                                                    <WrapPanel Margin="0,16,0,0">
                                                        <TextBlock Text="Ping ms" FontSize="12.5" Foreground="{DynamicResource B.Text2}" VerticalAlignment="Center" Margin="0,0,16,6" />
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,18,6" Background="Transparent"
                                                                    ToolTip="{l:T 'Boşta gecikme: TCP bağlantı süresi, 20 ölçümün medyanı.', 'Idle latency: TCP connect time, median of 20 measurements.'}">
                                                            <TextBlock Text="&#xE916;" Style="{StaticResource T.Icon}" FontSize="14" Foreground="{DynamicResource B.Orange}" Margin="0,0,7,0" />
                                                            <TextBlock Text="{Binding PingText}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource B.Text}" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,18,6" Background="Transparent"
                                                                    ToolTip="{l:T 'İndirme sırasında (yük altında) gecikme: 0,5 saniyede bir ölçümün medyanı.', 'Latency during download (under load): median of measurements every 0.5 seconds.'}">
                                                            <TextBlock Text="&#xE896;" Style="{StaticResource T.Icon}" FontSize="14" Foreground="{DynamicResource B.Neon}" Margin="0,0,7,0" />
                                                            <TextBlock Text="{Binding DownloadPingText}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource B.Text}" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,18,6" Background="Transparent"
                                                                    ToolTip="{l:T 'Yükleme sırasında (yük altında) gecikme: 0,5 saniyede bir ölçümün medyanı.', 'Latency during upload (under load): median of measurements every 0.5 seconds.'}">
                                                            <TextBlock Text="&#xE898;" Style="{StaticResource T.Icon}" FontSize="14" Foreground="{DynamicResource B.Neon2}" Margin="0,0,7,0" />
                                                            <TextBlock Text="{Binding UploadPingText}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource B.Text}" />
                                                        </StackPanel>
                                                    </WrapPanel>
                                                    <WrapPanel Margin="0,4,0,0">
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,24,6" Background="Transparent"
                                                                    ToolTip="{l:T 'Titreşim (jitter): ardışık gecikme ölçümleri arasındaki farkların ortalaması.', 'Jitter: the average difference between consecutive latency measurements.'}">
                                                            <TextBlock Text="{l:T 'Titreşim', 'Jitter'}" FontSize="12.5" Foreground="{DynamicResource B.Text2}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                            <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource B.Text}">
                                                                <Run Text="{Binding JitterText, Mode=OneWay}" /><Run Text=" ms" FontWeight="Normal" Foreground="{DynamicResource B.Text3}" />
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,24,6" Background="Transparent" ToolTip="{Binding PacketLossToolTip}">
                                                            <TextBlock Text="{l:T 'Paket kaybı', 'Packet loss'}" FontSize="12.5" Foreground="{DynamicResource B.Text2}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding PacketLossText}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource B.Text}" />
                                                        </StackPanel>
                                                    </WrapPanel>

                                                    <!-- Kullanım uygunluğu -->
                                                    <ItemsControl ItemsSource="{Binding Ratings}" ItemTemplate="{StaticResource UsageRatingTemplate}" Margin="0,16,0,0" Focusable="False">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                    </ItemsControl>

                                                    <!-- Test sürerken: gerçek aşama + süre ilerlemesi (parıltısız: sürekli animasyon yok) + İptal; bittiğinde: gerçek sonuç durumu -->
                                                    <Grid Margin="0,18,0,0" Visibility="{Binding IsRunning, Converter={StaticResource Visible}}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding PhaseText}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource B.Neon}" />
                                                            <ProgressBar Style="{StaticResource Progress.Neon}" Margin="0,8,0,0" Minimum="0" Maximum="100"
                                                                         Value="{Binding PhaseProgress, Mode=OneWay}" />
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Style="{StaticResource Btn.Ghost}" Height="36" Margin="16,0,0,0" Command="{Binding CancelCommand}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xE711;" Style="{StaticResource T.Icon}" FontSize="11" Margin="0,0,7,0" />
                                                                <TextBlock Text="{l:T 'İptal', 'Cancel'}" FontSize="13" />
                                                            </StackPanel>
                                                        </Button>
                                                    </Grid>
                                                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0" Visibility="{Binding IsRunning, Converter={StaticResource Hidden}}">
                                                        <Ellipse Width="8" Height="8" VerticalAlignment="Top" Margin="0,5,9,0"
                                                                 Fill="{Binding StatusKind, Converter={StaticResource StatusBrush}}" />
                                                        <TextBlock Text="{Binding StatusText}" FontSize="12.5" LineHeight="18" TextWrapping="Wrap" MaxWidth="560"
                                                                   Foreground="{Binding StatusKind, Converter={StaticResource StatusBrush}}" />
                                                    </StackPanel>
                                                    <Button x:Name="SpeedResultLink" Style="{StaticResource Btn.Link}" HorizontalAlignment="Left" Margin="10,6,0,0"
                                                            Command="{Binding OpenResultCommand}" ToolTip="{Binding ResultUrl}"
                                                            Visibility="{Binding ResultUrl, Converter={StaticResource Visible}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE8A7;" Style="{StaticResource T.Icon}" FontSize="12" Margin="0,0,8,0" />
                                                            <TextBlock Text="{l:T 'Sonuç sayfasını aç (speedtest.net)', 'Open the result page (speedtest.net)'}" />
                                                        </StackPanel>
                                                    </Button>
                                                    <TextBlock Text="{Binding BlockedReason}" FontSize="12" LineHeight="17" TextWrapping="Wrap" Margin="0,10,0,0"
                                                               Foreground="{DynamicResource B.Orange}" Visibility="{Binding BlockedReason, Converter={StaticResource Visible}}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Grid>

                                    <!-- İnternet servis sağlayıcısı -->
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource IconTile}">
                                            <TextBlock Text="&#xE77B;" Style="{StaticResource T.TileIcon}" />
                                        </Border>
                                        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="22,16">
                                            <StackPanel>
                                                <TextBlock Text="{l:T 'İnternet servis sağlayıcısı', 'Internet service provider'}" Style="{StaticResource T.H2}" FontSize="16" />
                                                <TextBlock Text="{Binding IspText}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource B.Text}" Margin="0,8,0,0"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding ClientText}" FontSize="12.5" Foreground="{DynamicResource B.Text2}" Margin="0,4,0,0" TextWrapping="Wrap"
                                                           Visibility="{Binding ClientText, Converter={StaticResource Visible}}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Test sunucusu -->
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource IconTile}">
                                            <TextBlock Text="&#xE968;" Style="{StaticResource T.TileIcon}" />
                                        </Border>
                                        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="22,16">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{l:T 'Test sunucusu (son test)', 'Test server (last test)'}" Style="{StaticResource T.H2}" FontSize="16" />
                                                    <TextBlock Text="{Binding ServerText}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource B.Text}" Margin="0,8,0,0"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding ServerDetailText}" FontSize="12.5" Foreground="{DynamicResource B.Text2}" Margin="0,4,0,0" TextWrapping="Wrap"
                                                               Visibility="{Binding ServerDetailText, Converter={StaticResource Visible}}" />
                                                    <TextBlock Style="{StaticResource T.SettingDesc}" Margin="0,8,0,0" Text="{Binding ServerNote}" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Style="{StaticResource Btn.Secondary}" Height="36" Padding="14,0" Margin="16,0,0,0" VerticalAlignment="Top"
                                                        Command="{Binding DataContext.ShowSpeedServersCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBool}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE968;" Style="{StaticResource T.Icon}" FontSize="12" Margin="0,0,8,0" Foreground="{DynamicResource B.Neon}" />
                                                        <TextBlock Text="{l:T 'Sunucuyu değiştir', 'Change server'}" FontSize="13" />
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>

                        <!-- ============ Sunucu: altyapı (Speedtest by Ookla / Cloudflare) + Ookla sunucu listesi ============ -->
                        <ScrollViewer x:Name="SpeedServerScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0"
                                      Visibility="{Binding CurrentSectionKey, Converter={StaticResource SectionVisible}, ConverterParameter=speed-servers}">
                            <Grid Margin="8,0,8,8" DataContext="{Binding SpeedTest}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MaxWidth="1120" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <!-- Ölçüm altyapısı -->
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource IconTile}">
                                            <TextBlock Text="&#xEC4A;" Style="{StaticResource T.TileIcon}" />
                                        </Border>
                                        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="22,16">
                                            <StackPanel>
                                                <TextBlock Text="{l:T 'Ölçüm altyapısı', 'Test engine'}" Style="{StaticResource T.H2}" FontSize="16" />
                                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0" IsEnabled="{Binding IsWorking, Converter={StaticResource InverseBool}}">
                                                    <RadioButton Style="{StaticResource Chip}" GroupName="SpeedProvider" Content="Speedtest by Ookla"
                                                                 IsChecked="{Binding ProviderMode, Converter={StaticResource EqualsParam}, ConverterParameter=ookla}" />
                                                    <RadioButton Style="{StaticResource Chip}" GroupName="SpeedProvider" Content="Cloudflare"
                                                                 IsChecked="{Binding ProviderMode, Converter={StaticResource EqualsParam}, ConverterParameter=cloudflare}" />
                                                </StackPanel>
                                                <TextBlock Style="{StaticResource T.SettingDesc}" Margin="0,10,0,0"
                                                           Visibility="{Binding IsOoklaProvider, Converter={StaticResource Visible}}"
                                                           Text="{l:T 'Ookla\'nın Speedtest sunucu ağı: İnternet servis sağlayıcılarının ve veri merkezlerinin kendi sunucuları (ör. İstanbul\'daki Turkcell, Turknet, Türksat). Sunucuyu aşağıdaki listeden siz seçersiniz. Ookla\'nın resmi aracı gerekir; her testin sonucu Ookla\'ya kaydedilir.', 'Ookla\'s Speedtest server network: servers run by internet service providers and data centers themselves. You choose the server from the list below. Ookla\'s official tool is required; every test result is recorded by Ookla.'}" />
                                                <TextBlock Style="{StaticResource T.SettingDesc}" Margin="0,10,0,0"
                                                           Visibility="{Binding IsOoklaProvider, Converter={StaticResource Hidden}}"
                                                           Text="{l:T 'Cloudflare hız testi altyapısı: kurulum gerektirmez ve sonuçlar hiçbir yere gönderilmez. Sunucu seçilemez; bağlantınız otomatik olarak en yakın Cloudflare veri merkezine yönlendirilir (hangisi olduğunu ISS\'niz belirler).', 'Cloudflare speed test engine: nothing to install and results are not sent anywhere. The server cannot be chosen; your connection is routed automatically to the nearest Cloudflare data center (your ISP decides which).'}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Speedtest by Ookla: kurulum / koşullar / sunucu listesi -->
                                    <Grid Margin="0,0,0,16" Visibility="{Binding IsOoklaProvider, Converter={StaticResource Visible}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource IconTile}">
                                            <TextBlock Text="&#xE968;" Style="{StaticResource T.TileIcon}" />
                                        </Border>
                                        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="22,18">
                                            <StackPanel>
                                                <!-- Denetleniyor -->
                                                <TextBlock Text="{Binding OoklaMessage}" FontSize="13" Foreground="{DynamicResource B.Text2}" TextWrapping="Wrap"
                                                           Visibility="{Binding ShowOoklaChecking, Converter={StaticResource Visible}}" />

                                                <!-- Kurulu değil -->
                                                <StackPanel Visibility="{Binding ShowOoklaInstall, Converter={StaticResource Visible}}">
                                                    <TextBlock Text="{l:T 'Ookla Speedtest aracı kurulu değil', 'The Ookla Speedtest tool is not installed'}" Style="{StaticResource T.H2}" FontSize="16" />
                                                    <TextBlock Style="{StaticResource T.SettingDesc}" FontSize="12.5" Margin="0,8,0,0"
                                                               Text="{l:T 'Speedtest sunucularından test için Ookla\'nın resmi komut satırı aracı (Speedtest CLI) gerekir. Araç yalnızca onayınızla winget ile kurulur (Ookla.Speedtest.CLI, yaklaşık 1 MB, yönetici yetkisi gerekmez). Kurmak istemezseniz Cloudflare ile test yapabilirsiniz.', 'Testing with Speedtest servers requires Ookla\'s official command-line tool (Speedtest CLI). It is installed with winget only with your approval (Ookla.Speedtest.CLI, about 1 MB, no administrator rights needed). If you prefer not to install it, you can test with Cloudflare.'}" />
                                                    <Button x:Name="InstallOoklaButton" Style="{StaticResource Btn.Secondary}" Height="40" HorizontalAlignment="Left" Margin="0,14,0,0"
                                                            Command="{Binding InstallOoklaCommand}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE896;" Style="{StaticResource T.Icon}" FontSize="13" Margin="0,0,9,0" Foreground="{DynamicResource B.Neon}" />
                                                            <TextBlock Text="{l:T 'Ookla aracını kur', 'Install the Ookla tool'}" FontSize="13.5" />
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>

                                                <!-- Kuruluyor (sürekli animasyon yok: yalnızca metin) -->
                                                <StackPanel Visibility="{Binding ShowOoklaInstalling, Converter={StaticResource Visible}}">
                                                    <TextBlock Text="{l:T 'Ookla aracı kuruluyor...', 'Installing the Ookla tool...'}" Style="{StaticResource T.H2}" FontSize="16" Foreground="{DynamicResource B.Neon}" />
                                                    <TextBlock Text="{Binding OoklaMessage}" FontSize="12.5" Foreground="{DynamicResource B.Text2}" Margin="0,6,0,0" TextWrapping="Wrap" />
                                                </StackPanel>

                                                <!-- Hata -->
                                                <StackPanel Visibility="{Binding ShowOoklaError, Converter={StaticResource Visible}}">
                                                    <TextBlock Text="{l:T 'Ookla aracı kullanılamıyor', 'The Ookla tool is unavailable'}" Style="{StaticResource T.H2}" FontSize="16" Foreground="{DynamicResource B.Red}" />
                                                    <TextBlock Text="{Binding OoklaMessage}" FontSize="12.5" LineHeight="18" Foreground="{DynamicResource B.Text2}" Margin="0,6,0,0" TextWrapping="Wrap" />
                                                    <WrapPanel Margin="0,12,0,0">
                                                        <Button Style="{StaticResource Btn.Secondary}" Height="38" Margin="0,0,8,0" Command="{Binding RetryOoklaCommand}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xE72C;" Style="{StaticResource T.Icon}" FontSize="12" Margin="0,0,8,0" />
                                                                <TextBlock Text="{l:T 'Yeniden denetle', 'Check again'}" FontSize="13" />
                                                            </StackPanel>
                                                        </Button>
                                                        <Button Style="{StaticResource Btn.Secondary}" Height="38" Command="{Binding InstallOoklaCommand}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xE896;" Style="{StaticResource T.Icon}" FontSize="12" Margin="0,0,8,0" />
                                                                <TextBlock Text="{l:T 'Yeniden kur', 'Reinstall'}" FontSize="13" />
                                                            </StackPanel>
                                                        </Button>
                                                    </WrapPanel>
                                                </StackPanel>

                                                <!-- Koşullar (araç kurulu, kabul edilmedi) -->
                                                <StackPanel Visibility="{Binding ShowOoklaLicense, Converter={StaticResource Visible}}">
                                                    <TextBlock Text="{l:T 'Ookla\'nın koşullarını kabul edin', 'Accept Ookla\'s terms'}" Style="{StaticResource T.H2}" FontSize="16" />
                                                    <TextBlock Style="{StaticResource T.SettingDesc}" FontSize="12.5" Margin="0,8,0,0"
                                                               Text="{l:T 'Ookla aracı yalnızca Ookla\'nın lisans, kullanım ve gizlilik koşulları kabul edilerek çalışır. Araç ve ürettiği bilgiler yalnızca kişisel, ticari olmayan kullanım içindir. Her testte sonuç, IP adresiniz ve bağlantı bilgileri Ookla\'ya gönderilir ve Ookla bir sonuç sayfası oluşturur (speedtest.net\'teki gibi). Kabul etmezseniz araç çalıştırılmaz; Cloudflare ile test yapabilirsiniz.', 'The Ookla tool runs only after Ookla\'s license, terms of use and privacy terms are accepted. The tool and the information it produces are for personal, non-commercial use only. With every test the result, your IP address and connection details are sent to Ookla, and Ookla creates a result page (like on speedtest.net). If you do not accept, the tool is not run; you can test with Cloudflare.'}" />
                                                    <Border Margin="0,12,0,0" Padding="14,10" CornerRadius="10" Background="{DynamicResource B.RowBg}" BorderBrush="{DynamicResource B.Border}" BorderThickness="1">
                                                        <TextBlock Text="{Binding OoklaLicenseNotice}" FontFamily="{StaticResource F.Mono}" FontSize="11.5" LineHeight="17"
                                                                   Foreground="{DynamicResource B.Text2}" TextWrapping="Wrap" />
                                                    </Border>
                                                    <ItemsControl ItemsSource="{Binding OoklaLinks}" Margin="0,8,0,0" Focusable="False">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type vm:LinkItem}">
                                                                <Button Style="{StaticResource Btn.Link}" Margin="0,0,6,0" FontSize="12.5" ToolTip="{Binding Url}"
                                                                        Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        CommandParameter="{Binding Url}">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="&#xE8A7;" Style="{StaticResource T.Icon}" FontSize="11" Margin="0,0,6,0" />
                                                                        <TextBlock Text="{Binding Title}" />
                                                                    </StackPanel>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <Button x:Name="AcceptOoklaButton" Style="{StaticResource Btn.Secondary}" Height="40" HorizontalAlignment="Left" Margin="0,12,0,0"
                                                            Command="{Binding AcceptOoklaLicenseCommand}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE73E;" Style="{StaticResource T.Icon}" FontSize="13" Margin="0,0,9,0" Foreground="{DynamicResource B.Green}" />
                                                            <TextBlock Text="{l:T 'Okudum, kabul ediyorum', 'I have read and accept'}" FontSize="13.5" />
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>

                                                <!-- Hazır: seçili sunucu + Otomatik Seç + arama + yakın sunucular -->
                                                <StackPanel Visibility="{Binding ShowOoklaReady, Converter={StaticResource Visible}}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="38" Height="38" CornerRadius="19" BorderBrush="{DynamicResource B.BorderHi}" BorderThickness="1" VerticalAlignment="Center">
                                                            <TextBlock Text="&#xE774;" Style="{StaticResource T.Icon}" FontSize="16" Foreground="{DynamicResource B.Text}" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding SelectionTitleUpper}" FontSize="15" Foreground="{DynamicResource B.Text}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding SelectionSubtitle}" FontSize="12.5" Foreground="{DynamicResource B.Text2}" Margin="0,2,0,0"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <Button Grid.Column="2" Style="{StaticResource Btn.Ghost}" Height="32" Padding="10,0" VerticalAlignment="Center"
                                                                Command="{Binding RefreshServersCommand}" ToolTip="{l:T 'Yakın sunucu listesini Ookla\'dan yeniden al', 'Fetch the nearby server list from Ookla again'}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xE72C;" Style="{StaticResource T.Icon}" FontSize="12" Margin="0,0,7,0" />
                                                                <TextBlock Text="{l:T 'Yenile', 'Refresh'}" FontSize="12.5" />
                                                            </StackPanel>
                                                        </Button>
                                                    </Grid>

                                                    <Button x:Name="AutoSelectServerButton" HorizontalAlignment="Center" Margin="0,14,0,0" FontSize="14"
                                                            Command="{Binding AutoSelectServerCommand}" ToolTip="{l:T 'Sunucuyu her testte Ookla seçer', 'Ookla chooses the server for each test'}">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource Btn.Link}">
                                                                <Style.Triggers>
                                                                    <!-- Otomatik zaten seçiliyse yeşil onay işaretiyle belirtilir (tekrar tıklamak bir şey değiştirmez) -->
                                                                    <DataTrigger Binding="{Binding IsAutoSelected}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource B.Green}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock FontSize="13" Margin="0,0,8,0">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource T.Icon}">
                                                                        <Setter Property="Text" Value="&#xE707;" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsAutoSelected}" Value="True">
                                                                                <Setter Property="Text" Value="&#xE73E;" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBlock Text="{Binding AutoSelectText}" />
                                                        </StackPanel>
                                                    </Button>

                                                    <Grid Margin="0,14,0,0" Height="40">
                                                        <Border CornerRadius="20" Background="{DynamicResource B.RowBg}" BorderBrush="{DynamicResource B.Border}" BorderThickness="1" />
                                                        <TextBox x:Name="SpeedServerSearch" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Margin="16,0"
                                                                 Background="Transparent" BorderThickness="0" Foreground="{DynamicResource B.Text}" CaretBrush="{DynamicResource B.Neon}"
                                                                 FontSize="13.5" VerticalContentAlignment="Center" AutomationProperties.Name="{l:T 'Sunucu ara', 'Search servers'}" />
                                                        <TextBlock Text="{l:T 'Ara (şehir, sağlayıcı veya sunucu no)', 'Search (city, provider or server ID)'}" FontSize="13.5" Foreground="{DynamicResource B.Text3}" Margin="19,0"
                                                                   VerticalAlignment="Center" IsHitTestVisible="False"
                                                                   Visibility="{Binding SearchText, Converter={StaticResource Hidden}}" />
                                                    </Grid>

                                                    <TextBlock Text="{l:T 'Size en yakın sunucular:', 'Servers nearest to you:'}" FontSize="12.5" Foreground="{DynamicResource B.Text3}" Margin="2,16,0,6" />
                                                    <ItemsControl x:Name="SpeedServerList" ItemsSource="{Binding Servers}" Focusable="False">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type vm:OoklaServerViewModel}">
                                                                <Button Style="{StaticResource Btn.ServerRow}" ToolTip="{Binding ToolTip}" Margin="0,0,0,2"
                                                                        AutomationProperties.Name="{Binding Sponsor}"
                                                                        Command="{Binding DataContext.SelectServerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        CommandParameter="{Binding}">
                                                                    <TextBlock TextTrimming="CharacterEllipsis">
                                                                        <Run Text="{Binding City, Mode=OneWay}" FontWeight="Bold" Foreground="{DynamicResource B.Text}" />
                                                                        <Run Text=" - " />
                                                                        <Run Text="{Binding Sponsor, Mode=OneWay}" />
                                                                    </TextBlock>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <TextBlock Text="{l:T 'Aramayla eşleşen sunucu yok.', 'No servers match your search.'}" FontSize="12.5" Foreground="{DynamicResource B.Text3}" Margin="16,6,0,0"
                                                               Visibility="{Binding HasServers, Converter={StaticResource Hidden}}" />
                                                    <TextBlock Text="{Binding ServersStatusText}" FontSize="11.5" Foreground="{DynamicResource B.Text3}" Margin="2,12,0,0" TextWrapping="Wrap" />
                                                    <Border Height="1" Background="{DynamicResource B.Border}" Margin="0,14,0,10" />
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding OoklaToolText}" FontSize="11.5" Foreground="{DynamicResource B.Text3}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                        <Button Grid.Column="1" Style="{StaticResource Btn.Link}" FontSize="12" Margin="12,0,0,0" Command="{Binding RevokeOoklaLicenseCommand}"
                                                                ToolTip="{l:T 'Ookla aracı, koşullar yeniden kabul edilene kadar çalıştırılmaz', 'The Ookla tool will not run until the terms are accepted again'}">
                                                            <TextBlock Text="{l:T 'Koşulların kabulünü geri al', 'Withdraw acceptance of the terms'}" />
                                                        </Button>
                                                    </Grid>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>

                        <!-- ============ Sonuçlar (hız testi geçmişi; IP adresi kaydedilmez) ============ -->
                        <Grid Grid.Row="1" Margin="8,0,8,8" DataContext="{Binding SpeedTest}"
                              Visibility="{Binding DataContext.CurrentSectionKey, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource SectionVisible}, ConverterParameter=speed-history}">
                            <Border Style="{StaticResource CardShadowLayer}" />
                            <Border Style="{StaticResource Card.Flat}" Padding="20,16,20,14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Style="{StaticResource T.SettingDesc}" Margin="2,0,0,12"
                                               Text="{l:T 'Bu bilgisayarda yapılan hız testleri (en yenisi üstte, en fazla 50). Hızlar Mbps, ping ms cinsindendir; yük altında = indirme / yükleme sırasında. Ayrıntılar için satırın üzerine gelin. Sonuçlar yalnızca bu bilgisayarda saklanır; IP adresi kaydedilmez.', 'Speed tests run on this computer (newest first, up to 50). Speeds are in Mbps, ping in ms; under load = during download / upload. Hover over a row for details. Results are stored only on this computer; no IP address is recorded.'}" />
                                    <DataGrid x:Name="SpeedHistoryGrid" Grid.Row="1" ItemsSource="{Binding History}">
                                        <DataGrid.RowStyle>
                                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                                <Setter Property="ToolTip" Value="{Binding SummaryText}" />
                                            </Style>
                                        </DataGrid.RowStyle>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="{l:T 'TARİH', 'DATE'}" Binding="{Binding TimeText}" Width="130" />
                                            <DataGridTextColumn Header="{l:T 'İNDİRME', 'DOWNLOAD'}" Binding="{Binding DownloadText}" Width="88" />
                                            <DataGridTextColumn Header="{l:T 'YÜKLEME', 'UPLOAD'}" Binding="{Binding UploadText}" Width="88" />
                                            <DataGridTextColumn Header="{l:T 'PİNG', 'PING'}" Binding="{Binding PingText}" Width="60" />
                                            <DataGridTextColumn Header="{l:T 'YÜK ALTINDA', 'UNDER LOAD'}" Binding="{Binding LoadedPingText}" Width="104" />
                                            <DataGridTextColumn Header="{l:T 'KAYIP', 'LOSS'}" Binding="{Binding PacketLossText}" Width="62" />
                                            <DataGridTextColumn Header="{l:T 'ALTYAPI', 'ENGINE'}" Binding="{Binding ConnectionsText}" Width="108" />
                                            <DataGridTemplateColumn Header="{l:T 'SUNUCU', 'SERVER'}" Width="*" MinWidth="110">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding ServerShort}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource B.Text2}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="{l:T 'VERİ', 'DATA'}" Binding="{Binding DataText}" Width="68" />
                                            <DataGridTemplateColumn Header="{l:T 'SONUÇ', 'RESULT'}" Width="120">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"
                                                                     Fill="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                                            <TextBlock Text="{Binding ResultText}" TextTrimming="CharacterEllipsis" MaxWidth="92"
                                                                       Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock Grid.Row="1" VerticalAlignment="Top" Margin="10,52,10,0" FontSize="12.5" TextWrapping="Wrap"
                                               Foreground="{DynamicResource B.Text3}" Visibility="{Binding HasHistory, Converter={StaticResource Hidden}}"
                                               Text="{l:T 'Henüz hız testi yapılmadı. Hız Testi bölmesindeki BAŞLAT düğmesiyle ilk testi yapabilirsiniz.', 'No speed test yet. Run your first test with the START button in the Speed Test section.'}" />
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- ============ Yöntem (nasıl ölçülür) ============ -->
                        <ScrollViewer x:Name="SpeedMethodScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0"
                                      Visibility="{Binding CurrentSectionKey, Converter={StaticResource SectionVisible}, ConverterParameter=speed-method}">
                            <Grid Margin="8,0,8,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MaxWidth="1120" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource IconTile}">
                                            <TextBlock Text="&#xE968;" Style="{StaticResource T.TileIcon}" />
                                        </Border>
                                        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="22,16">
                                            <StackPanel>
                                                <TextBlock Text="{l:T 'Sunucu ve altyapı', 'Server and engine'}" Style="{StaticResource T.H2}" FontSize="16" />
                                                <TextBlock Style="{StaticResource T.SettingDesc}" FontSize="12.5" Margin="0,8,0,0"
                                                           Text="{l:T 'Speedtest by Ookla: ölçümü Ookla\'nın resmi aracı (Speedtest CLI) seçtiğiniz sunucuyla (veya Otomatik\'te Ookla\'nın seçtiği sunucuyla) yapar; ping, titreşim, paket kaybı ve hızlar Ookla\'nın yöntemiyle ölçülür, yük altındaki gecikme çeyrekler arası ortalamadır (IQM). Uygulama aracın JSON çıktısındaki değerleri olduğu gibi gösterir; sonuç Ookla\'ya kaydedilir ve bir sonuç sayfası oluşur. Aşağıdaki gecikme, hız ve paket kaybı açıklamaları Cloudflare içindir.', 'Speedtest by Ookla: Ookla\'s official tool (Speedtest CLI) measures with the server you choose (or the one Ookla chooses in Automatic); ping, jitter, packet loss and speeds are measured with Ookla\'s method, and latency under load is the interquartile mean (IQM). The app shows the values from the tool\'s JSON output as they are; the result is recorded by Ookla and a result page is created. The latency, speed and packet loss explanations below apply to Cloudflare.'}" />
                                                <TextBlock Style="{StaticResource T.SettingDesc}" FontSize="12.5" Margin="0,8,0,0"
                                                           Text="{l:T 'Cloudflare: ölçüm herkese açık hız testi altyapısıyla (speed.cloudflare.com, HTTPS) yapılır. Bağlantınız otomatik olarak bir Cloudflare veri merkezine yönlendirilir (anycast); hangisi olduğunu ISS\'nizin yönlendirmesi belirler ve test ekranında gösterilir. Sonuçlar hiçbir yere gönderilmez.', 'Cloudflare: measured with the public speed test infrastructure (speed.cloudflare.com, HTTPS). Your connection is routed automatically to a Cloudflare data center (anycast); your ISP\'s routing decides which one, and it is shown on the test screen. Results are not sent anywhere.'}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource IconTile}">
                                            <TextBlock Text="&#xE916;" Style="{StaticResource T.TileIcon}" />
                                        </Border>
                                        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="22,16">
                                            <StackPanel>
                                                <TextBlock Text="{l:T 'Ping (gecikme) ve titreşim', 'Ping (latency) and jitter'}" Style="{StaticResource T.H2}" FontSize="16" />
                                                <TextBlock Style="{StaticResource T.SettingDesc}" FontSize="12.5" Margin="0,8,0,0"
                                                           Text="{l:T 'Gecikme, sunucuya TCP bağlantısı kurma süresidir (SYN → SYN-ACK, 443 numaralı bağlantı noktası); sunucunun işlem süresini içermez. Boşta 20 ölçümün medyanı gösterilir; titreşim, ardışık ölçümler arasındaki farkların ortalamasıdır. İndirme ve yükleme sırasında 0,5 saniyede bir ölçülen değerler yük altındaki gecikmeyi gösterir (hat doluyken artan gecikme).', 'Latency is the time to open a TCP connection to the server (SYN → SYN-ACK, port 443); it does not include the server\'s processing time. The idle value is the median of 20 measurements; jitter is the average difference between consecutive measurements. Values measured every 0.5 seconds during download and upload show the latency under load (latency that grows while the line is busy).'}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource IconTile}">
                                            <TextBlock Text="&#xEC4A;" Style="{StaticResource T.TileIcon}" />
                                        </Border>
                                        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="22,16">
                                            <StackPanel>
                                                <TextBlock Text="{l:T 'İndirme ve yükleme hızı', 'Download and upload speed'}" Style="{StaticResource T.H2}" FontSize="16" />
                                                <TextBlock Style="{StaticResource T.SettingDesc}" FontSize="12.5" Margin="0,8,0,0"
                                                           Text="{l:T 'Her aşama 10 saniye sürer. Çoklu seçenekte 6, Tek seçenekte 1 TCP bağlantısı kullanılır. Bağlantının hızlanma süresi olan ilk 2 saniye hesaba katılmaz; sonuç, kalan 8 saniyede gerçekten aktarılan bayt ÷ süredir (Mbps = milyon bit/saniye). Gösterge son 1 saniyenin gerçek hızını gösterir. Yükleme rastgele veriyle yapılır; sıkıştırılarak şişirilemez.', 'Each phase takes 10 seconds. Multi uses 6 TCP connections and Single uses 1. The first 2 seconds, while the connection ramps up, are not counted; the result is the bytes actually transferred in the remaining 8 seconds ÷ time (Mbps = million bits per second). The gauge shows the real speed of the last second. Uploads use random data, so compression cannot inflate them.'}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource IconTile}">
                                            <TextBlock Text="&#xE704;" Style="{StaticResource T.TileIcon}" />
                                        </Border>
                                        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="22,16">
                                            <StackPanel>
                                                <TextBlock Text="{l:T 'Paket kaybı', 'Packet loss'}" Style="{StaticResource T.H2}" FontSize="16" />
                                                <TextBlock Style="{StaticResource T.SettingDesc}" FontSize="12.5" Margin="0,8,0,0"
                                                           Text="{l:T 'Gecikme ölçümüyle aynı anda sunucuya 50 ICMP yankı isteği (ping) gönderilir; 1 saniye içinde yanıt gelmeyenlerin oranı paket kaybıdır. Hiç yanıt gelmezse (ağ veya sunucu ICMP\'yi engelliyor olabilir) oran hesaplanmaz, &quot;Ölçülemedi&quot; yazılır.', 'Along with the latency measurement, 50 ICMP echo requests (ping) are sent to the server; the share not answered within 1 second is the packet loss. If no reply arrives at all (the network or server may block ICMP), no rate is calculated and &quot;Not measured&quot; is shown.'}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource IconTile}">
                                            <TextBlock Text="&#xE774;" Style="{StaticResource T.TileIcon}" />
                                        </Border>
                                        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="22,16">
                                            <StackPanel>
                                                <TextBlock Text="{l:T 'Kullanım uygunluğu', 'Suitability for use'}" Style="{StaticResource T.H2}" FontSize="16" />
                                                <TextBlock Style="{StaticResource T.SettingDesc}" FontSize="12.5" Margin="0,8,0,0"
                                                           Text="{l:T 'Web, oyun, video ve görüntülü görüşme puanları (5 nokta) ölçülen değerlerden sabit eşiklerle hesaplanır; tahmin değildir. Web ve video: indirme hızı; oyun: ping, titreşim ve paket kaybı; görüntülü görüşme: indirme ve yüklemenin düşüğü ile ping. Eşikler her simgenin üzerine gelindiğinde gösterilir. Gerekli değer ölçülemediyse puan verilmez.', 'The web, gaming, video and video call ratings (5 dots) are calculated from the measured values with fixed thresholds; they are not estimates. Web and video: download speed; gaming: ping, jitter and packet loss; video call: the lower of download and upload, plus ping. Hover over an icon to see its thresholds. No rating is given if a required value could not be measured.'}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource IconTile}">
                                            <TextBlock Text="&#xE72E;" Style="{StaticResource T.TileIcon}" />
                                        </Border>
                                        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="22,16">
                                            <StackPanel>
                                                <TextBlock Text="{l:T 'Veri kullanımı ve gizlilik', 'Data usage and privacy'}" Style="{StaticResource T.H2}" FontSize="16" />
                                                <TextBlock Style="{StaticResource T.SettingDesc}" FontSize="12.5" Margin="0,8,0,0"
                                                           Text="{l:T 'Test, bağlantı hızına göre onlarca ile yüzlerce MB veri kullanır; gerçek miktar sonuçta yazar. Windows bağlantıyı tarifeli bildiriyorsa test öncesinde onay istenir. Uygulama IP adresini ve konumu yalnızca ekranda gösterir; sonuç geçmişi yalnızca bu bilgisayarda (state.json) saklanır ve IP adresi içermez. Cloudflare seçiliyken sonuçlar hiçbir yere gönderilmez; Speedtest by Ookla seçiliyse Ookla her testin sonucunu, IP adresinizi ve bağlantı bilgilerini kendi koşullarına göre saklar (koşulların kabulü Sunucu bölmesinden geri alınabilir). Kontrol veya güncelleme işlemi sürerken test başlatılamaz; test sürerken de bu işlemler başlatılamaz (ölçümü etkiler).', 'Depending on the connection speed, a test uses tens to hundreds of MB of data; the real amount is shown in the result. If Windows reports the connection as metered, you are asked before the test. The app shows the IP address and location only on screen; the result history is stored only on this computer (state.json) and contains no IP address. With Cloudflare, results are not sent anywhere; with Speedtest by Ookla, Ookla stores every test result, your IP address and connection details under its own terms (you can withdraw acceptance in the Server section). A test cannot start while a check or update is running, and those cannot start during a test (it would affect the measurement).'}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <!-- ================= Detaylı Sonuç paneli (sağdan açılan) ================= -->
        <Grid Grid.Row="1" Visibility="{Binding Detail.IsOpen, Converter={StaticResource Visible}}">
            <Border Background="{DynamicResource B.Overlay}" MouseLeftButtonDown="DetailBackdrop_MouseDown" />
            <Border x:Name="DetailDrawer" DataContext="{Binding Detail}" Style="{StaticResource Card}" Padding="0"
                    HorizontalAlignment="Right" Width="640" Margin="0,6,18,18">
                <Border.RenderTransform>
                    <TranslateTransform />
                </Border.RenderTransform>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Başlık -->
                    <Grid Margin="24,20,14,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource IconBadge}" Width="46" Height="46" CornerRadius="13">
                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource T.Icon}" FontSize="20"
                                       Foreground="{DynamicResource B.Neon}" Effect="{DynamicResource Fx.SoftGlow}" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,10,0" VerticalAlignment="Center">
                            <TextBlock Text="{l:T 'DETAYLI SONUÇ', 'DETAILED RESULT'}" Style="{StaticResource T.Label}" />
                            <TextBlock Text="{Binding Title}" Style="{StaticResource T.H1}" FontSize="19" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource Btn.Ghost}" Width="34" Height="34" Padding="0" VerticalAlignment="Top"
                                Command="{Binding CloseCommand}" ToolTip="{l:T 'Kapat (Esc)', 'Close (Esc)'}">
                            <TextBlock Text="&#xE711;" Style="{StaticResource T.Icon}" FontSize="12" />
                        </Button>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,0,24,22">
                        <StackPanel>
                            <!-- Durum -->
                            <Border Background="{DynamicResource B.RowBg}" BorderBrush="{DynamicResource B.RowBorder}" BorderThickness="1" CornerRadius="11" Padding="14,12">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="28" Height="28" CornerRadius="14" VerticalAlignment="Top"
                                                Background="{Binding Status, Converter={StaticResource StatusSoftBrush}}">
                                            <TextBlock Text="{Binding Status, Converter={StaticResource StatusGlyph}}" Style="{StaticResource T.Icon}" FontSize="12"
                                                       Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="15" FontWeight="SemiBold" Margin="12,3,0,0"
                                                   TextWrapping="Wrap" Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                    </Grid>
                                    <TextBlock Text="{Binding SourceText}" FontSize="11.5" Foreground="{DynamicResource B.Text3}" Margin="40,6,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Genel bilgiler -->
                            <Grid Margin="2,14,0,0" Visibility="{Binding HasData, Converter={StaticResource Visible}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="{l:T 'İşlem', 'Operation'}" FontSize="12" Foreground="{DynamicResource B.Text3}" Margin="0,0,0,7" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding OperationText}" FontSize="12.5" Foreground="{DynamicResource B.Text}" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="1" Text="{l:T 'Son çalıştırılma', 'Last run'}" FontSize="12" Foreground="{DynamicResource B.Text3}" Margin="0,0,0,7" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CompletedText}" FontSize="12.5" Foreground="{DynamicResource B.Text}" />
                                <TextBlock Grid.Row="2" Text="{l:T 'Çalışma süresi', 'Duration'}" FontSize="12" Foreground="{DynamicResource B.Text3}" Margin="0,0,0,7" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DurationText}" FontSize="12.5" Foreground="{DynamicResource B.Text}" />
                                <TextBlock Grid.Row="3" Text="{l:T 'Uygulanabilir işlem sayısı', 'Actionable items'}" FontSize="12" Foreground="{DynamicResource B.Text3}" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ActionableText}" FontSize="12.5" Foreground="{DynamicResource B.Text}" />
                            </Grid>

                            <!-- Sonuç ayrıntıları -->
                            <StackPanel Visibility="{Binding HasData, Converter={StaticResource Visible}}">
                                <TextBlock Text="{l:T 'SONUÇ AYRINTILARI', 'RESULT DETAILS'}" Style="{StaticResource T.Label}" Margin="2,18,0,8" />
                                <TextBlock Text="{Binding Details}" FontSize="12.5" LineHeight="19" TextWrapping="Wrap" Foreground="{DynamicResource B.Text2}"
                                           Visibility="{Binding Details, Converter={StaticResource Visible}}" />
                                <TextBlock Text="{Binding Reason, StringFormat={l:T 'Nedeni / not: {0}', 'Reason / note: {0}'}}" FontSize="12.5" LineHeight="19" TextWrapping="Wrap" Margin="0,6,0,0"
                                           Foreground="{Binding Status, Converter={StaticResource StatusBrush}}"
                                           Visibility="{Binding Reason, Converter={StaticResource Visible}}" />
                            </StackPanel>

                            <!-- Çalıştırılan komutlar -->
                            <StackPanel Visibility="{Binding HasData, Converter={StaticResource Visible}}">
                                <TextBlock Text="{l:T 'ÇALIŞTIRILAN KOMUTLAR', 'COMMANDS RUN'}" Style="{StaticResource T.Label}" Margin="2,18,0,8" />
                                <TextBlock Text="{l:T 'Bu işlemde harici komut çalıştırılmadı; sonuç doğrudan Windows API\'lerinden alındı (ayrıntılar aşağıda).', 'No external command was run in this operation; the result came directly from Windows APIs (details below).'}"
                                           FontSize="12" Foreground="{DynamicResource B.Text3}" TextWrapping="Wrap"
                                           Visibility="{Binding HasCommands, Converter={StaticResource Hidden}}" />
                                <ItemsControl ItemsSource="{Binding Commands}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:CommandDetailViewModel}">
                                            <Border Background="{DynamicResource B.RowBg}" BorderBrush="{DynamicResource B.RowBorder}" BorderThickness="1" CornerRadius="11" Padding="14,12" Margin="0,0,0,10">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Command}" FontFamily="{StaticResource F.Mono}" FontSize="12" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource B.Neon}" />
                                                    <WrapPanel Margin="0,8,0,0">
                                                        <TextBlock FontSize="12" Margin="0,0,18,0" Foreground="{DynamicResource B.Text2}">
                                                            <Run Text="Exit Code:" Foreground="{DynamicResource B.Text3}" />
                                                            <Run Text="{Binding ExitCodeText, Mode=OneWay}" FontWeight="SemiBold" />
                                                        </TextBlock>
                                                        <TextBlock FontSize="12" Margin="0,0,18,0" Foreground="{DynamicResource B.Text2}">
                                                            <Run Text="{l:T 'Süre:', 'Duration:'}" Foreground="{DynamicResource B.Text3}" />
                                                            <Run Text="{Binding DurationText, Mode=OneWay}" />
                                                        </TextBlock>
                                                        <TextBlock FontSize="12" Foreground="{DynamicResource B.Text2}">
                                                            <Run Text="{l:T 'Başlangıç:', 'Started:'}" Foreground="{DynamicResource B.Text3}" />
                                                            <Run Text="{Binding StartedText, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </WrapPanel>
                                                    <TextBlock Text="{l:T 'Çıktı (stdout)', 'Output (stdout)'}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource B.Text3}" Margin="0,10,0,4" />
                                                    <Border Background="{DynamicResource B.DeepBg}" BorderBrush="{DynamicResource B.RowBorder}" BorderThickness="1" CornerRadius="8" Padding="10,8" MaxHeight="220">
                                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                            <TextBox Text="{Binding Output, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"
                                                                     Background="Transparent" Foreground="{DynamicResource B.Text2}" CaretBrush="{DynamicResource B.Neon}"
                                                                     FontFamily="{StaticResource F.Mono}" FontSize="11.5" SelectionBrush="{DynamicResource B.CardBorderHover}" />
                                                        </ScrollViewer>
                                                    </Border>
                                                    <StackPanel Visibility="{Binding HasError, Converter={StaticResource Visible}}">
                                                        <TextBlock Text="{l:T 'Hata çıktısı (stderr)', 'Error output (stderr)'}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource B.Red}" Margin="0,10,0,4" />
                                                        <Border Background="{DynamicResource B.DeepBg}" BorderBrush="#55FF4D61" BorderThickness="1" CornerRadius="8" Padding="10,8" MaxHeight="160">
                                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                                <TextBox Text="{Binding Error, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"
                                                                         Background="Transparent" Foreground="{DynamicResource B.Red}" CaretBrush="{DynamicResource B.Neon}"
                                                                         FontFamily="{StaticResource F.Mono}" FontSize="11.5" SelectionBrush="{DynamicResource B.CardBorderHover}" />
                                                            </ScrollViewer>
                                                        </Border>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Paket bazlı GERÇEK sonuçlar (winget kodu, sembolü, kurulum programı çıkış kodu, winget mesajı) -->
                            <StackPanel Visibility="{Binding HasPackageResults, Converter={StaticResource Visible}}">
                                <TextBlock Text="{Binding PackageResultsTitle}" Style="{StaticResource T.Label}" Margin="2,10,0,8" />
                                <ItemsControl ItemsSource="{Binding PackageResults}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:PackageResultViewModel}">
                                            <Border Background="{DynamicResource B.RowBg}" CornerRadius="10" Padding="14,11" Margin="0,0,0,8"
                                                    BorderBrush="{Binding Status, Converter={StaticResource StatusSoftBrush}}" BorderThickness="1">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource B.Text}" TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding VersionText}" FontSize="12" Margin="0,2,0,0"
                                                                       Foreground="{DynamicResource B.Text2}" FontFamily="{StaticResource F.Mono}" />
                                                        </StackPanel>
                                                        <Border Grid.Column="1" CornerRadius="8" Padding="9,3" Margin="10,0,0,0" VerticalAlignment="Top"
                                                                Background="{Binding Status, Converter={StaticResource StatusSoftBrush}}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Status, Converter={StaticResource StatusGlyph}}" Style="{StaticResource T.Icon}"
                                                                           FontSize="11" Margin="0,0,6,0"
                                                                           Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                                                <TextBlock Text="{Binding OutcomeLabel}" FontSize="11.5" FontWeight="SemiBold"
                                                                           Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>
                                                    <TextBlock Text="{Binding ReasonText}" FontSize="12.5" Margin="0,8,0,0" TextWrapping="Wrap"
                                                               Foreground="{Binding Status, Converter={StaticResource StatusBrush}}"
                                                               Visibility="{Binding HasReason, Converter={StaticResource Visible}}" />
                                                    <TextBlock FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource B.Text2}"
                                                               Visibility="{Binding HasCode, Converter={StaticResource Visible}}">
                                                        <Run Text="{l:T 'Kod: ', 'Code:'}" Foreground="{DynamicResource B.Text3}" /><Run Text="{Binding CodeText, Mode=OneWay}" FontFamily="{StaticResource F.Mono}" />
                                                    </TextBlock>
                                                    <TextBlock FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap" Foreground="{DynamicResource B.Text2}"
                                                               Visibility="{Binding HasInstallerExitCode, Converter={StaticResource Visible}}">
                                                        <Run Text="{l:T 'Kurulum programı çıkış kodu (Exit Code): ', 'Installer exit code:'}" Foreground="{DynamicResource B.Text3}" /><Run Text="{Binding InstallerExitCodeText, Mode=OneWay}" FontFamily="{StaticResource F.Mono}" />
                                                    </TextBlock>
                                                    <TextBlock FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap" Foreground="{DynamicResource B.Text2}"
                                                               Visibility="{Binding HasToolMessage, Converter={StaticResource Visible}}">
                                                        <Run Text="{l:T 'Araç mesajı: ', 'Tool message:'}" Foreground="{DynamicResource B.Text3}" /><Run Text="{Binding ToolMessageText, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <TextBlock FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap" Foreground="{DynamicResource B.Orange}"
                                                               Visibility="{Binding HasBlocking, Converter={StaticResource Visible}}">
                                                        <Run Text="{l:T 'Engelleyen çalışan uygulamalar: ', 'Running apps blocking it:'}" /><Run Text="{Binding BlockingText, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding DetailText}" FontSize="11.5" Margin="0,6,0,0" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource B.Text3}"
                                                               Visibility="{Binding HasDetail, Converter={StaticResource Visible}}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Ek bilgiler (HTTP/API yanıtları vb.) -->
                            <StackPanel Visibility="{Binding HasNotes, Converter={StaticResource Visible}}">
                                <TextBlock Text="{l:T 'EK BİLGİLER', 'ADDITIONAL INFORMATION'}" Style="{StaticResource T.Label}" Margin="2,10,0,8" />
                                <ItemsControl ItemsSource="{Binding Notes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="&#xE76C;" Style="{StaticResource T.Icon}" FontSize="10" Foreground="{DynamicResource B.Neon}"
                                                           VerticalAlignment="Top" Margin="0,3,10,0" />
                                                <TextBox Grid.Column="1" Text="{Binding Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"
                                                         Background="Transparent" Foreground="{DynamicResource B.Text2}" FontSize="12" SelectionBrush="{DynamicResource B.CardBorderHover}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Öğeler -->
                            <StackPanel Visibility="{Binding HasItems, Converter={StaticResource Visible}}">
                                <TextBlock Text="{l:T 'ÖĞELER', 'ITEMS'}" Style="{StaticResource T.Label}" Margin="2,10,0,8" />
                                <DataGrid ItemsSource="{Binding Items}" MaxHeight="320">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{l:T 'AD', 'NAME'}" Binding="{Binding Name}" Width="*" />
                                        <DataGridTextColumn Header="{l:T 'MEVCUT', 'CURRENT'}" Binding="{Binding CurrentVersion}" Width="110" />
                                        <DataGridTextColumn Header="{l:T 'YENİ', 'NEW'}" Binding="{Binding NewVersion}" Width="110" />
                                        <DataGridTemplateColumn Header="{l:T 'DURUM', 'STATUS'}" Width="150">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource B.Green}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding UpdateAvailable}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource B.Orange}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= Zorunlu güncelleme: "Yeni sürüm yayınlandı" ================= -->
        <Grid x:Name="UpdateOverlay" Grid.Row="1" Background="{DynamicResource B.Overlay}" Visibility="{Binding ShowUpdateOverlay, Converter={StaticResource Visible}}">
            <Grid DataContext="{Binding Update}" Width="620" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,20">
                <Border Style="{StaticResource CardShadowLayer}" />
                <Border Style="{StaticResource Card.Flat}" Padding="36,30,36,26">
                    <StackPanel>
                        <!-- parlayan logo (statik) -->
                        <Grid Width="170" Height="104" HorizontalAlignment="Center">
                            <Ellipse IsHitTestVisible="False">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#591FB6FF" Offset="0" />
                                        <GradientStop Color="#1A1FB6FF" Offset="0.5" />
                                        <GradientStop Color="#001FB6FF" Offset="1" />
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Border Width="72" Height="72" CornerRadius="19" BorderThickness="1.5" BorderBrush="{DynamicResource B.NeonBright}"
                                    Effect="{DynamicResource Fx.IconGlow}">
                                <Rectangle RadiusX="17" RadiusY="17" Fill="{StaticResource LogoBrush}" />
                            </Border>
                        </Grid>
                        <TextBlock Text="{l:T 'Yeni sürüm yayınlandı', 'A new version is available'}" FontFamily="{StaticResource F.Display}" FontSize="25" FontWeight="SemiBold"
                                   Foreground="{DynamicResource B.Text}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        <TextBlock x:Name="UpdateNewVersion" Text="{Binding NewVersionText}" FontFamily="{StaticResource F.Display}" FontSize="34"
                                   FontWeight="Bold" Foreground="{DynamicResource B.NeonBright}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding DetailText}" FontSize="12.5" Foreground="{DynamicResource B.Text2}" HorizontalAlignment="Center"
                                   TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0" />

                        <!-- sürüm notları (GitHub yayınındaki gerçek metin) -->
                        <Border Margin="0,18,0,0" CornerRadius="12" Background="{DynamicResource B.DeepBg}" BorderBrush="{DynamicResource B.InfoBoxBorder}" BorderThickness="1"
                                Visibility="{Binding HasNotes, Converter={StaticResource Visible}}">
                            <ScrollViewer MaxHeight="170" VerticalScrollBarVisibility="Auto" Padding="16,12,10,12" Focusable="False">
                                <StackPanel>
                                    <TextBlock Text="{l:T 'YENİLİKLER', 'WHAT\'S NEW'}" Style="{StaticResource T.Label}" Foreground="{DynamicResource B.NeonBright}" Margin="0,0,0,6" />
                                    <TextBlock Text="{Binding NotesText}" FontSize="12.5" LineHeight="18" Foreground="{DynamicResource B.Text}" TextWrapping="Wrap" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <TextBlock Text="{Binding PortableNote}" FontSize="12" Foreground="{DynamicResource B.Text3}" TextWrapping="Wrap" TextAlignment="Center"
                                   Margin="0,12,0,0" Visibility="{Binding PortableNote, Converter={StaticResource Visible}}" />

                        <!-- indirme (gerçek bayt ilerlemesi) -->
                        <StackPanel Margin="0,18,0,0" Visibility="{Binding IsWorking, Converter={StaticResource Visible}}">
                            <Grid>
                                <TextBlock Text="{Binding StatusText}" FontSize="12.5" Foreground="{DynamicResource B.Text}" />
                                <TextBlock Text="{Binding ProgressText}" FontSize="12" Foreground="{DynamicResource B.Text2}" HorizontalAlignment="Right" />
                            </Grid>
                            <ProgressBar x:Name="UpdateProgress" Style="{StaticResource Progress.Neon}" Minimum="0" Maximum="1"
                                         Value="{Binding Progress, Mode=OneWay}" Margin="0,8,0,0" />
                        </StackPanel>

                        <TextBlock x:Name="UpdateError" Text="{Binding ErrorText}" FontSize="12.5" Foreground="{DynamicResource B.Orange}" TextWrapping="Wrap"
                                   TextAlignment="Center" Margin="0,14,0,0" Visibility="{Binding ErrorText, Converter={StaticResource Visible}}" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
                            <Button Style="{StaticResource Btn.Secondary}" Content="{l:T 'Uygulamayı kapat', 'Close the app'}" Width="170" Height="48"
                                    Command="{Binding CloseAppCommand}" Margin="0,0,12,0" />
                            <Button x:Name="UpdateButton" Style="{StaticResource Btn.Primary}" Width="230" Height="48" Command="{Binding UpdateCommand}"
                                    AutomationProperties.Name="{Binding ButtonText}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE896;" Style="{StaticResource T.Icon}" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding ButtonText}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock FontSize="11" Foreground="{DynamicResource B.Text3}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,16,0,0"
                                   Text="{l:T 'Bu güncelleme zorunludur; yeni sürüm kurulana kadar uygulama kullanılamaz. İndirilen dosya GitHub\'ın bildirdiği SHA-256 özeti, boyutu ve sürümüyle doğrulanır; kurulum bitince yeni sürüm kendiliğinden açılır.', 'This update is required; the app cannot be used until the new version is installed. The downloaded file is verified against the SHA-256 hash, size and version reported by GitHub; the new version opens automatically when setup finishes.'}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ================= İnternet bağlantısı yok (KULLANICI KARARI 2026-09-27: internetsiz kullanılamaz) ================= -->
        <Grid x:Name="OfflineOverlay" Grid.Row="1" Background="{DynamicResource B.Overlay}" Visibility="{Binding ShowOfflineOverlay, Converter={StaticResource Visible}}">
            <Grid Width="580" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,20">
                <Border Style="{StaticResource CardShadowLayer}" />
                <Border Style="{StaticResource Card.Flat}" Padding="36,30,36,26">
                    <StackPanel>
                        <Grid Width="150" Height="100" HorizontalAlignment="Center">
                            <Ellipse IsHitTestVisible="False">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#4DFF4D61" Offset="0" />
                                        <GradientStop Color="#14FF4D61" Offset="0.5" />
                                        <GradientStop Color="#00FF4D61" Offset="1" />
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Border Width="70" Height="70" CornerRadius="19" BorderThickness="1.5" BorderBrush="{DynamicResource B.Red}" Background="#1FFF4D61">
                                <TextBlock Text="&#xE774;" Style="{StaticResource T.Icon}" FontSize="30" Foreground="{DynamicResource B.Red}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <TextBlock Text="{l:T 'İnternet bağlantısı yok', 'No internet connection'}" FontFamily="{StaticResource F.Display}" FontSize="25" FontWeight="SemiBold"
                                   Foreground="{DynamicResource B.Text}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        <TextBlock FontSize="13" Foreground="{DynamicResource B.Text}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0"
                                   Text="{l:T 'Uygulama internet bağlantısı olmadan kullanılamaz. Wi-Fi veya Ethernet bağlantınızı kontrol edin; bağlantı gelince bu ekran kendiliğinden kapanır ve kaldığınız yerden devam edersiniz.', 'The app cannot be used without an internet connection. Check your Wi-Fi or Ethernet connection; this screen closes automatically when the connection is back and you continue where you left off.'}" />
                        <TextBlock x:Name="OfflineDetail" Text="{Binding OfflineDetailText}" FontSize="12" Foreground="{DynamicResource B.Text2}"
                                   TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
                            <Button Style="{StaticResource Btn.Secondary}" Content="{l:T 'Uygulamayı kapat', 'Close the app'}" Width="170" Height="48"
                                    Command="{Binding ExitAppCommand}" Margin="0,0,12,0" />
                            <Button x:Name="OfflineRetryButton" Style="{StaticResource Btn.Primary}" Width="200" Height="48"
                                    Command="{Binding RetryInternetCommand}" AutomationProperties.Name="{Binding RetryInternetText}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72C;" Style="{StaticResource T.Icon}" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding RetryInternetText}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock FontSize="11" Foreground="{DynamicResource B.Text3}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,16,0,0"
                                   Text="{l:T 'Bağlantı Windows\'un kendi bağlantı testi adresleriyle denetlenir; internet yokken 15 saniyede bir yeniden denenir.', 'The connection is checked with Windows\' own connectivity test addresses; while offline it is retried every 15 seconds.'}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ================= İletişim kutusu katmanı ================= -->
        <Grid Grid.Row="1" Visibility="{Binding Dialog.IsOpen, Converter={StaticResource Visible}}" Background="{DynamicResource B.Overlay}">
            <Border x:Name="DialogCard" DataContext="{Binding Dialog}" Style="{StaticResource Card}" Padding="32,30" Width="640"
                    HorizontalAlignment="Center" VerticalAlignment="Center" MaxHeight="780"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                </Border.RenderTransform>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="52" Height="52" CornerRadius="16" BorderThickness="1"
                                    BorderBrush="{Binding Kind, Converter={StaticResource DialogBrush}}">
                                <Border.Background>
                                    <DynamicResource ResourceKey="B.DialogIconBg" />
                                </Border.Background>
                                <TextBlock Text="{Binding Glyph}" Style="{StaticResource T.Icon}" FontSize="22"
                                           Foreground="{Binding Kind, Converter={StaticResource DialogBrush}}" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="{Binding Title}" Style="{StaticResource T.H1}" FontSize="22"
                                       VerticalAlignment="Center" Margin="16,0,0,0" TextWrapping="Wrap" />
                        </Grid>
                        <TextBlock Text="{Binding Message}" Style="{StaticResource T.Body}" Margin="0,18,0,0" FontSize="13.5" LineHeight="21" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                        <StackPanel>
                            <!-- Onay maddeleri -->
                            <ItemsControl ItemsSource="{Binding Bullets}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource B.RowBg}" CornerRadius="10" Padding="14,11" Margin="0,0,0,8"
                                                BorderBrush="{DynamicResource B.RowBorder}" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="&#xE76C;" Style="{StaticResource T.Icon}" FontSize="11" Foreground="{DynamicResource B.Neon}"
                                                           VerticalAlignment="Top" Margin="0,4,12,0" />
                                                <TextBlock Grid.Column="1" Text="{Binding}" Style="{StaticResource T.Body}" Foreground="{DynamicResource B.Text}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Seçilebilir kategoriler (Geçici Dosyalar): kontrolde ölçülen GERÇEK boyutlar; varsayılan olarak işaretli -->
                            <StackPanel Margin="0,6,0,8" Visibility="{Binding HasChoices, Converter={StaticResource Visible}}">
                                <TextBlock Text="{Binding ChoicesTitle}" Style="{StaticResource T.Label}" Margin="2,0,0,10" />
                                <ItemsControl ItemsSource="{Binding Choices}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ChoiceItemViewModel}">
                                            <Border Background="{DynamicResource B.RowBg}" CornerRadius="10" Padding="12,9" Margin="0,0,0,6"
                                                    BorderBrush="{DynamicResource B.RowBorder}" BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Style="{StaticResource SelectCheck}" Margin="0,0,12,0" ToolTip="{l:T 'Bu kategoriyi temizlemeye dahil et', 'Include this category in the cleanup'}"
                                                              IsChecked="{Binding IsChecked}" AutomationProperties.Name="{Binding Label}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="13" Foreground="{DynamicResource B.Text}"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontSize="12.5" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource B.Neon}" VerticalAlignment="Center" Margin="10,0,0,0" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding ChoicesTotalText}" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Right"
                                           Foreground="{DynamicResource B.Text2}" Margin="0,4,4,0" />
                            </StackPanel>

                            <!-- Sonuç satırları -->
                            <ItemsControl ItemsSource="{Binding Results}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ResultRowViewModel}">
                                        <Border Background="{DynamicResource B.RowBg}" CornerRadius="11" Padding="14,12" Margin="0,0,0,8"
                                                BorderBrush="{DynamicResource B.RowBorder}" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Style="{StaticResource IconBadge}" Width="36" Height="36" VerticalAlignment="Top">
                                                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource T.Icon}" FontSize="16" Foreground="{DynamicResource B.Neon}" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="14,0,10,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" Style="{StaticResource T.H2}" FontSize="14" />
                                                    <TextBlock Text="{Binding Summary}" FontSize="12.5" Margin="0,2,0,0" TextWrapping="Wrap"
                                                               Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                                    <TextBlock Text="{Binding Reason, StringFormat={l:T 'Nedeni: {0}', 'Reason: {0}'}}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource B.Text2}"
                                                               Visibility="{Binding HasReason, Converter={StaticResource Visible}}" />
                                                </StackPanel>
                                                <Border Grid.Column="2" Width="30" Height="30" CornerRadius="15" VerticalAlignment="Top"
                                                        Background="{Binding Status, Converter={StaticResource StatusSoftBrush}}">
                                                    <TextBlock Text="{Binding Status, Converter={StaticResource StatusGlyph}}" Style="{StaticResource T.Icon}" FontSize="13"
                                                               Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                        <Button Style="{StaticResource Btn.Secondary}" Margin="0,0,10,0" Command="{Binding TertiaryCommand}"
                                Visibility="{Binding HasTertiary, Converter={StaticResource Visible}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE777;" Style="{StaticResource T.Icon}" FontSize="14" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding TertiaryText}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Btn.Secondary}" Margin="0,0,10,0" Content="{Binding SecondaryText}" MinWidth="110"
                                Command="{Binding SecondaryCommand}" IsCancel="True" Visibility="{Binding HasSecondary, Converter={StaticResource Visible}}" />
                        <Button Style="{StaticResource Btn.Primary}" Height="44" MinWidth="150" Content="{Binding PrimaryText}"
                                Command="{Binding PrimaryCommand}" IsDefault="True" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
