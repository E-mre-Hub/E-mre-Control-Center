<Window x:Class="RtxWindowsUpdater.Views.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:RtxWindowsUpdater.Views"
        Title="E-mre Control Center Kurulum"
        Icon="pack://application:,,,/Assets/E-mreLogo.ico"
        Width="780" Height="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="{StaticResource B.Bg0}"
        FontFamily="{StaticResource F.Text}"
        Foreground="{StaticResource B.Text}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SetupResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="RootGrid" Background="{StaticResource B.WindowBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Statik dalga zemini (animasyon yok, önbellekli) -->
        <views:WaveBackdrop Grid.RowSpan="2" LineBrush="#FF2E4468" LineCount="30" IsHitTestVisible="False">
            <views:WaveBackdrop.CacheMode>
                <BitmapCache />
            </views:WaveBackdrop.CacheMode>
        </views:WaveBackdrop>

        <!-- Başlık çubuğu -->
        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Style="{StaticResource Btn.Caption}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Simge durumuna küçült" />
                <Button Style="{StaticResource Btn.CaptionClose}" Content="&#xE8BB;" Command="{Binding CloseCommand}" ToolTip="Kapat"
                        AutomationProperties.Name="Kurulumu kapat" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                <Rectangle Width="18" Height="18" RadiusX="4" RadiusY="4" Fill="{StaticResource LogoBrush}" />
                <TextBlock Text="E-mre Control Center Kurulum" FontSize="12.5" Foreground="{StaticResource B.Text2}" Margin="10,0,0,0"
                           VerticalAlignment="Center" />
            </StackPanel>
        </DockPanel>

        <!-- ============ Karşılama ============ -->
        <Grid x:Name="WelcomePage" Grid.Row="1" Visibility="{Binding IsWelcome, Converter={StaticResource Visible}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="560" Margin="0,0,0,24">
                <ContentControl Template="{StaticResource LogoGlow}" Focusable="False" />
                <TextBlock Text="E-mre Control Center" FontFamily="{StaticResource F.Display}" FontSize="30" Foreground="White"
                           HorizontalAlignment="Center" Margin="0,4,0,4" />
                <TextBlock Style="{StaticResource T.Label}" FontSize="11.5" Foreground="{StaticResource B.NeonBright}" HorizontalAlignment="Center">
                    <Run Text="KONTROL MERKEZİ · SÜRÜM" />
                    <Run Text="{Binding Version, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Text="Windows 11 için güncelleme, temizlik, sistem sağlığı ve hız testi merkezi." FontSize="13.5"
                           Foreground="{StaticResource B.Text2}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,14,0,0" />

                <Border Margin="0,22,0,0" Padding="16,12" CornerRadius="12" Background="#B30A1426" BorderBrush="#FF1E3050" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE8B7;" Style="{StaticResource T.Icon}" FontSize="16" Foreground="{StaticResource B.NeonBright}"
                                   VerticalAlignment="Top" Margin="0,1,12,0" />
                        <TextBlock x:Name="InstallStateText" Grid.Column="1" Text="{Binding InstallStateText}" FontSize="12.5" LineHeight="18"
                                   Foreground="{StaticResource B.Text}" TextWrapping="Wrap" />
                    </Grid>
                </Border>

                <CheckBox x:Name="DesktopCheck" Content="Masaüstüne kısayol ekle" IsChecked="{Binding DesktopShortcut}" HorizontalAlignment="Center"
                          Margin="0,16,0,0" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
                    <Button Style="{StaticResource Btn.Secondary}" Content="İptal" Width="130" Height="48" Command="{Binding CloseCommand}" Margin="0,0,12,0" />
                    <Button x:Name="InstallButton" Style="{StaticResource Btn.Primary}" Width="230" Height="48" Command="{Binding InstallCommand}"
                            AutomationProperties.Name="{Binding ActionText}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" Style="{StaticResource T.Icon}" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ActionText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <TextBlock Text="{Binding ElevationError}" FontSize="12.5" Foreground="{StaticResource B.Orange}" TextWrapping="Wrap"
                           TextAlignment="Center" Margin="0,14,0,0" Visibility="{Binding ElevationError, Converter={StaticResource Visible}}" />
                <TextBlock FontSize="11.5" Foreground="{StaticResource B.Text3}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,14,0,0"
                           Text="Kurulum Windows'tan yönetici izni ister. Uygulama dijital olarak imzalanmadığı için izin penceresinde yayıncı &quot;Bilinmeyen&quot; görünür." />
            </StackPanel>
        </Grid>

        <!-- ============ Kuruluyor ============ -->
        <ScrollViewer x:Name="WorkingPage" Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False"
                      Visibility="{Binding IsWorking, Converter={StaticResource Visible}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="540" Margin="0,8,0,24">
                <TextBlock Text="{Binding StatusText}" FontFamily="{StaticResource F.Display}" FontSize="23" Foreground="White" />
                <ProgressBar Style="{StaticResource Progress.Neon}" Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay}" Margin="0,14,0,22" />
                <ItemsControl ItemsSource="{Binding Steps}" ItemTemplate="{StaticResource SetupStepTemplate}" Focusable="False" />
            </StackPanel>
        </ScrollViewer>

        <!-- ============ Tamamlandı: teşekkür + hoş geldin ============ -->
        <Grid x:Name="DonePage" Grid.Row="1" Visibility="{Binding IsDone, Converter={StaticResource Visible}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="600" Margin="0,0,0,24">
                <ContentControl Template="{StaticResource LogoGlow}" Focusable="False" />
                <TextBlock Text="{Binding DoneTitle}" FontFamily="{StaticResource F.Display}" FontSize="28" FontWeight="SemiBold"
                           Foreground="White" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0" />
                <TextBlock Text="{Binding DoneSubtitle}" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource B.NeonBright}"
                           HorizontalAlignment="Center" Margin="0,8,0,0" />
                <TextBlock Text="{Binding DoneDetail}" FontSize="12.5" Foreground="{StaticResource B.Text2}" HorizontalAlignment="Center"
                           TextAlignment="Center" TextWrapping="Wrap" Margin="0,20,0,0" />
                <TextBlock Text="{Binding DoneShortcutText}" FontSize="12" Foreground="{StaticResource B.Text3}" HorizontalAlignment="Center"
                           TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0" />
                <CheckBox x:Name="LaunchCheck" Content="E-mre Control Center'ı şimdi başlat" IsChecked="{Binding LaunchAfter}" HorizontalAlignment="Center"
                          Margin="0,22,0,0" />
                <TextBlock Text="{Binding LaunchError}" FontSize="12.5" Foreground="{StaticResource B.Orange}" TextWrapping="Wrap" TextAlignment="Center"
                           Margin="0,10,0,0" Visibility="{Binding LaunchError, Converter={StaticResource Visible}}" />
                <Button x:Name="FinishButton" Style="{StaticResource Btn.Primary}" Content="Bitir" Width="210" Height="48" Command="{Binding FinishCommand}"
                        HorizontalAlignment="Center" Margin="0,20,0,0" />
            </StackPanel>
        </Grid>

        <!-- ============ Hata (gerçek neden + geri alınanlar); uzun ayrıntı kayar, butonlar hep görünür ============ -->
        <Grid x:Name="FailedPage" Grid.Row="1" Margin="0,0,0,22" Visibility="{Binding IsFailed, Converter={StaticResource Visible}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="560" Margin="0,8,0,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE783;" Style="{StaticResource T.Icon}" FontSize="24" Foreground="{StaticResource B.Red}" Margin="0,0,12,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="Kurulum tamamlanamadı" FontFamily="{StaticResource F.Display}" FontSize="23" Foreground="White" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding FailText}" FontSize="13" LineHeight="19" Foreground="{StaticResource B.Text}" TextWrapping="Wrap" Margin="0,14,0,0" />
                    <TextBlock Text="{Binding RollbackText}" FontSize="12.5" Foreground="{StaticResource B.Text2}" TextWrapping="Wrap" Margin="0,8,0,0"
                               Visibility="{Binding RollbackText, Converter={StaticResource Visible}}" />
                    <ItemsControl ItemsSource="{Binding Steps}" ItemTemplate="{StaticResource SetupStepTemplate}" Focusable="False" Margin="0,18,0,0" />
                    <TextBlock FontSize="11.5" Foreground="{StaticResource B.Text3}" TextWrapping="Wrap" Margin="0,4,0,0">
                        <Run Text="Kurulum günlüğü:" />
                        <Run Text="{Binding LogPath, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </ScrollViewer>
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                <Button Style="{StaticResource Btn.Secondary}" Content="Kapat" Width="130" Height="46" Command="{Binding CloseCommand}" Margin="0,0,12,0" />
                <Button x:Name="RetryButton" Style="{StaticResource Btn.Primary}" Content="Tekrar dene" Width="190" Height="46" Command="{Binding RetryCommand}" />
            </StackPanel>
        </Grid>

        <!-- Açık uygulama onayı -->
        <ContentControl Grid.RowSpan="2" Content="{Binding RunningPrompt}" ContentTemplate="{StaticResource RunningPromptTemplate}" Focusable="False"
                        Visibility="{Binding RunningPrompt.IsOpen, Converter={StaticResource Visible}}" />
    </Grid>
</Window>
