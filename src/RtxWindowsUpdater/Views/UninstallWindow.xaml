<Window x:Class="RtxWindowsUpdater.Views.UninstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:RtxWindowsUpdater.Views"
        xmlns:vm="clr-namespace:RtxWindowsUpdater.ViewModels"
        xmlns:views="clr-namespace:RtxWindowsUpdater.Views"
        Title="{l:T 'E-mre Control Center Kaldırma', 'E-mre Control Center Uninstall'}"
        Icon="pack://application:,,,/Assets/E-mreLogo.ico"
        Width="920" Height="620"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="{DynamicResource B.Bg0}"
        FontFamily="{StaticResource F.Text}"
        Foreground="{DynamicResource B.Text}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SetupResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- "Kaldırılacaklar" satırı -->
            <Style x:Key="RemoveItemIcon" TargetType="TextBlock" BasedOn="{StaticResource T.Icon}">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="Foreground" Value="{DynamicResource B.NeonBright}" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="Margin" Value="0,2,12,0" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="RootGrid" Background="{DynamicResource B.WindowBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <views:WaveBackdrop Grid.RowSpan="2" LineBrush="{DynamicResource B.WaveLine}" LineCount="30" IsHitTestVisible="False">
            <views:WaveBackdrop.CacheMode>
                <BitmapCache />
            </views:WaveBackdrop.CacheMode>
        </views:WaveBackdrop>

        <!-- Başlık çubuğu -->
        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <Button x:Name="ThemeButton" Style="{StaticResource Btn.Caption}" FontSize="13" Click="Theme_Click" />
                <Button Style="{StaticResource Btn.Caption}" Content="&#xE921;" Click="Minimize_Click" ToolTip="{l:T 'Simge durumuna küçült', 'Minimize'}" />
                <Button Style="{StaticResource Btn.CaptionClose}" Content="&#xE8BB;" Command="{Binding CloseCommand}" ToolTip="{l:T 'Kapat', 'Close'}"
                        AutomationProperties.Name="{l:T 'Kaldırmayı kapat', 'Close uninstall'}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                <Rectangle Width="18" Height="18" RadiusX="4" RadiusY="4" Fill="{StaticResource LogoBrush}" />
                <TextBlock Text="{l:T 'E-mre Control Center Kaldırma', 'E-mre Control Center Uninstall'}" FontSize="12.5" Foreground="{DynamicResource B.Text2}" Margin="10,0,0,0"
                           VerticalAlignment="Center" />
            </StackPanel>
        </DockPanel>

        <!-- ============ Form: solda veda, sağda "Neden kaldırıyorsunuz?" ============ -->
        <Grid x:Name="FormPage" Grid.Row="1" Margin="44,4,40,30" Visibility="{Binding IsForm, Converter={StaticResource Visible}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="36" />
                <ColumnDefinition Width="430" />
            </Grid.ColumnDefinitions>

            <!-- Sol: veda mesajı + kaldırılacaklar + veri seçeneği -->
            <StackPanel VerticalAlignment="Center">
                <ContentControl Template="{StaticResource LogoGlow}" Focusable="False" HorizontalAlignment="Left" Margin="-52,0,0,0" />
                <TextBlock Text="{l:T 'Bir dahaki sefere görüşmek üzere!', 'See you next time!'}" FontFamily="{StaticResource F.Display}" FontSize="29" FontWeight="SemiBold"
                           Foreground="{DynamicResource B.Text}" TextWrapping="Wrap" LineHeight="36" Margin="0,4,0,0" />
                <TextBlock Text="{l:T 'E-mre Control Center bilgisayarınızdan kaldırılacak.', 'E-mre Control Center will be removed from your computer.'}" FontSize="14" Foreground="{DynamicResource B.Text2}"
                           TextWrapping="Wrap" Margin="0,10,0,0" />

                <TextBlock Text="{l:T 'KALDIRILACAKLAR', 'WILL BE REMOVED'}" Style="{StaticResource T.Label}" Foreground="{DynamicResource B.NeonBright}" Margin="0,24,0,10" />
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE8B7;" Style="{StaticResource RemoveItemIcon}" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{l:T 'Program dosyaları', 'Program files'}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource B.Text}" />
                        <TextBlock Text="{Binding InstallDir}" FontSize="11.5" Foreground="{DynamicResource B.Text3}" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE71B;" Style="{StaticResource RemoveItemIcon}" />
                    <TextBlock Grid.Column="1" Text="{l:T 'Başlat menüsü ve masaüstü kısayolları', 'Start menu and desktop shortcuts'}" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource B.Text}" />
                </Grid>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE71D;" Style="{StaticResource RemoveItemIcon}" />
                    <TextBlock Grid.Column="1" Text="{l:T 'Windows Ayarlar → Uygulamalar kaydı ve geçici dosyalar', 'Windows Settings → Apps entry and temporary files'}" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource B.Text}" TextWrapping="Wrap" />
                </Grid>

                <CheckBox x:Name="DeleteDataCheck" IsChecked="{Binding DeleteUserData}" Margin="0,16,0,0">
                    <TextBlock Text="{l:T 'Ayarlarımı, geçmişimi ve günlüklerimi de sil', 'Also delete my settings, history and logs'}" FontSize="13.5" />
                </CheckBox>
                <TextBlock FontSize="11.5" Foreground="{DynamicResource B.Text3}" TextWrapping="Wrap" Margin="30,4,0,0">
                    <Run Text="{Binding UserDataText, Mode=OneWay}" />
                    <LineBreak />
                    <Run Text="{l:T 'İşaretlemezseniz yeniden kurduğunuzda kaldığınız yerden devam edersiniz.', 'If you leave this unchecked, you continue where you left off when you reinstall.'}" />
                </TextBlock>
            </StackPanel>

            <!-- Sağ: geri bildirim -->
            <Grid Grid.Column="2" VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border CornerRadius="18" Padding="26,22,26,20" BorderBrush="{DynamicResource B.InfoBoxBorder}" BorderThickness="1" Background="{DynamicResource B.CardBg}">
                    <StackPanel>
                        <TextBlock Text="{l:T 'Neden kaldırıyorsunuz?', 'Why are you uninstalling?'}" FontFamily="{StaticResource F.Display}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource B.Text}" />

                        <!-- Gönderim ayarlıysa: nedenler + mesaj -->
                        <StackPanel Visibility="{Binding FeedbackEnabled, Converter={StaticResource Visible}}">
                            <TextBlock Text="{l:T 'İsteğe bağlı · Uygulamayı geliştirmemize yardım eder.', 'Optional · Helps us improve the app.'}" FontSize="12" Foreground="{DynamicResource B.Text3}"
                                       Margin="0,4,0,16" />
                            <ItemsControl x:Name="ReasonList" ItemsSource="{Binding Reasons}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:FeedbackReasonViewModel}">
                                        <CheckBox Content="{Binding Text}" IsChecked="{Binding IsChecked}" Margin="0,0,0,12"
                                                  AutomationProperties.Name="{Binding Text}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid Margin="0,6,0,6">
                                <TextBlock Text="{l:T 'Mesajınız (isteğe bağlı)', 'Your message (optional)'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource B.Text2}" />
                                <TextBlock Text="{Binding MessageCounter}" FontSize="11" Foreground="{DynamicResource B.Text3}" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid>
                                <TextBox x:Name="FeedbackMessage" Style="{StaticResource Setup.Input}" Height="92" AcceptsReturn="True" TextWrapping="Wrap"
                                         MaxLength="{x:Static vm:UninstallViewModel.MaxMessageLength}" AutomationProperties.Name="{l:T 'Mesajınız', 'Your message'}"
                                         Text="{Binding Message, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="{l:T 'Neyi beğenmediniz, neyi düzeltelim?', 'What didn\'t you like, what should we fix?'}" FontSize="13" Foreground="{DynamicResource B.Text3}" Margin="13,9,0,0"
                                           IsHitTestVisible="False" Visibility="{Binding Message, Converter={StaticResource Hidden}}" />
                            </Grid>
                            <TextBlock FontSize="11" Foreground="{DynamicResource B.Text3}" TextWrapping="Wrap" Margin="0,10,0,0"
                                       Text="{l:T 'Gönderilenler: seçtikleriniz, mesajınız, uygulama ve Windows sürümü (Google Formlar). Ad, e-posta veya bilgisayar adı gönderilmez.', 'What is sent: your selections, your message, the app and Windows version (Google Forms). No name, e-mail or computer name is sent.'}" />
                        </StackPanel>

                        <!-- Gönderim ayarlı değilse: sahte "gönder" sunulmaz -->
                        <TextBlock Visibility="{Binding FeedbackEnabled, Converter={StaticResource Hidden}}" FontSize="12.5" Foreground="{DynamicResource B.Text2}"
                                   TextWrapping="Wrap" Margin="0,8,0,0"
                                   Text="{l:T 'Bu sürümde geri bildirim gönderimi ayarlanmadı; uygulama yalnızca kaldırılacak.', 'Feedback sending is not configured in this version; the app will only be uninstalled.'}" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                    <Button x:Name="CancelButton" Style="{StaticResource Btn.Secondary}" Content="{l:T 'İptal', 'Cancel'}" Width="130" Height="48"
                            Command="{Binding CloseCommand}" Margin="0,0,12,0" />
                    <Button x:Name="UninstallButton" Style="{StaticResource Btn.Primary}" Width="220" Height="48" Command="{Binding UninstallCommand}"
                            AutomationProperties.Name="{Binding PrimaryText}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" Style="{StaticResource T.Icon}" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding PrimaryText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ============ Kaldırılıyor ============ -->
        <ScrollViewer x:Name="WorkingPage" Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False"
                      Visibility="{Binding IsWorking, Converter={StaticResource Visible}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="560" Margin="0,8,0,24">
                <TextBlock Text="{Binding StatusText}" FontFamily="{StaticResource F.Display}" FontSize="23" Foreground="{DynamicResource B.Text}" Margin="0,0,0,22" />
                <ItemsControl ItemsSource="{Binding Steps}" ItemTemplate="{StaticResource SetupStepTemplate}" Focusable="False" />
            </StackPanel>
        </ScrollViewer>

        <!-- ============ Bitti (uzun notlar kayar, Kapat hep görünür) ============ -->
        <Grid x:Name="DonePage" Grid.Row="1" Margin="0,0,0,24" Visibility="{Binding IsDone, Converter={StaticResource Visible}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="620" Margin="0,8,0,8">
                    <ContentControl Template="{StaticResource LogoGlow}" Focusable="False" />
                    <TextBlock Text="{Binding ResultTitle}" FontFamily="{StaticResource F.Display}" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource B.Text}"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <TextBlock Text="{l:T 'Bir dahaki sefere görüşmek üzere!', 'See you next time!'}" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource B.NeonBright}"
                               HorizontalAlignment="Center" Margin="0,8,0,0" />
    
                    <!-- Geri bildirim sonucu (gerçek HTTP sonucu) -->
                    <Border Margin="0,20,0,0" Padding="14,10" CornerRadius="10" Background="{DynamicResource B.InfoBoxBg}" BorderBrush="{DynamicResource B.InfoBoxBorder}" BorderThickness="1"
                            HorizontalAlignment="Center" Visibility="{Binding FeedbackResult, Converter={StaticResource Visible}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="FeedbackIcon" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource T.Icon}">
                                        <Setter Property="Text" Value="&#xE73E;" />
                                        <Setter Property="Foreground" Value="{DynamicResource B.Green}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FeedbackFailed}" Value="True">
                                                <Setter Property="Text" Value="&#xE7BA;" />
                                                <Setter Property="Foreground" Value="{DynamicResource B.Orange}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding FeedbackResult}" FontSize="12.5" Foreground="{DynamicResource B.Text}" TextWrapping="Wrap" MaxWidth="440"
                                       VerticalAlignment="Center" />
                            <Button Style="{StaticResource Btn.Ghost}" Content="{l:T 'Tekrar gönder', 'Send again'}" Command="{Binding RetryFeedbackCommand}" Margin="12,0,0,0"
                                    Visibility="{Binding FeedbackFailed, Converter={StaticResource Visible}}" />
                        </StackPanel>
                    </Border>
    
                    <TextBlock Text="{Binding NotesText}" FontSize="12" LineHeight="18" Foreground="{DynamicResource B.Text2}" TextWrapping="Wrap"
                               TextAlignment="Center" Margin="0,16,0,0" Visibility="{Binding NotesText, Converter={StaticResource Visible}}" />
                </StackPanel>
            </ScrollViewer>
            <Button x:Name="CloseButton" Grid.Row="1" Style="{StaticResource Btn.Primary}" Content="{l:T 'Kapat', 'Close'}" Width="200" Height="48" Command="{Binding CloseCommand}"
                    HorizontalAlignment="Center" Margin="0,16,0,0" />
        </Grid>

        <!-- ============ Yüklü değil ============ -->
        <Grid x:Name="NotInstalledPage" Grid.Row="1" Visibility="{Binding IsNotInstalled, Converter={StaticResource Visible}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="560" Margin="0,0,0,24">
                <ContentControl Template="{StaticResource LogoGlow}" Focusable="False" />
                <TextBlock Text="{l:T 'E-mre Control Center bu bilgisayarda yüklü değil', 'E-mre Control Center is not installed on this computer'}" FontFamily="{StaticResource F.Display}" FontSize="22" Foreground="{DynamicResource B.Text}"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0" />
                <TextBlock FontSize="13" Foreground="{DynamicResource B.Text2}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0"
                           Text="{l:T 'Windows Uygulamalar kaydı ve program dosyası bulunamadı; kaldırılacak bir şey yok.', 'No Windows Apps entry and no program file was found; there is nothing to uninstall.'}" />
                <Button Style="{StaticResource Btn.Primary}" Content="{l:T 'Kapat', 'Close'}" Width="200" Height="48" Command="{Binding CloseCommand}"
                        HorizontalAlignment="Center" Margin="0,24,0,0" />
            </StackPanel>
        </Grid>

        <ContentControl Grid.RowSpan="2" Content="{Binding RunningPrompt}" ContentTemplate="{StaticResource RunningPromptTemplate}" Focusable="False"
                        Visibility="{Binding RunningPrompt.IsOpen, Converter={StaticResource Visible}}" />
    </Grid>
</Window>
