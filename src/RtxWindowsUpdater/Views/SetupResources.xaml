<!-- Kurulum ve kaldırma pencerelerinin ortak görünümü (ana tasarım dili: siyah / koyu lacivert / neon mavi; Themes/Theme.xaml) -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:RtxWindowsUpdater.Views"
                    xmlns:vm="clr-namespace:RtxWindowsUpdater.ViewModels">

    <ImageBrush x:Key="LogoBrush" ImageSource="pack://application:,,,/Assets/E-mreLogo.jpg" Stretch="UniformToFill" />

    <!-- Parlayan logo (ana sayfadaki gibi: radyal ışıma + neon çerçeve; sürekli animasyon yok) -->
    <ControlTemplate x:Key="LogoGlow" TargetType="ContentControl">
        <Grid Width="190" Height="124" HorizontalAlignment="Center">
            <Ellipse IsHitTestVisible="False">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#591FB6FF" Offset="0" />
                        <GradientStop Color="#1A1FB6FF" Offset="0.5" />
                        <GradientStop Color="#001FB6FF" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Border Width="84" Height="84" CornerRadius="22" BorderThickness="1.5" BorderBrush="{DynamicResource B.NeonBright}"
                    Effect="{DynamicResource Fx.IconGlow}">
                <Rectangle RadiusX="20" RadiusY="20" Fill="{StaticResource LogoBrush}" />
            </Border>
        </Grid>
    </ControlTemplate>

    <!-- Adım satırı: durum simgesi + başlık + gerçek ayrıntı -->
    <DataTemplate x:Key="SetupStepTemplate" DataType="{x:Type vm:SetupStepViewModel}">
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="30" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="icon" Text="{Binding Glyph}" Style="{StaticResource T.Icon}" FontSize="14" VerticalAlignment="Top"
                       HorizontalAlignment="Left" Margin="0,2,0,0" Foreground="{DynamicResource B.Text3}" />
            <StackPanel Grid.Column="1">
                <TextBlock x:Name="title" Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource B.Text3}" />
                <TextBlock Text="{Binding Detail}" FontSize="11.5" Foreground="{DynamicResource B.Text3}" TextWrapping="Wrap" Margin="0,2,0,0"
                           Visibility="{Binding Detail, Converter={StaticResource Visible}}" />
            </StackPanel>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding State}" Value="Running">
                <Setter TargetName="icon" Property="Foreground" Value="{DynamicResource B.NeonBright}" />
                <Setter TargetName="title" Property="Foreground" Value="{DynamicResource B.Text}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Done">
                <Setter TargetName="icon" Property="Foreground" Value="{DynamicResource B.Green}" />
                <Setter TargetName="title" Property="Foreground" Value="{DynamicResource B.Text}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Failed">
                <Setter TargetName="icon" Property="Foreground" Value="{DynamicResource B.Red}" />
                <Setter TargetName="title" Property="Foreground" Value="{DynamicResource B.Red}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Çok satırlı giriş kutusu (geri bildirim mesajı) -->
    <Style x:Key="Setup.Input" TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
        <Setter Property="CaretBrush" Value="{DynamicResource B.NeonBright}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource B.Neon}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="bg" CornerRadius="10" Background="{DynamicResource B.DeepBg}" BorderBrush="{DynamicResource B.BorderHi}" BorderThickness="1" Padding="10,8">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalScrollBarVisibility="Auto" Focusable="False" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource B.CardBorderHover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource B.NeonBright}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Pencere içi onay kutusu (açık uygulamanın kapatılması) -->
    <DataTemplate x:Key="RunningPromptTemplate" DataType="{x:Type vm:RunningAppPrompt}">
        <Grid Background="{DynamicResource B.OverlayStrong}">
            <Border Width="470" Padding="26,22" CornerRadius="16" Background="{DynamicResource B.CardBg}" BorderBrush="#66FFA63D" BorderThickness="1"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7BA;" Style="{StaticResource T.Icon}" FontSize="18" Foreground="{DynamicResource B.Orange}" Margin="0,0,12,0" />
                        <TextBlock Text="{l:T 'E-mre Control Center açık', 'E-mre Control Center is open'}" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource B.Text}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Text}" Style="{StaticResource T.Body}" Margin="0,12,0,0" />
                    <TextBlock Text="{l:T 'Uygulamaya normal kapanma isteği gönderilir; zorla sonlandırılmaz.', 'A normal close request is sent to the app; it is not forced to end.'}" FontSize="11.5"
                               Foreground="{DynamicResource B.Text3}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Style="{StaticResource Btn.Secondary}" Content="{l:T 'İptal', 'Cancel'}" Width="110" Command="{Binding CancelCommand}" Margin="0,0,10,0" />
                        <Button Style="{StaticResource Btn.Secondary}" Content="{l:T 'Kapat ve devam et', 'Close and continue'}" Command="{Binding ConfirmCommand}"
                                BorderBrush="{DynamicResource B.Neon}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
