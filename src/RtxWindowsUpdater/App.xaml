<Application x:Class="RtxWindowsUpdater.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:RtxWindowsUpdater.Views"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <views:StatusToBrushConverter x:Key="StatusBrush" />
            <views:StatusToSoftBrushConverter x:Key="StatusSoftBrush" />
            <views:StatusToGlyphConverter x:Key="StatusGlyph" />
            <views:StatusIsBusyConverter x:Key="StatusIsBusy" />
            <views:LogLevelToBrushConverter x:Key="LogBrush" />
            <views:BoolToVisibilityConverter x:Key="Visible" />
            <views:BoolToVisibilityConverter x:Key="Hidden" Invert="True" />
            <views:DialogKindToBrushConverter x:Key="DialogBrush" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
