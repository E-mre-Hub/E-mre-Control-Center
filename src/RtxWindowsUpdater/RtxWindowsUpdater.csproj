<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <RootNamespace>RtxWindowsUpdater</RootNamespace>
    <AssemblyName>E-mre Control Center</AssemblyName>
    <Product>E-mre Control Center</Product>
    <AssemblyTitle>E-mre Control Center</AssemblyTitle>
    <Company>E-mre Control Center</Company>
    <Copyright>© 2026 E-mre Control Center</Copyright>
    <Version>1.8.1</Version>
    <!-- Dosya özelliklerinde "Ürün sürümü" yalın görünsün (varsayılan: 1.4.0+<git commit kimliği>) -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

    <!-- EXE ikonu (Windows Explorer / görev çubuğu / kısayol) -->
    <ApplicationIcon>..\..\assets\E-mreLogo.ico</ApplicationIcon>
    <!-- UAC / DPI / desteklenen OS bildirimleri -->
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Tek EXE yayın ayarları (dotnet publish sırasında kullanılır) -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <PublishReadyToRun>false</PublishReadyToRun>
    <SatelliteResourceLanguages>tr;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\..\assets\E-mreLogo.ico" Link="Assets\E-mreLogo.ico" />
    <Resource Include="..\..\assets\E-mreLogo.jpg" Link="Assets\E-mreLogo.jpg" />
  </ItemGroup>

</Project>
